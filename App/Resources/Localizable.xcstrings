          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "סנכרון iCloud כבוי, כך שנעילה זו חלה רק על מכשיר זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iCloud सिंक बंद है, इसलिए यह लॉक केवल इस डिवाइस पर लागू होता है."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
