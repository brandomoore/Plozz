    "Disconnected from Plozz. WeTrakr could not revoke the session; remove Plozz from your connected apps on WeTrakr." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تم قطع الاتصال من Plozz. تعذّر على WeTrakr إبطال الجلسة؛ أزِل Plozz من التطبيقات المتصلة في WeTrakr."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Връзката с Plozz е прекъсната. WeTrakr не успя да анулира сесията; премахни Plozz от свързаните си приложения в WeTrakr."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "S'ha desconnectat de Plozz. WeTrakr no ha pogut revocar la sessió; elimina Plozz de les aplicacions connectades a WeTrakr."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
