          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bruker innstillingen for Rader på Hjem eller Anbefalt ut fra hvor raden vises."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
