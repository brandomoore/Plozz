          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Billeder fra biblioteket med tekstfri billeder i Se videre og varierede baggrunde i Detaljer, når de er tilgængelige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bilder aus der Medienbibliothek mit textfreien Bildern für „Weiterschauen“ und unterschiedlichen Hintergründen für „Details“, sofern verfügbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Εικόνες βιβλιοθήκης, με εικόνες χωρίς κείμενο στη «Συνέχεια παρακολούθησης» και ποικιλία φόντων στις «Λεπτομέρειες», όταν διατίθενται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Imágenes de la biblioteca multimedia, con imágenes sin texto en «Seguir viendo» y fondos variados en «Detalles» cuando estén disponibles."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تصاویر کتابخانه، با تصاویر بدون متن در «ادامهٔ تماشا» و پس‌زمینه‌های متنوع در «جزئیات»، در صورت وجود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kirjaston kuvitus sekä tekstittömät kuvat Jatka katsomista -osiossa ja vaihtelevat taustakuvat Tiedot-sivulla, kun niitä on saatavilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Illustrations de la bibliothèque, avec des images sans texte dans « Reprendre la lecture » et des arrière-plans variés dans « Détails », si disponibles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "תמונות מהספרייה, עם תמונות ללא טקסט ב״המשך צפייה״ ורקעים מגוונים ב״פרטים״, כשיש כאלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "लाइब्रेरी के चित्र; उपलब्ध होने पर “देखना जारी रखें” में बिना टेक्स्ट वाले चित्र और “विवरण” में अलग-अलग पृष्ठभूमियाँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Slike iz knjižnice, uz slike bez teksta u odjeljku Nastavi gledati i raznolike pozadine u odjeljku Pojedinosti kada su dostupne."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Könyvtári képek; ha elérhetők, szöveg nélküli képek a Megtekintés folytatása részben és változatos hátterek a Részletek oldalon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gambar pustaka, dengan gambar tanpa teks di Lanjutkan Menonton dan latar bervariasi di Detail jika tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Immagini della libreria, con immagini senza testo in «Continua a guardare» e sfondi diversi in «Dettagli», quando disponibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ライブラリのアートワークを使用。利用可能な場合は「続きを観る」に文字なしの画像、「詳細」には異なる背景を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "미디어 보관함의 아트워크를 사용하며, 가능한 경우 시청 중인 콘텐츠에는 글자 없는 이미지를, 상세 정보에는 다양한 배경을 표시합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Imej pustaka, dengan imej tanpa teks untuk Teruskan Menonton dan latar belakang yang pelbagai pada halaman Butiran apabila tersedia."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bibliotekbilder, med tekstfrie bilder i Se videre og varierte bakgrunner i Detaljer når de er tilgjengelige."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bibliotheekafbeeldingen, met tekstloze afbeeldingen voor Verder kijken en gevarieerde achtergronden op de pagina Details indien beschikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Grafika z biblioteki, z obrazami bez tekstu w sekcji Oglądaj dalej i zróżnicowanymi tłami na stronie Szczegóły, jeśli są dostępne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Imagens da biblioteca, com imagens sem texto em Continuar assistindo e planos de fundo variados em Detalhes, quando disponíveis."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Imagini din bibliotecă, cu imagini fără text la „Continuă vizionarea” și fundaluri variate la „Detalii”, când sunt disponibile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Изображения из медиатеки. При наличии — изображения без текста в разделе «Продолжить просмотр» и разные фоны на странице «Подробности»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Obrázky z knižnice s obrázkami bez textu v časti „Pokračovať v sledovaní“ a rôznymi pozadiami na stránke „Podrobnosti“, ak sú k dispozícii."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Slike iz knjižnice, s slikami brez besedila v razdelku »Nadaljuj z gledanjem« in raznolikimi ozadji na strani »Podrobnosti«, kadar so na voljo."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
