    "Only add addresses you trust for this server. Your sign-in will be used at each saved address. HTTP connections are not encrypted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أضف فقط العناوين التي تثق بها لهذا الخادم. ستُستخدم بيانات الدخول الخاصة بك في كل عنوان محفوظ. اتصالات HTTP غير مشفّرة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Добавяйте за този сървър само адреси, на които имате доверие. Данните ви за вход ще се използват на всеки запазен адрес. HTTP връзките не са шифровани."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Afegeix només adreces de confiança per a aquest servidor. Les teves credencials s’utilitzaran a cada adreça desada. Les connexions HTTP no estan xifrades."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Přidávejte pouze adresy tohoto serveru, kterým důvěřujete. Na každé uložené adrese se použijí vaše přihlašovací údaje. Připojení HTTP nejsou šifrovaná."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tilføj kun adresser, du har tillid til, til denne server. Dine loginoplysninger bruges på hver gemt adresse. HTTP-forbindelser er ikke krypterede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
