    "Subtitles can't be added to this playback session. Reopen the title and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يمكن إضافة ترجمات إلى جلسة التشغيل هذه. أعد فتح الفيلم أو المسلسل وحاول مجددًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Към тази сесия на възпроизвеждане не могат да се добавят субтитри. Отворете заглавието отново и опитайте пак."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No es poden afegir subtítols a aquesta sessió de reproducció. Torna a obrir el títol i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Do této relace přehrávání nelze přidat titulky. Znovu otevřete titul a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der kan ikke føjes undertekster til denne afspilningssession. Åbn titlen igen, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser Wiedergabesitzung können keine Untertitel hinzugefügt werden. Öffne den Titel erneut und versuche es noch einmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Δεν μπορούν να προστεθούν υπότιτλοι σε αυτή τη συνεδρία αναπαραγωγής. Ανοίξτε ξανά τον τίτλο και δοκιμάστε πάλι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pueden añadir subtítulos a esta sesión de reproducción. Vuelve a abrir el título e inténtalo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "افزودن زیرنویس به این نشست پخش ممکن نیست. فیلم یا سریال را دوباره باز کنید و دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tähän toistoistuntoon ei voi lisätä tekstityksiä. Avaa nimike uudelleen ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impossible d'ajouter des sous-titres à cette session de lecture. Rouvrez le titre et réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לא ניתן להוסיף כתוביות להפעלה הנוכחית. פתחו מחדש את הכותר ונסו שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इस प्लेबैक सत्र में सबटाइटल नहीं जोड़े जा सकते। फ़िल्म या सीरीज़ फिर खोलें और दोबारा कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podnaslovi se ne mogu dodati ovoj sesiji reprodukcije. Ponovno otvori naslov i pokušaj opet."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ehhez a lejátszási munkamenethez nem adható felirat. Nyisd meg újra a filmet vagy sorozatot, és próbáld újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Subtitel tidak dapat ditambahkan ke sesi pemutaran ini. Buka kembali film atau serial tersebut, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Non è possibile aggiungere sottotitoli a questa sessione di riproduzione. Riapri il titolo e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "この再生セッションには字幕を追加できません。作品を開き直して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 재생 세션에는 자막을 추가할 수 없습니다. 작품을 다시 열고 재시도하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sari kata tidak dapat ditambahkan pada sesi main balik ini. Buka semula filem atau siri tersebut dan cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Undertekster kan ikke legges til i denne avspillingsøkten. Åpne tittelen på nytt og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je kunt geen ondertitels toevoegen aan deze afspeelsessie. Open de titel opnieuw en probeer het nog eens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie można dodać napisów do tej sesji odtwarzania. Otwórz tytuł ponownie i spróbuj jeszcze raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Não é possível adicionar legendas a esta sessão de reprodução. Abra o título novamente e tente outra vez."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nu se pot adăuga subtitrări la această sesiune de redare. Redeschide filmul sau serialul și încearcă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не удаётся добавить субтитры в текущий сеанс воспроизведения. Заново откройте фильм или сериал и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Do tejto relácie prehrávania nemožno pridať titulky. Znova otvorte titul a skúste to opäť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podnapisov ni mogoče dodati tej seji predvajanja. Znova odprite film ali serijo in poskusite znova."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Titlovi ne mogu da se dodaju u ovu sesiju reprodukcije. Ponovo otvorite film ili seriju i pokušajte ponovo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Undertexter kan inte läggas till i den här uppspelningssessionen. Öppna titeln på nytt och försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เพิ่มคำบรรยายในเซสชันการเล่นนี้ไม่ได้ เปิดภาพยนตร์หรือซีรีส์อีกครั้งแล้วลองใหม่"
