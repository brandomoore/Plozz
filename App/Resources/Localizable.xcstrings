    "Home's rows below the hero, including Watchlist and Recently Added." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "صفوف المحتوى أسفل العرض الرئيسي في «الرئيسية»، بما فيها «قائمة المشاهدة» و«المضاف حديثًا»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Редовете в „Начало“ под водещия банер, включително „Списък за гледане“ и „Наскоро добавени“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Files d’Inici sota l’element destacat, incloses les files «Llista de seguiment» i «Afegits recentment»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Řádky na stránce Domů pod hlavním bannerem, včetně řádků „Watchlist“ a „Nedávno přidané“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rækkerne på Hjem under banneret, herunder Watchlist og Nyligt tilføjet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Reihen auf „Start“ unter der Titelbühne, einschließlich „Watchlist“ und „Neu hinzugefügt“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι σειρές περιεχομένου της Αρχικής κάτω από την κεντρική προβολή, όπως η «Λίστα παρακολούθησης» και οι «Πρόσφατες προσθήκες»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las filas de Inicio situadas debajo de la portada, incluidas Watchlist y Añadidos recientemente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ردیف‌های «خانه» زیر بنر اصلی، از جمله «فهرست تماشا» و «اخیراً اضافه شده»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koti-näkymän rivit noston alapuolella, mukaan lukien Watchlist ja Viimeksi lisätyt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les rangées de l’Accueil sous la bannière, dont Watchlist et Ajouts récents."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "השורות ב״בית״ שמתחת לבאנר הראשי, כולל ״רשימת צפייה״ ו״נוספו לאחרונה״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "होम पर मुख्य बैनर के नीचे की पंक्तियाँ, जिनमें “वॉचलिस्ट” और “हाल ही में जोड़े गए” शामिल हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Redci na Početnoj ispod istaknutog bannera, uključujući Popis za gledanje i Nedavno dodano."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Kezdőlap főképe alatti sorok, köztük a Figyelőlista és a Nemrég hozzáadott."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
