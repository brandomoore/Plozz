    "Remove it from all your devices, or just this %@?" : {
      "comment" : "Confirmation message when removing a server or sign-in that can also be removed everywhere through iCloud sync. %@ is the current device name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هل تود إزالتها من جميع أجهزتك، أم فقط من هذا %@؟"
          }
        },
        "bg" : {
          "stringUnit" : {
