    "Program search couldn't load. Your channel results are still available." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعذّر تحميل البحث عن البرامج. لا تزال نتائج القنوات متاحة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Търсенето на предавания не можа да се зареди. Резултатите за канали все още са налични."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No s'ha pogut carregar la cerca de programes. Els resultats de canals encara estan disponibles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vyhledávání pořadů se nepodařilo načíst. Výsledky kanálů jsou stále k dispozici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Programsøgningen kunne ikke indlæses. Dine kanalresultater er stadig tilgængelige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Sendungssuche konnte nicht geladen werden. Ihre Kanalergebnisse sind weiterhin verfügbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η αναζήτηση προγραμμάτων δεν μπόρεσε να φορτωθεί. Τα αποτελέσματα καναλιών παραμένουν διαθέσιμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudo cargar la búsqueda de programas. Los resultados de canales siguen disponibles."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "جست‌وجوی برنامه‌ها بارگیری نشد. نتایج کانال‌های شما همچنان در دسترس‌اند."
