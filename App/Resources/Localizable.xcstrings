    "Matching channels appear as each guide source loads. Clear filters to browse all channels now." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تظهر القنوات المطابقة عند تحميل كل مصدر دليل. امسح عوامل التصفية لتصفّح كل القنوات الآن."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Съвпадащите канали се показват при зареждането на всеки източник на програма. Изчистете филтрите, за да прегледате всички канали сега."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Els canals coincidents apareixen a mesura que es carrega cada font de guia. Esborra els filtres per explorar ara tots els canals."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odpovídající kanály se zobrazují při načítání jednotlivých zdrojů programu. Vymažte filtry a procházejte všechny kanály už teď."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Matchende kanaler vises, efterhånden som hver guidekilde indlæses. Ryd filtrene for at gennemse alle kanaler nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Passende Kanäle erscheinen, sobald die jeweilige Programmquelle geladen ist. Setze die Filter zurück, um jetzt alle Kanäle zu durchsuchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τα κανάλια που ταιριάζουν εμφανίζονται καθώς φορτώνεται κάθε πηγή οδηγού. Εκκαθαρίστε τα φίλτρα για περιήγηση σε όλα τα κανάλια τώρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los canales coincidentes aparecen a medida que se carga cada fuente de guía. Borra los filtros para explorar ahora todos los canales."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "با بارگیری هر منبع راهنما، کانال‌های مطابق نمایش داده می‌شوند. برای مرور همه کانال‌ها همین حالا فیلترها را پاک کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vastaavat kanavat tulevat näkyviin ohjelmaopaslähteiden latautuessa. Selaa kaikkia kanavia nyt tyhjentämällä suodattimet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les chaînes correspondantes apparaissent à mesure que chaque source de guide se charge. Effacez les filtres pour parcourir toutes les chaînes dès maintenant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ערוצים תואמים מופיעים עם טעינת כל מקור מדריך. נקה את המסננים כדי לעיין כעת בכל הערוצים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हर गाइड स्रोत के लोड होते ही मेल खाते चैनल दिखाई देते हैं। अभी सभी चैनल ब्राउज़ करने के लिए फ़िल्टर हटाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odgovarajući kanali pojavljuju se kako se učitava svaki izvor vodiča. Očistite filtre kako biste odmah pregledali sve kanale."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az egyező csatornák az egyes műsorújság-források betöltésekor jelennek meg. A szűrők törlésével már most böngészhetsz az összes csatorna között."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Saluran yang cocok muncul saat setiap sumber panduan dimuat. Hapus filter untuk menelusuri semua saluran sekarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
