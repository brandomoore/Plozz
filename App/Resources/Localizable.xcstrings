    "Choose at least one library. All libraries includes new libraries added to Home." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اختر مكتبة واحدة على الأقل. يشمل خيار «كل المكتبات» المكتبات الجديدة التي تُضاف إلى الرئيسية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Изберете поне една библиотека. „Всички библиотеки“ включва и новите библиотеки, добавени в „Начало“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tria almenys una biblioteca. L’opció «Totes les biblioteques» inclou les biblioteques noves que s’afegeixin a Inici."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vyberte alespoň jednu knihovnu. Volba „Všechny knihovny“ zahrnuje i nové knihovny přidané na stránku Domů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vælg mindst ét bibliotek. Alle biblioteker omfatter også nye biblioteker, der føjes til Hjem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wähle mindestens eine Bibliothek aus. „Alle Bibliotheken“ schließt auch neue Bibliotheken ein, die zu „Start“ hinzugefügt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Επιλέξτε τουλάχιστον μία βιβλιοθήκη. Η επιλογή «Όλες οι βιβλιοθήκες» περιλαμβάνει και νέες βιβλιοθήκες που προστίθενται στην Αρχική."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige al menos una biblioteca. La opción «Todas las bibliotecas» incluye las nuevas bibliotecas que se añadan a Inicio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "دست‌کم یک کتابخانه انتخاب کنید. گزینهٔ «همهٔ کتابخانه‌ها» شامل کتابخانه‌های جدیدی هم می‌شود که به خانه اضافه می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valitse vähintään yksi kirjasto. Kaikki kirjastot -valintaan sisältyvät myös Koti-näkymään lisättävät uudet kirjastot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choisissez au moins une bibliothèque. L’option « Toutes les bibliothèques » inclut les nouvelles bibliothèques ajoutées à l’Accueil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "יש לבחור לפחות ספרייה אחת. האפשרות ״כל הספריות״ כוללת גם ספריות חדשות שנוספות למסך הבית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कम से कम एक लाइब्रेरी चुनें। “सभी लाइब्रेरी” में होम में जोड़ी जाने वाली नई लाइब्रेरी भी शामिल हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odaberi barem jednu knjižnicu. Opcija „Sve knjižnice” uključuje i nove knjižnice dodane na Početnu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Válassz ki legalább egy könyvtárat. Az „Összes könyvtár” a Kezdőlaphoz később hozzáadott könyvtárakat is tartalmazza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pilih setidaknya satu pustaka. Opsi Semua pustaka mencakup pustaka baru yang ditambahkan ke Beranda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scegli almeno una libreria. L'opzione Tutte le librerie include le nuove librerie aggiunte alla Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
