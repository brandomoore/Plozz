    "Enter more than 128 Kbps to leave room for video after the audio budget." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أدخل قيمة أكبر من 128 Kbps لترك حيز للفيديو بعد الحصة المخصصة للصوت."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Въведете повече от 128 Kbps, за да остане място за видео след заделеното за аудио."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Introdueix més de 128 Kbps per deixar espai per al vídeo després de la part reservada a l'àudio."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zadejte více než 128 Kbps, aby po vyhrazení datového toku pro zvuk zbyl prostor pro video."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Indtast mere end 128 Kbps, så der er plads til video, når lyden har fået sin andel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gib mehr als 128 Kbps ein, damit nach dem Audioanteil noch Spielraum für Video bleibt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Εισαγάγετε τιμή μεγαλύτερη από 128 Kbps, ώστε να απομένει ρυθμός bit για το βίντεο μετά τη δέσμευση για τον ήχο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Introduce más de 128 Kbps para dejar margen para el vídeo tras reservar la parte del audio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مقداری بیشتر از 128 Kbps وارد کنید تا پس از اختصاص سهم صدا، بخشی برای ویدیو باقی بماند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anna yli 128 Kbps, jotta äänen osuuden jälkeen jää tilaa myös videolle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Saisissez une valeur supérieure à 128 Kbps afin de laisser de la place à la vidéo après la part réservée à l’audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "יש להזין יותר מ־128 Kbps כדי להשאיר מקום לווידאו לאחר הקצאת החלק המיועד לשמע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "128 Kbps से अधिक दर्ज करें, ताकि ऑडियो के लिए निर्धारित हिस्से के बाद वीडियो के लिए भी बिटरेट उपलब्ध रहे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Unesite više od 128 Kbps kako bi nakon izdvajanja za audio preostalo dovoljno za video."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adjon meg 128 Kbps feletti értéket, hogy a hangra szánt keret levonása után a videóra is maradjon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Masukkan nilai lebih dari 128 Kbps agar masih ada alokasi bitrate untuk video setelah alokasi audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inserisci un valore superiore a 128 Kbps per lasciare spazio al video dopo la quota riservata all’audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "音声用の割り当てを差し引いた後に映像用の余裕を残すため、128 Kbpsを超える値を入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "오디오에 할당할 비트레이트를 제외하고도 비디오에 사용할 여유가 있도록 128 Kbps보다 큰 값을 입력하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Masukkan nilai melebihi 128 Kbps supaya ada baki untuk video selepas peruntukan audio."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Angi mer enn 128 Kbps, slik at det er plass til video etter at lydens andel er satt av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voer meer dan 128 Kbps in, zodat er na het audiobudget ruimte overblijft voor video."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wpisz wartość większą niż 128 Kbps, aby po odliczeniu przydziału na dźwięk pozostało miejsce na wideo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Insira um valor maior que 128 Kbps para deixar espaço para o vídeo após a parcela reservada ao áudio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Introdu mai mult de 128 Kbps pentru a lăsa loc pentru video după alocarea pentru audio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Введите значение больше 128 Kbps, чтобы после выделения битрейта для аудио осталось место для видео."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zadajte viac než 128 Kbps, aby po vyhradení dátového toku pre zvuk zostal priestor aj pre video."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vnesite več kot 128 Kbps, da po dodelitvi bitne hitrosti za zvok ostane prostor tudi za video."
          }
        },
