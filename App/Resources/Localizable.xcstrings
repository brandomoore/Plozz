    "Continue Watching on Home and in libraries; metadata providers favor images without text." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«متابعة المشاهدة» في «الرئيسية» وفي المكتبات؛ يفضّل موفرو البيانات الوصفية الصور الخالية من النص."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Продължете да гледате“ в „Начало“ и в библиотеките; доставчиците на метаданни предпочитат изображения без текст."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«Continua mirant» a Inici i a les biblioteques; els proveïdors de metadades prioritzen les imatges sense text."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pokračovat ve sledování na stránce Domů a v knihovnách; poskytovatelé metadat upřednostňují obrázky bez textu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se videre på Hjem og i biblioteker; metadataudbydere prioriterer billeder uden tekst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Weiterschauen“ auf „Start“ und in Mediatheken; Metadatenanbieter bevorzugen Bilder ohne Text."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η «Συνέχεια παρακολούθησης» στην Αρχική και στις βιβλιοθήκες· οι πάροχοι μεταδεδομένων προτιμούν εικόνες χωρίς κείμενο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seguir viendo en Inicio y en las bibliotecas multimedia; los proveedores de metadatos dan prioridad a las imágenes sin texto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«ادامهٔ تماشا» در «خانه» و کتابخانه‌ها؛ ارائه‌دهندگان فراداده تصاویر بدون متن را ترجیح می‌دهند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jatka katsomista Koti-näkymässä ja kirjastoissa; metatietolähteet suosivat kuvia, joissa ei ole tekstiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reprendre la lecture sur la page Accueil et dans les bibliothèques ; les fournisseurs de métadonnées privilégient les images sans texte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "״המשך צפייה״ ב״בית״ ובספריות; ספקי מטא-נתונים נותנים עדיפות לתמונות ללא טקסט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "होम और लाइब्रेरी में “देखना जारी रखें”; मेटाडेटा प्रोवाइडर बिना टेक्स्ट वाली तस्वीरों को प्राथमिकता देते हैं।"
