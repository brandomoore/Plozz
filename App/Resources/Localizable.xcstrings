    "Choose the catalogs used for Featured. Titles may not be in your libraries. Seerr is only needed to request titles." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اختر الكتالوجات المستخدمة في «المميّز». قد لا تتوفر العناوين في مكتباتك. لا تحتاج إلى Seerr إلا لطلب العناوين."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Изберете каталозите за „Избрано“. Заглавията може да не са във вашите медиатеки. Seerr е нужен само за заявяване на заглавия."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tria els catàlegs que s'utilitzen a «Destacat». Pot ser que els títols no siguin a les teves biblioteques. Només cal Seerr per sol·licitar títols."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vyberte katalogy pro sekci Doporučené. Tituly nemusí být ve vašich knihovnách. Seerr je potřeba pouze pro vyžádání titulů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vælg kataloger til »I fokus«. Titlerne er muligvis ikke i dine biblioteker. Seerr er kun nødvendigt for at anmode om titler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wähle die Kataloge für „Im Fokus“. Titel sind möglicherweise nicht in deinen Medienbibliotheken verfügbar. Seerr wird nur zum Anfragen von Titeln benötigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Επιλέξτε τους καταλόγους για τα Προτεινόμενα. Οι τίτλοι ενδέχεται να μην υπάρχουν στις βιβλιοθήκες σας. Το Seerr χρειάζεται μόνο για αιτήματα τίτλων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige los catálogos que se usan en Destacados. Los títulos pueden no estar en tus bibliotecas multimedia. Seerr solo es necesario para solicitar títulos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "کاتالوگ‌های مورد استفاده در بخش پیشنهادی را انتخاب کنید. ممکن است عنوان‌ها در کتابخانه‌های شما موجود نباشند. Seerr فقط برای درخواست عنوان‌ها لازم است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valitse Esittelyssä-osion käyttämät luettelot. Nimikkeet eivät välttämättä kuulu kirjastoihisi. Seerr-palvelua tarvitaan vain nimikkeiden pyytämiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choisissez les catalogues utilisés pour la section À la une. Certains titres peuvent être absents de vos bibliothèques multimédias. Seerr n’est nécessaire que pour demander des titres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
