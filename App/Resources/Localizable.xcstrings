            "value" : "Notifikasi batch merangkum satu musim atau acara, bukan memberi tahu untuk setiap episode."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le notifiche raggruppate riepilogano una stagione o una serie invece di inviare una notifica per ogni episodio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一括通知では、エピソードごとではなくシーズンや番組単位でまとめて通知します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "일괄 알림은 에피소드마다 알리는 대신 시즌이나 프로그램 단위로 요약합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pemberitahuan kelompok meringkaskan musim atau rancangan dan bukannya memberitahu untuk setiap episod."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Batchvarsler oppsummerer en sesong eller serie i stedet for å varsle for hver episode."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Batchmeldingen vatten een seizoen of serie samen in plaats van voor elke aflevering een melding te geven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Powiadomienia zbiorcze podsumowują sezon lub serial zamiast powiadamiać o każdym odcinku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As notificações em lote resumem uma temporada ou série em vez de notificar sobre cada episódio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Notificările în lot rezumă un sezon sau un serial în loc să trimită o notificare pentru fiecare episod."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Пакетные уведомления содержат сводку по сезону или сериалу вместо уведомления о каждом эпизоде."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hromadné oznámenia zhrnú sezónu alebo seriál namiesto oznámenia o každej epizóde."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Paketna obvestila povzamejo sezono ali serijo, namesto da bi vas obvestila o vsaki epizodi."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Grupna obaveštenja sažimaju sezonu ili seriju umesto obaveštenja za svaku epizodu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Batchnotiser sammanfattar en säsong eller serie i stället för att meddela om varje avsnitt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "การแจ้งเตือนแบบชุดจะสรุปเป็นซีซันหรือรายการ แทนการแจ้งเตือนทุกตอน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toplu bildirimler, her bölüm için bildirim göndermek yerine sezonu veya diziyi özetler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Пакетні сповіщення містять підсумок сезону або серіалу замість сповіщення про кожен епізод."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Thông báo hàng loạt tóm tắt theo mùa hoặc chương trình thay vì thông báo từng tập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "批量通知会按季或剧集汇总，而不是每集都通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "批次通知會依季或節目摘要，而不是每集都通知。"
          }
        }
      }
