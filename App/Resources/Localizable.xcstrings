    "Place Plozz in the top row of your Apple TV Home Screen to see Continue Watching and Recently Added titles above the app icons." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ضع Plozz في الصف العلوي من شاشة Apple TV الرئيسية لرؤية محتوى «متابعة المشاهدة» و«المضاف حديثًا» فوق أيقونات التطبيقات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Поставете Plozz в най-горния ред на началния екран на Apple TV, за да виждате заглавията от „Продължете да гледате“ и „Наскоро добавени“ над иконите на приложенията."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Posa Plozz a la fila superior de la pantalla d’inici de l’Apple TV per veure els títols de «Continua mirant» i «Afegits recentment» a sobre de les icones de les aplicacions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Umístěte Plozz do horní řady na ploše Apple TV, aby se nad ikonami aplikací zobrazily tituly z oddílů „Pokračovat ve sledování“ a „Nedávno přidané“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Placer Plozz i den øverste række på hjemmeskærmen på Apple TV for at se titler fra »Se videre« og »Nyligt tilføjet« over appsymbolerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Platziere Plozz in der obersten Reihe des Home-Bildschirms deines Apple TV, um Titel aus „Weiterschauen“ und „Neu hinzugefügt“ oberhalb der App-Symbole zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τοποθετήστε το Plozz στην επάνω σειρά της οθόνης Αφετηρίας του Apple TV για να βλέπετε τίτλους από τις ενότητες «Συνέχεια παρακολούθησης» και «Πρόσφατες προσθήκες» πάνω από τα εικονίδια των εφαρμογών."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coloca Plozz en la fila superior de la pantalla de inicio del Apple TV para ver los títulos de «Seguir viendo» y «Añadidos recientemente» encima de los iconos de las apps."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برای دیدن عنوان‌های بخش‌های «ادامهٔ تماشا» و «اخیراً اضافه شده» در بالای نمادهای برنامه‌ها، Plozz را در ردیف بالای صفحهٔ اصلی Apple TV قرار دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Siirrä Plozz Apple TV:n Koti-valikon ylimmälle riville, niin näet osioiden ”Jatka katsomista” ja ”Viimeksi lisätyt” nimikkeet sovelluskuvakkeiden yläpuolella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Placez Plozz sur la rangée supérieure de l’écran d’accueil de votre Apple TV pour voir les titres des sections « Reprendre la lecture » et « Ajouts récents » au-dessus des icônes des apps."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "העבירו את Plozz לשורה העליונה במסך הבית של Apple TV כדי לראות כותרים מהקטגוריות ״המשך צפייה״ ו״נוספו לאחרונה״ מעל סמלי האפליקציות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ऐप आइकॉन के ऊपर “देखना जारी रखें” और “हाल ही में जोड़े गए” सेक्शन में मौजूद कॉन्टेंट देखने के लिए Plozz को अपने Apple TV की होम स्क्रीन की सबसे ऊपर वाली पंक्ति में रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Postavite Plozz u gornji red početnog zaslona uređaja Apple TV kako bi se iznad ikona aplikacija prikazivali naslovi iz odjeljaka „Nastavi gledati” i „Nedavno dodano”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Helyezze a Plozz alkalmazást az Apple TV főképernyőjének legfelső sorába, hogy az alkalmazások ikonjai felett megjelenjenek a „Megtekintés folytatása” és a „Nemrég hozzáadott” szakaszok tartalmai."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tempatkan Plozz di baris teratas Layar Utama Apple TV untuk melihat tayangan dari “Lanjutkan Menonton” dan “Baru Ditambahkan” di atas ikon aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Posiziona Plozz nella prima riga della schermata Home di Apple TV per vedere i titoli di «Continua a guardare» e «Aggiunti di recente» sopra le icone delle app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「続きを観る」と「最近追加」の作品をアプリのアイコンの上に表示するには、PlozzをApple TVのホーム画面の最上段に配置してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apple TV 홈 화면의 맨 위 줄에 Plozz를 배치하면 앱 아이콘 위에 ‘시청 중인 콘텐츠’와 ‘최근 추가’ 항목이 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Letakkan Plozz pada baris paling atas Skrin Utama Apple TV anda untuk melihat tajuk dalam “Teruskan Menonton” dan “Ditambah Baru-baru Ini” di atas ikon aplikasi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plasser Plozz i øverste rad på Hjem-skjermen på Apple TV for å se titler fra «Se videre» og «Nylig lagt til» over appikonene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plaats Plozz in de bovenste rij van het beginscherm van je Apple TV om titels uit ‘Verder kijken’ en ‘Onlangs toegevoegd’ boven de appsymbolen te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Umieść Plozz w górnym rzędzie na ekranie początkowym Apple TV, aby nad ikonami aplikacji wyświetlały się tytuły z sekcji „Oglądaj dalej” i „Ostatnio dodane”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coloque o Plozz na primeira fileira da Tela de Início da Apple TV para ver os títulos de “Continuar assistindo” e “Adicionados recentemente” acima dos ícones dos apps."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plasează Plozz în rândul de sus al ecranului principal de pe Apple TV pentru a vedea titlurile din „Continuă vizionarea” și „Adăugate recent” deasupra pictogramelor aplicațiilor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Поместите Plozz в верхний ряд на экране «Домой» Apple TV, чтобы над значками приложений отображались материалы из разделов «Продолжить просмотр» и «Недавно добавленные»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Presuňte Plozz do horného radu na ploche Apple TV, aby sa nad ikonami aplikácií zobrazovali tituly zo sekcií „Pokračovať v sledovaní“ a „Nedávno pridané“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Premakni Plozz v zgornjo vrstico začetnega zaslona Apple TV, da se nad ikonami aplikacij prikažejo naslovi iz razdelkov »Nadaljuj z gledanjem« in »Nedavno dodano«."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Premesti Plozz u gornji red na početnom ekranu Apple TV uređaja da bi se iznad ikona aplikacija prikazivali naslovi iz odeljaka „Nastavi gledanje“ i „Nedavno dodato“."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Placera Plozz på den översta raden på hemskärmen på Apple TV för att se titlar från ”Fortsätt titta” och ”Nyligen tillagda” ovanför appsymbolerna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "วาง Plozz ไว้ในแถวบนสุดของหน้าจอโฮมของ Apple TV เพื่อดูรายการใน “ดูต่อ” และ “เพิ่มล่าสุด” เหนือไอคอนแอป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uygulama simgelerinin üzerinde “İzlemeye devam et” ve “Son eklenenler” bölümlerindeki içerikleri görmek için Plozz’u Apple TV ana ekranının en üst sırasına yerleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Розмістіть Plozz у верхньому ряду головного екрана Apple TV, щоб бачити вміст розділів «Продовжити перегляд» і «Нещодавно додані» над значками програм."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Đặt Plozz ở hàng trên cùng của Màn hình chính Apple TV để xem các nội dung trong mục “Xem tiếp” và “Mới thêm” phía trên các biểu tượng ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "将 Plozz 放在 Apple TV 主屏幕的最上方一行，即可在 App 图标上方看到“继续观看”和“最近添加”中的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "將 Plozz 放在 Apple TV 主畫面的最上方一列，即可在 App 圖像上方看到「繼續觀看」和「最近新增」中的內容。"
          }
        }
      }
    },
