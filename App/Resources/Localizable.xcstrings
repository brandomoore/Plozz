            "value" : "Nadaljuje na trenutnem mestu. Različne montažne različice se lahko časovno razlikujejo."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nastavlja na trenutnoj poziciji. Različite montažne verzije mogu imati različit vremenski raspored scena."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Återupptar uppspelningen vid den aktuella positionen. Olika klippversioner kan ha olika tidsförlopp."
          }
