    "settings.parentalPIN.protectionExplanation" : {
      "comment" : "Explains the settings and profile-switching protection provided by the household Parental PIN.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يحمي رمز PIN واحد الإعدادات المشتركة وعملية الخروج من ملفات تعريف الأطفال. وبدونه، تظل هذه الإجراءات متاحة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
