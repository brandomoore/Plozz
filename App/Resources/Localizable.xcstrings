    "Connect Seerr to request missing seasons, or add episodes to your library." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اربط Seerr لطلب المواسم المفقودة، أو أضف حلقات إلى مكتبتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Свържете Seerr, за да заявявате липсващи сезони, или добавете епизоди към медиатеката си."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Connecta Seerr per sol·licitar les temporades que falten o afegeix episodis a la teva biblioteca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Připojte Seerr, abyste mohli požádat o chybějící sezóny, nebo přidejte díly do knihovny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Forbind Seerr for at anmode om manglende sæsoner, eller føj episoder til dit bibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verbinde Seerr, um fehlende Staffeln anzufragen, oder füge Folgen zu deiner Medienbibliothek hinzu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Συνδέστε το Seerr για να ζητάτε σεζόν που λείπουν ή προσθέστε επεισόδια στη βιβλιοθήκη σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conecta Seerr para solicitar las temporadas que faltan o añade episodios a tu biblioteca multimedia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برای درخواست فصل‌های ناموجود، Seerr را متصل کنید، یا قسمت‌ها را به کتابخانه‌تان بیفزایید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yhdistä Seerr, jotta voit pyytää puuttuvia kausia, tai lisää jaksoja kirjastoosi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Connectez Seerr pour demander les saisons manquantes ou ajoutez des épisodes à votre bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "חבר את Seerr כדי לבקש עונות חסרות, או הוסף פרקים לספרייה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "गायब सीज़न का अनुरोध करने के लिए Seerr कनेक्ट करें, या अपनी लाइब्रेरी में एपिसोड जोड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Povežite Seerr kako biste zatražili sezone koje nedostaju ili sami dodajte epizode u knjižnicu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Csatlakozzon a Seerrhez a hiányzó évadok igényléséhez, vagy adjon epizódokat a könyvtárához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hubungkan Seerr untuk meminta musim yang belum ada, atau tambahkan episode ke pustaka Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Connetti Seerr per richiedere le stagioni mancanti o aggiungi episodi alla tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seerrに接続して、不足しているシーズンをリクエストするか、エピソードをライブラリに追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seerr에 연결하여 없는 시즌을 요청하거나 에피소드를 미디어 보관함에 추가하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sambungkan Seerr untuk meminta musim yang tiada, atau tambahkan episod pada pustaka anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koble til Seerr for å be om manglende sesonger, eller legg til episoder i biblioteket ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verbind Seerr om ontbrekende seizoenen aan te vragen, of voeg afleveringen aan je bibliotheek toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Połącz Seerr, aby poprosić o brakujące sezony, lub dodaj odcinki do biblioteki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conecte o Seerr para solicitar as temporadas ausentes ou adicione episódios à sua biblioteca."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conectează Seerr pentru a solicita sezoanele lipsă sau adaugă episoade în biblioteca ta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Подключите Seerr, чтобы запрашивать отсутствующие сезоны, или добавьте эпизоды в свою медиатеку."
          }
        },
