    "Its channels leave the guide. Channel preferences are kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ستُزال قنواته من الدليل. وسيتم الاحتفاظ بتفضيلات القنوات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Каналите му се премахват от програмата. Предпочитанията за каналите се запазват."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Els seus canals desapareixen de la guia. Les preferències dels canals es conserven."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
