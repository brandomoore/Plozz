    "Check your connection or open Sources to review what needs attention." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تحقق من اتصالك أو افتح «المصادر» لمراجعة ما يحتاج إلى انتباه."
