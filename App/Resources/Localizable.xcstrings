      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعذّر تحميل اختصارات مكتبتك. لم يتغير ترتيبها المحفوظ."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Преките пътища към медиатеките ви не можаха да се заредят. Запазената им подредба не е променена."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No s’han pogut carregar les dreceres de les teves biblioteques. La disposició desada no ha canviat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zástupce vašich knihoven se nepodařilo načíst. Jejich uložené uspořádání zůstalo beze změny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dine biblioteksgenveje kunne ikke indlæses. Deres gemte opsætning er uændret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Verknüpfungen zu deinen Medienbibliotheken konnten nicht geladen werden. Ihre gespeicherte Anordnung bleibt unverändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Δεν ήταν δυνατή η φόρτωση των συντομεύσεων βιβλιοθήκης. Η αποθηκευμένη διάταξή τους δεν άλλαξε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't load your library shortcuts. Their saved arrangement is unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudieron cargar los accesos directos a tus bibliotecas. Su disposición guardada no ha cambiado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "میان‌برهای کتابخانه شما بارگیری نشدند. ترتیب ذخیره‌شده آن‌ها تغییری نکرده است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kirjastopikakuvakkeita ei voitu ladata. Niiden tallennettu järjestys ei muuttunut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impossible de charger les raccourcis de vos bibliothèques. Leur organisation enregistrée reste inchangée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לא ניתן היה לטעון את קיצורי הדרך לספריות שלך. הסידור השמור שלהם לא השתנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपके लाइब्रेरी शॉर्टकट लोड नहीं किए जा सके। उनकी सहेजी गई व्यवस्था अपरिवर्तित है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prečaci vaših knjižnica nisu se mogli učitati. Njihov spremljeni raspored nije promijenjen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A médiatári parancsikonokat nem sikerült betölteni. A mentett elrendezésük nem változott."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
