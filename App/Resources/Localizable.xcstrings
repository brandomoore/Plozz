        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не вдається додати субтитри до цього сеансу відтворення. Знову відкрийте фільм або серіал і спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Không thể thêm phụ đề vào phiên phát này. Hãy mở lại phim hoặc phim bộ rồi thử lại."
          }
        },
        "zh-Hans" : {
