        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "선택한 버전 유형을 이후 에피소드에서도 사용합니다. 자동 선택 시 해당 유형이 없으면 사용 가능한 최상의 버전을 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gunakan semula jenis versi yang anda pilih untuk episod seterusnya. Semasa memilih secara automatik, gunakan versi terbaik yang tersedia jika jenis itu tiada."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bruk den valgte versjonstypen også for senere episoder. Ved automatisk valg brukes den beste tilgjengelige versjonen hvis denne typen mangler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gebruik het gekozen versietype opnieuw voor latere afleveringen. Gebruik bij automatisch kiezen de beste beschikbare versie als dat type ontbreekt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Używaj wybranego typu wersji także w kolejnych odcinkach. Przy automatycznym wyborze użyj najlepszej dostępnej wersji, jeśli brakuje tego typu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reutilizar o tipo de versão escolhido nos próximos episódios. Ao escolher automaticamente, usar a melhor versão disponível se esse tipo não estiver disponível."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reutilizează tipul de versiune ales pentru episoadele următoare. La alegerea automată, folosește cea mai bună versiune disponibilă dacă acel tip lipsește."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Использовать выбранный тип версии для следующих эпизодов. Если этот тип отсутствует, при автоматическом выборе использовать лучшую доступную версию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Použiť vybraný typ verzie aj pre ďalšie diely. Pri automatickom výbere použiť najlepšiu dostupnú verziu, ak tento typ chýba."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Izbrano vrsto različice uporabi tudi za naslednje epizode. Pri samodejni izbiri uporabi najboljšo razpoložljivo različico, če ta vrsta manjka."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
