        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dajte prednost naslovima koji se u posljednje vrijeme nisu prikazivali u istaknutom banneru. Isključite ovu opciju da biste zadržali redoslijed na popisu za gledanje."
