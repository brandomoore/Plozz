    "Open Jellyfin on another device, choose **Quick Connect**, and enter this code." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "افتح Jellyfin على جهاز آخر، واختر **الاتصال السريع**، وأدخل هذا الرمز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Отворете Jellyfin на друго устройство, изберете **Quick Connect** и въведете този код."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Obre Jellyfin en un altre dispositiu, tria **Quick Connect** i introdueix aquest codi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na jiném zařízení otevřete Jellyfin, zvolte **Quick Connect** a zadejte tento kód."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Åbn Jellyfin på en anden enhed, vælg **Quick Connect**, og indtast denne kode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Öffne Jellyfin auf einem anderen Gerät, wähle **Quick Connect** und gib diesen Code ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ανοίξτε το Jellyfin σε άλλη συσκευή, επιλέξτε **Quick Connect** και εισαγάγετε αυτόν τον κωδικό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abre Jellyfin en otro dispositivo, elige **Conexión rápida** e introduce este código."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jellyfin را روی دستگاه دیگری باز کنید، گزینه **اتصال سریع** را انتخاب کنید و این کد را وارد کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avaa Jellyfin toisella laitteella, valitse **Quick Connect** ja syötä tämä koodi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ouvrez Jellyfin sur un autre appareil, choisissez **Quick Connect** et saisissez ce code."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "פתח את Jellyfin במכשיר אחר, בחר **Quick Connect**, והזן את הקוד הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "किसी दूसरे डिवाइस पर Jellyfin खोलें, **क्विक कनेक्ट** चुनें और यह कोड दर्ज करें."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Otvorite Jellyfin na drugom uređaju, odaberite **Quick Connect** i unesite ovaj kod."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nyissa meg a Jellyfin alkalmazást egy másik eszközön, válassza a **Quick Connect** lehetőséget, majd adja meg ezt a kódot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Buka Jellyfin di perangkat lain, pilih **Quick Connect**, lalu masukkan kode ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apri Jellyfin su un altro dispositivo, scegli **Quick Connect** e inserisci questo codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "別のデバイスでJellyfinを開き、**クイック接続**を選択し、このコードを入力してください。"
          }
        },
        "ko" : {
