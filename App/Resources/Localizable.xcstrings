        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "W pustych polach używane są metadane źródłowe. Zmiany dotyczą własnych etykiet, a nie informacji o programie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os campos em branco usam os metadados da fonte. Essas alterações são rótulos pessoais, não informações do programa."
