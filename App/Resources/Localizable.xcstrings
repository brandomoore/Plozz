    "Preview after watching keeps the channel playing behind the guide when you leave full screen. Recently watched shows the channels you watched last at the top of the guide." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُبقي خيار «المعاينة بعد المشاهدة» القناة قيد التشغيل خلف دليل البرامج عند مغادرة وضع ملء الشاشة. ويعرض خيار «شوهدت مؤخرًا» آخر القنوات التي شاهدتها في أعلى دليل البرامج."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Преглед след гледане“ оставя канала да се възпроизвежда зад ТВ програмата след излизане от цял екран. „Наскоро гледани“ показва последно гледаните канали най-отгоре в ТВ програмата."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«Previsualització després de mirar» manté el canal en reproducció darrere de la programació quan surts de pantalla completa. «Vistos recentment» mostra els últims canals que has mirat a la part superior de la programació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volba „Náhled po sledování“ ponechá kanál po opuštění celé obrazovky přehrávat na pozadí TV programu. Volba „Nedávno sledované“ zobrazí naposledy sledované kanály v horní části TV programu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Forhåndsvisning efter visning holder kanalen kørende bag programoversigten, når du forlader fuld skærm. Senest sete viser de kanaler, du sidst har set, øverst i programoversigten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Vorschau nach dem Ansehen“ lässt den Kanal beim Verlassen des Vollbilds hinter der Programmübersicht weiterlaufen. „Zuletzt angesehen“ zeigt die zuletzt angesehenen Kanäle oben in der Programmübersicht an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η «Προεπισκόπηση μετά την παρακολούθηση» διατηρεί την αναπαραγωγή του καναλιού πίσω από τον οδηγό προγράμματος όταν εξέρχεστε από την πλήρη οθόνη. Τα «Πρόσφατα προβληθέντα» εμφανίζουν τα κανάλια που παρακολουθήσατε τελευταία στην κορυφή του οδηγού."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«Vista previa tras ver el canal» mantiene el canal en reproducción detrás de la guía al salir de pantalla completa. «Vistos recientemente» muestra los últimos canales que has visto en la parte superior de la guía."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«پیش‌نمایش پس از تماشا» پس از خروج از حالت تمام‌صفحه، پخش کانال را در پس‌زمینهٔ راهنمای برنامه‌ها ادامه می‌دهد. «اخیراً تماشاشده» آخرین کانال‌هایی را که تماشا کرده‌اید، در بالای راهنما نشان می‌دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esikatselu katselun jälkeen jatkaa kanavan toistoa ohjelmaoppaan taustalla, kun poistut koko näytön tilasta. Viimeksi katsotut -asetus näyttää viimeksi katsomasi kanavat ohjelmaoppaan yläreunassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "« Aperçu après visionnage » laisse la chaîne en lecture derrière le programme TV en quittant le plein écran. « Vues récemment » affiche les dernières chaînes regardées en haut du programme TV."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "האפשרות ״תצוגה מקדימה לאחר הצפייה״ משאירה את הערוץ פועל מאחורי לוח השידורים בעת יציאה ממסך מלא. האפשרות ״נצפו לאחרונה״ מציגה את הערוצים האחרונים שבהם צפית בראש לוח השידורים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“देखने के बाद प्रीव्यू” फ़ुल स्क्रीन से बाहर आने पर कार्यक्रम गाइड के पीछे चैनल चलने देता है। “हाल ही में देखे गए” आपके आख़िरी देखे गए चैनल कार्यक्रम गाइड में सबसे ऊपर दिखाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pregled nakon gledanja nastavlja reproducirati kanal iza TV vodiča nakon izlaska iz prikaza preko cijelog zaslona. Nedavno gledano prikazuje kanale koje ste posljednje gledali na vrhu TV vodiča."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az „Előnézet a megtekintés után” a teljes képernyős nézet elhagyásakor tovább játssza a csatornát a műsorújság mögött. A „Legutóbb nézett” a legutóbb nézett csatornákat a műsorújság tetején jeleníti meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pratinjau setelah menonton terus memutar saluran di belakang panduan acara saat Anda keluar dari layar penuh. Baru ditonton menampilkan saluran yang terakhir Anda tonton di bagian atas panduan acara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anteprima dopo la visione mantiene il canale in riproduzione dietro la guida TV quando esci dallo schermo intero. Visti di recente mostra in cima alla guida TV gli ultimi canali che hai guardato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「視聴後もプレビューを表示」をオンにすると、全画面表示を終了した後も番組表の背後でチャンネルの再生を続けます。「最近視聴したチャンネル」では、最近視聴したチャンネルを番組表の上部に表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'시청 후 미리보기'를 켜면 전체 화면을 나가도 편성표 뒤에서 채널이 계속 재생됩니다. '최근 시청'은 최근에 시청한 채널을 편성표 맨 위에 표시합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pratonton selepas menonton terus memainkan saluran di belakang panduan rancangan apabila anda keluar daripada skrin penuh. Ditonton baru-baru ini menunjukkan saluran yang terakhir anda tonton di bahagian atas panduan rancangan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Forhåndsvisning etter visning lar kanalen fortsette å spille bak TV-guiden når du avslutter fullskjerm. Nylig sett viser kanalene du så på sist, øverst i TV-guiden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voorbeeld na het kijken laat het kanaal achter de tv-gids verder afspelen wanneer je de schermvullende weergave verlaat. Recent bekeken toont de kanalen die je het laatst hebt bekeken bovenaan de tv-gids."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opcja „Podgląd po oglądaniu” kontynuuje odtwarzanie kanału w tle programu TV po wyjściu z pełnego ekranu. Opcja „Ostatnio oglądane” wyświetla ostatnio oglądane kanały na górze programu TV."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A opção Prévia após assistir mantém o canal sendo reproduzido atrás do guia de programação ao sair da tela cheia. A opção Assistidos recentemente mostra os últimos canais assistidos no topo do guia de programação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opțiunea Previzualizare după vizionare continuă redarea canalului în spatele programului TV când ieși din modul ecran complet. Opțiunea Vizionate recent afișează ultimele canale vizionate în partea de sus a programului TV."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Параметр «Предпросмотр после просмотра» сохраняет воспроизведение канала на фоне телепрограммы при выходе из полноэкранного режима. Параметр «Недавно просмотренные» помещает последние просмотренные каналы в начало телепрограммы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Možnosť Náhľad po sledovaní zachová prehrávanie kanála na pozadí TV programu po ukončení režimu celej obrazovky. Možnosť Nedávno sledované zobrazí naposledy sledované kanály na začiatku TV programu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Možnost Predogled po ogledu po izhodu iz celozaslonskega načina nadaljuje predvajanje kanala za TV-sporedom. Možnost Nedavno gledano prikaže nazadnje gledane kanale na vrhu TV-sporeda."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opcija Pregled nakon gledanja nastavlja reprodukciju kanala iza TV programa kada izađete iz prikaza preko celog ekrana. Opcija Nedavno gledano prikazuje poslednje gledane kanale na vrhu TV programa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Förhandsgranskning efter visning fortsätter spela kanalen bakom tv-tablån när du lämnar helskärmsläget. Senast visade visar de kanaler du senast tittade på överst i tv-tablån."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ตัวเลือกแสดงตัวอย่างหลังรับชมจะเล่นช่องต่อไปด้านหลังผังรายการเมื่อออกจากโหมดเต็มหน้าจอ ตัวเลือกที่ดูล่าสุดจะแสดงช่องที่คุณดูล่าสุดไว้ด้านบนของผังรายการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "İzledikten sonra önizle seçeneği, tam ekrandan çıktığınızda kanalı yayın akışının arkasında oynatmaya devam eder. Son izlenenler seçeneği, en son izlediğiniz kanalları yayın akışının en üstünde gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Параметр «Попередній перегляд після перегляду» продовжує відтворення каналу на тлі телепрограми після виходу з повноекранного режиму. Параметр «Нещодавно переглянуті» показує останні переглянуті канали на початку телепрограми."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tùy chọn Xem trước sau khi xem tiếp tục phát kênh phía sau lịch phát sóng khi bạn thoát chế độ toàn màn hình. Tùy chọn Đã xem gần đây hiển thị các kênh bạn vừa xem ở đầu lịch phát sóng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“观看后继续预览”会在退出全屏后继续在节目表后方播放该频道。“最近观看”会将最近看过的频道显示在节目表顶部。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「觀看後繼續預覽」會在離開全螢幕後，繼續在節目表後方播放該頻道。「最近觀看」會將最近看過的頻道顯示在節目表頂端。"
          }
        }
      }
    },
