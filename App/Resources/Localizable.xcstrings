    "Use {url} for the encoded video link. Custom players don't receive resume positions or return progress." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "استخدم {url} للرابط المُرمَّز للفيديو. لا تتلقى تطبيقات التشغيل المخصصة مواضع استئناف المشاهدة، ولا تُعيد تقدّم المشاهدة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Използвайте {url} за кодирания адрес на видеото. Персонализираните плеъри не получават позиции за продължаване на възпроизвеждането и не връщат напредъка при гледане."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fes servir {url} per a l'enllaç codificat del vídeo. Els reproductors personalitzats no reben posicions de represa ni retornen el progrés de visualització."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pro zakódovaný odkaz na video použijte {url}. Vlastní přehrávače nepřijímají pozice pro pokračování v přehrávání ani nevracejí průběh sledování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brug {url} til det kodede videolink. Brugerdefinerede afspillere får ikke oplyst, hvor afspilningen skal genoptages, og melder ikke tilbage, hvor langt du er nået."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verwende {url} für den kodierten Videolink. Benutzerdefinierte Player erhalten keine Wiedergabepositionen zum Fortsetzen und melden keinen Wiedergabefortschritt zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Χρησιμοποιήστε το {url} για τον κωδικοποιημένο σύνδεσμο του βίντεο. Οι προσαρμοσμένες εφαρμογές αναπαραγωγής δεν λαμβάνουν σημεία συνέχισης της αναπαραγωγής ούτε επιστρέφουν πρόοδο παρακολούθησης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa {url} para el enlace codificado del vídeo. Los reproductores personalizados no reciben puntos de reanudación ni devuelven el progreso de visualización."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برای پیوند کدگذاری‌شدهٔ ویدیو از {url} استفاده کنید. پخش‌کننده‌های سفارشی نقاط ادامهٔ پخش را دریافت نمی‌کنند و پیشرفت تماشا را برنمی‌گردانند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Käytä koodatun videolinkin paikkamerkkinä merkintää {url}. Omat toistosovellukset eivät vastaanota jatkamiskohtia eivätkä palauta katselun edistymistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilisez {url} pour le lien vidéo encodé. Les lecteurs personnalisés ne reçoivent pas les positions de reprise et ne renvoient pas la progression de lecture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "יש להשתמש ב־{url} עבור קישור הווידאו המקודד. נגנים מותאמים אישית אינם מקבלים נקודות להמשך צפייה ואינם מחזירים את התקדמות הצפייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एन्कोड किए गए वीडियो लिंक के लिए {url} इस्तेमाल करें। कस्टम प्लेयर को प्लेबैक फिर से शुरू करने का स्थान नहीं भेजा जाता और वे देखने की प्रगति वापस नहीं भेजते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Za kodiranu poveznicu na videozapis upotrijebite {url}. Prilagođeni reproduktori ne primaju položaj za nastavak reprodukcije niti vraćaju napredak gledanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A kódolt videóhivatkozás helyén használja a {url} helyőrzőt. Az egyéni lejátszók nem kapnak folytatási pozíciót, és nem küldik vissza a megtekintés állását."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gunakan {url} untuk tautan video yang dikodekan. Pemutar kustom tidak menerima posisi untuk melanjutkan pemutaran dan tidak mengirim kembali progres tontonan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
