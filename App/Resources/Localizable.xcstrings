    "Preparing the selected option without changing your library. Results are cached while you browse." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "جارٍ إعداد الخيار المحدد دون تغيير مكتبتك. تُخزَّن النتائج مؤقتًا أثناء تصفحك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Подготвя се избраната опция, без да се променя медиатеката ви. Резултатите се кешират, докато разглеждате."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "S'està preparant l'opció seleccionada sense modificar la teva biblioteca. Els resultats es mantenen a la memòria cau mentre navegues."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Připravuje se vybraná možnost beze změn ve vaší knihovně. Výsledky zůstávají v mezipaměti během procházení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den valgte indstilling klargøres uden at ændre dit bibliotek. Resultaterne gemmes i cachen, mens du gennemser biblioteket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die ausgewählte Option wird vorbereitet, ohne deine Medienbibliothek zu verändern. Die Ergebnisse werden zwischengespeichert, während du stöberst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η επιλογή σας προετοιμάζεται χωρίς αλλαγές στη βιβλιοθήκη σας. Τα αποτελέσματα αποθηκεύονται προσωρινά όσο περιηγείστε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se está preparando la opción seleccionada sin modificar tu biblioteca multimedia. Los resultados se almacenan en caché mientras navegas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "گزینهٔ انتخاب‌شده بدون تغییر کتابخانهٔ شما آماده می‌شود. نتایج هنگام مرور در حافظهٔ نهان نگه داشته می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valittua vaihtoehtoa valmistellaan muuttamatta kirjastoasi. Tulokset säilytetään välimuistissa selailun ajan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Préparation de l’option sélectionnée sans modifier votre bibliothèque. Les résultats sont mis en cache pendant votre navigation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הכנת האפשרות שנבחרה בלי לשנות את הספרייה שלך. התוצאות נשמרות במטמון בזמן העיון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपकी लाइब्रेरी में बदलाव किए बिना चुना गया विकल्प तैयार हो रहा है. ब्राउज़ करते समय नतीजे कैश में रखे जाते हैं."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Priprema odabrane opcije bez promjene vaše knjižnice. Rezultati se pohranjuju u predmemoriju dok pregledavate."
          }
