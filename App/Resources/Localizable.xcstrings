        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Löydä elokuvia ja sarjoja valitsemistasi lähteistä. Seerr on valinnainen palvelu nimikkeiden pyytämistä varten."
