          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Déconnexion effectuée dans Plozz. WeTrakr n’a pas pu révoquer la session. Retirez Plozz de vos applications connectées sur WeTrakr."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "החיבור ב-Plozz נותק. WeTrakr לא הצליח לבטל את תוקף ההפעלה; יש להסיר את Plozz מהאפליקציות המחוברות שלך ב-WeTrakr."
