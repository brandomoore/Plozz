        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "उपलब्ध लाइब्रेरियों के चैनल तैयार हैं। कुछ सर्वरों पर अभी ध्यान देने की आवश्यकता है।"
