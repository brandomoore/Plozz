        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Χρησιμοποιούνται οι σειρές που έχει ορίσει ο διακομιστής Plex για προβολή στην Αρχική. Οι επιλογές καρφιτσώματος βιβλιοθηκών στην πλαϊνή στήλη άλλων εφαρμογών δεν είναι διαθέσιμες εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se usan las filas que el servidor Plex ha destacado en Inicio. Las preferencias de bibliotecas fijadas en la barra lateral de otros clientes no están disponibles aquí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "از سطرهایی استفاده می‌شود که سرور Plex برای نمایش در خانه تعیین کرده است. این برنامه به تنظیمات سنجاق کردن کتابخانه‌ها در نوار کناری سایر برنامه‌ها دسترسی ندارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Käytetään Plex-palvelimen Koti-näkymään nostamia rivejä. Muiden sovellusten valinnat kirjastojen kiinnittämisestä sivupalkkiin eivät ole käytettävissä täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les rangées mises en avant sur l’accueil par le serveur Plex sont utilisées. Les choix d’épinglage de bibliothèques dans la barre latérale d’autres applications ne sont pas disponibles ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "נעשה שימוש בשורות ששרת Plex בחר להציג במסך הבית. לא מתקבל מידע על הספריות שהוצמדו לסרגל הצד ביישומים אחרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plex द्वारा होम पर प्रमुखता से दिखाई जाने वाली रो का उपयोग किया जा रहा है। दूसरे क्लाइंट में साइडबार पर लाइब्रेरी पिन करने की सहेजी गई सेटिंग्स यहाँ उपलब्ध नहीं हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koriste se redovi koje Plex ističe na Početnoj. Spremljene postavke prikvačivanja knjižnica na bočnu traku iz drugih klijenata ovdje nisu dostupne."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Plex által a Kezdőlapon kiemelt sorok jelennek meg. A könyvtárak oldalsávra rögzítésének más kliensekben mentett beállításai itt nem érhetők el."
          }
        },
