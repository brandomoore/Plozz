        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Filmele și episoadele compatibile se deschid în aplicația selectată. Orice alt conținut este redat automat în Plozz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Поддерживаемые фильмы и серии открываются в выбранном приложении. Всё остальное автоматически воспроизводится в Plozz."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podporované filmy a epizódy sa otvoria vo vybranej aplikácii. Všetko ostatné sa automaticky prehrá v aplikácii Plozz."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podprti filmi in epizode se odprejo v izbrani aplikaciji. Vse drugo se samodejno predvaja v aplikaciji Plozz."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podržani filmovi i epizode otvaraju se u izabranoj aplikaciji. Sav ostali sadržaj automatski se reprodukuje u aplikaciji Plozz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Filmer och avsnitt som stöds öppnas i den valda appen. Allt annat spelas automatiskt upp i Plozz."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ภาพยนตร์และตอนที่รองรับจะเปิดในแอปที่เลือก ส่วนเนื้อหาอื่นจะเล่นใน Plozz โดยอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desteklenen filmler ve bölümler seçilen uygulamada açılır. Diğer tüm içerikler otomatik olarak Plozz'da oynatılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Підтримувані фільми й серії відкриваються у вибраній програмі. Решта вмісту автоматично відтворюється в Plozz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Phim và tập phim được hỗ trợ sẽ mở trong ứng dụng đã chọn. Các nội dung khác sẽ tự động phát trong Plozz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "支持播放的电影和剧集单集会在所选应用中打开。其他内容会自动在 Plozz 中播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "支援的電影和影集單集會在所選 App 中開啟。其他內容會自動在 Plozz 中播放。"
          }
        }
      }
    },
