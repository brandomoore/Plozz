    "To also erase iCloud Keychain server logins, use Plozz on iPhone or iPad." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لمسح بيانات تسجيل الدخول إلى الخوادم من سلسلة مفاتيح iCloud أيضًا، استخدم Plozz على iPhone أو iPad."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "За да изтриете и данните за вход в сървъри от iCloud Keychain, използвайте Plozz на iPhone или iPad."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Per esborrar també les credencials d’accés als servidors del clauer de l’iCloud, fes servir Plozz a l’iPhone o a l’iPad."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chcete-li smazat i přihlašovací údaje k serverům v Klíčence na iCloudu, použijte Plozz na zařízení iPhone nebo iPad."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brug Plozz på iPhone eller iPad for også at slette loginoplysninger til servere fra iCloud-nøglering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um auch Server-Anmeldedaten aus dem iCloud-Schlüsselbund zu löschen, verwende Plozz auf dem iPhone oder iPad."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Για να διαγράψετε και τα στοιχεία σύνδεσης σε διακομιστές από την Κλειδοθήκη iCloud, χρησιμοποιήστε το Plozz σε iPhone ή iPad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para borrar también del Llavero de iCloud las credenciales de acceso a servidores, usa Plozz en un iPhone o iPad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برای اینکه اطلاعات ورود به سرورها از iCloud Keychain هم پاک شود، از Plozz در iPhone یا iPad استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jos haluat poistaa myös palvelinten kirjautumistiedot iCloud-avainnipusta, käytä Plozzia iPhonella tai iPadilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pour effacer également du Trousseau iCloud les identifiants de connexion aux serveurs, utilisez Plozz sur iPhone ou iPad."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "כדי למחוק גם את פרטי ההתחברות לשרתים מצרור המפתחות של iCloud, יש להשתמש ב־Plozz ב־iPhone או ב־iPad."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iCloud कीचेन से सर्वर लॉगिन भी हटाने के लिए iPhone या iPad पर Plozz का इस्तेमाल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Da biste iz iCloud privjeska ključeva izbrisali i podatke za prijavu na poslužitelje, upotrijebite Plozz na iPhoneu ili iPadu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ha az iCloud-kulcskarikából is törölni szeretné a szerveres bejelentkezési adatokat, használja a Plozz alkalmazást iPhone vagy iPad készüléken."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Untuk juga menghapus informasi login server dari Rantai Kunci iCloud, gunakan Plozz di iPhone atau iPad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Per eliminare anche le credenziali dei server dal Portachiavi iCloud, usa Plozz su iPhone o iPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iCloudキーチェーンのサーバログイン情報も消去するには、iPhoneまたはiPadのPlozzを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iCloud 키체인의 서버 로그인 정보도 삭제하려면 iPhone 또는 iPad에서 Plozz를 사용하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Untuk turut memadamkan maklumat log masuk pelayan dalam Rantai Kunci iCloud, gunakan Plozz pada iPhone atau iPad."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bruk Plozz på iPhone eller iPad for også å slette serverpålogginger fra iCloud-nøkkelringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gebruik Plozz op iPhone of iPad om ook serveraanmeldgegevens uit de iCloud-sleutelhanger te wissen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aby usunąć także dane logowania do serwerów z pęku kluczy iCloud, użyj Plozz na urządzeniu iPhone lub iPad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para também apagar os dados de acesso a servidores das Chaves do iCloud, use o Plozz no iPhone ou iPad."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pentru a șterge și datele de autentificare pentru servere din Portchei iCloud, folosește Plozz pe iPhone sau iPad."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Чтобы также удалить данные входа на серверы из Связки ключей iCloud, используйте Plozz на iPhone или iPad."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ak chcete vymazať aj prihlasovacie údaje k serverom z iCloud Kľúčenky, použite Plozz na zariadení iPhone alebo iPad."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Če želite izbrisati tudi prijavne podatke za strežnike iz obeska za ključe iCloud, uporabite Plozz v napravi iPhone ali iPad."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Da biste obrisali i podatke za prijavu na servere iz iCloud Keychain-a, koristite Plozz na uređaju iPhone ili iPad."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Använd Plozz på iPhone eller iPad för att även radera serverinloggningar från iCloud-nyckelringen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "หากต้องการลบข้อมูลเข้าสู่ระบบเซิร์ฟเวอร์ในพวงกุญแจ iCloud ด้วย ให้ใช้ Plozz บน iPhone หรือ iPad"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iCloud Anahtar Zinciri’ndeki sunucu giriş bilgilerini de silmek için iPhone veya iPad’de Plozz’u kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Щоб також видалити дані входу на сервери з В’язки iCloud, скористайтеся Plozz на iPhone або iPad."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Để xóa cả thông tin đăng nhập máy chủ trong Chuỗi khóa iCloud, hãy dùng Plozz trên iPhone hoặc iPad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "如需一并抹掉 iCloud 钥匙串中的服务器登录信息，请在 iPhone 或 iPad 上使用 Plozz。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "若要一併清除 iCloud 鑰匙圈中的伺服器登入資訊，請在 iPhone 或 iPad 上使用 Plozz。"
          }
        }
      }
    },
    "To lock rotation on iPad, open Playback options in the player. Requires iPadOS 26 or later and a full-screen window." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لقفل التدوير على iPad، افتح «خيارات التشغيل» في المشغّل. يتطلب ذلك iPadOS 26 أو أحدث ونافذة بملء الشاشة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "За да заключите завъртането на iPad, отворете „Опции за възпроизвеждане“ в плейъра. Изискват се iPadOS 26 или по-нова версия и прозорец на цял екран."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Per bloquejar la rotació a l'iPad, obre «Opcions de reproducció» al reproductor. Cal tenir iPadOS 26 o posterior i una finestra a pantalla completa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chcete-li na zařízení iPad uzamknout otáčení, otevřete v přehrávači „Možnosti přehrávání“. Funkce vyžaduje iPadOS 26 nebo novější a okno na celé obrazovce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "For at låse rotation på iPad skal du åbne »Afspilningsmuligheder« i afspilleren. Kræver iPadOS 26 eller nyere og et vindue på fuld skærm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um die Drehung auf dem iPad zu sperren, öffne im Player die Wiedergabeoptionen. Erfordert iPadOS 26 oder neuer und ein Fenster im Vollbildmodus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Για να κλειδώσετε την περιστροφή στο iPad, ανοίξτε τις «Επιλογές αναπαραγωγής» στο πρόγραμμα αναπαραγωγής. Απαιτούνται iPadOS 26 ή νεότερη έκδοση και παράθυρο πλήρους οθόνης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para bloquear la rotación en el iPad, abre «Opciones de reproducción» en el reproductor. Requiere iPadOS 26 o posterior y una ventana a pantalla completa."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برای قفل کردن چرخش در iPad، «گزینه‌های پخش» را در پخش‌کننده باز کنید. به iPadOS 26 یا جدیدتر و یک پنجرهٔ تمام‌صفحه نیاز دارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voit lukita kierron iPadissa avaamalla soittimen Toistovalinnat-valikon. Vaatii iPadOS 26:n tai uudemman ja koko näytön ikkunan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pour verrouiller la rotation sur iPad, ouvrez les Options de lecture dans le lecteur. Nécessite iPadOS 26 ou une version ultérieure et une fenêtre en plein écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "כדי לנעול את הסיבוב ב-iPad, יש לפתוח את ״אפשרויות ניגון״ בנגן. נדרשים iPadOS 26 ואילך וחלון במסך מלא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iPad पर रोटेशन लॉक करने के लिए, प्लेयर में “प्लेबैक विकल्प” खोलें। इसके लिए iPadOS 26 या बाद का संस्करण और फ़ुल-स्क्रीन विंडो ज़रूरी है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Za zaključavanje rotacije na uređaju iPad otvorite „Mogućnosti reprodukcije” u reproduktoru. Potrebni su iPadOS 26 ili novija verzija i prozor na cijelom zaslonu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az elforgatás zárolásához iPaden nyissa meg a lejátszóban a „Lejátszási lehetőségek” menüt. Ehhez iPadOS 26 vagy újabb rendszer és teljes képernyős ablak szükséges."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Untuk mengunci rotasi di iPad, buka Opsi pemutaran di pemutar. Memerlukan iPadOS 26 atau lebih baru dan jendela layar penuh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Per bloccare la rotazione su iPad, apri Opzioni di riproduzione nel lettore. Richiede iPadOS 26 o versioni successive e una finestra a schermo intero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iPadで画面の回転をロックするには、プレーヤーの「再生オプション」を開いてください。iPadOS 26以降と全画面表示のウインドウが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iPad에서 회전을 잠그려면 플레이어의 ‘재생 옵션’을 여세요. iPadOS 26 이상과 전체 화면 창이 필요합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Untuk mengunci putaran pada iPad, buka Pilihan main balik dalam pemain. Memerlukan iPadOS 26 atau lebih baharu dan tetingkap skrin penuh."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "For å låse rotasjonen på iPad, åpne Avspillingsvalg i spilleren. Krever iPadOS 26 eller nyere og et vindu i fullskjermmodus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Open Afspeelopties in de speler om de rotatie op iPad te vergrendelen. Vereist iPadOS 26 of nieuwer en een schermvullend venster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aby zablokować obrót na urządzeniu iPad, otwórz „Opcje odtwarzania” w odtwarzaczu. Wymaga to systemu iPadOS 26 lub nowszego oraz okna pełnoekranowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para bloquear a rotação no iPad, abra Opções de reprodução no reprodutor. Requer iPadOS 26 ou posterior e uma janela em tela cheia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pentru a bloca rotirea pe iPad, deschide Opțiuni de redare în player. Necesită iPadOS 26 sau o versiune ulterioară și o fereastră pe tot ecranul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Чтобы заблокировать поворот на iPad, откройте «Параметры воспроизведения» в плеере. Требуются iPadOS 26 или новее и полноэкранный режим окна."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ak chcete zamknúť otáčanie na zariadení iPad, otvorte v prehrávači Možnosti prehrávania. Vyžaduje sa iPadOS 26 alebo novší a okno na celej obrazovke."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Če želite zakleniti vrtenje v napravi iPad, v predvajalniku odprite Možnosti predvajanja. Potrebujete iPadOS 26 ali novejši in celozaslonsko okno."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Da biste zaključali rotaciju na uređaju iPad, otvorite Opcije reprodukcije u plejeru. Potrebni su iPadOS 26 ili noviji i prozor preko celog ekrana."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "För att låsa rotationen på iPad öppnar du Uppspelningsalternativ i spelaren. Kräver iPadOS 26 eller senare och ett fönster i helskärm."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "หากต้องการล็อกการหมุนบน iPad ให้เปิดตัวเลือกการเล่นในเครื่องเล่น ต้องใช้ iPadOS 26 ขึ้นไปและหน้าต่างแบบเต็มหน้าจอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iPad’de döndürmeyi kilitlemek için oynatıcıdaki “Oynatma seçenekleri”ni açın. iPadOS 26 veya daha yeni bir sürüm ve tam ekran bir pencere gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Щоб заблокувати обертання на iPad, відкрийте «Параметри відтворення» у програвачі. Потрібні iPadOS 26 або новіша версія та повноекранне вікно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Để khóa xoay trên iPad, hãy mở Tùy chọn phát trong trình phát. Yêu cầu iPadOS 26 trở lên và cửa sổ toàn màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "要在 iPad 上锁定旋转，请在播放器中打开“播放选项”。需要 iPadOS 26 或更高版本，且窗口须处于全屏模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "若要在 iPad 上鎖定旋轉，請在播放器中開啟「播放選項」。需要 iPadOS 26 或以上版本，且視窗須處於全螢幕模式。"
          }
        }
      }
    },
