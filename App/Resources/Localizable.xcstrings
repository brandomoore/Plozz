    "Online artwork favors images without text. Library artwork keeps your chosen images." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُفضَّل الصور الخالية من النصوص عند استخدام صور الإنترنت. أما صور المكتبة فتحافظ على الصور التي اخترتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "При онлайн изображенията се предпочитат тези без текст. При изображенията от медиатеката се запазват избраните от вас изображения."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Amb les imatges en línia, es prioritzen les imatges sense text. Amb les de la biblioteca, es conserven les que has triat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "U obrázků z internetu mají přednost obrázky bez textu. U obrázků z knihovny se zachovají vámi vybrané obrázky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ved onlinebilleder foretrækkes billeder uden tekst. Ved biblioteksbilleder beholdes de billeder, du har valgt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bei Onlinebildern werden Bilder ohne Text bevorzugt. Bei Bildmaterial aus der Medienbibliothek bleiben deine ausgewählten Bilder erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Με τις εικόνες διαδικτύου προτιμώνται εικόνες χωρίς κείμενο. Με τις εικόνες βιβλιοθήκης διατηρούνται οι εικόνες που έχετε επιλέξει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Con las imágenes en línea se priorizan las imágenes sin texto. Con las imágenes de la biblioteca multimedia se conservan las que has elegido."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "با تصاویر اینترنتی، تصاویر بدون متن در اولویت‌اند. با تصاویر کتابخانه، تصاویر انتخابی شما حفظ می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verkkokuvituksessa suositaan kuvia, joissa ei ole tekstiä. Kirjaston kuvitus säilyttää valitsemasi kuvat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avec les images en ligne, les images sans texte sont privilégiées. Avec les illustrations de la bibliothèque, les images que vous avez choisies sont conservées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "בתמונות מהאינטרנט ניתנת עדיפות לתמונות ללא טקסט. בתמונות מהספרייה נשמרות התמונות שבחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ऑनलाइन चित्रों में ऐसे चित्रों को प्राथमिकता दी जाती है जिन पर कुछ लिखा न हो। लाइब्रेरी के चित्रों में आपके चुने हुए चित्र रखे जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pri korištenju slika s interneta prednost imaju slike bez teksta. Pri korištenju slika iz knjižnice zadržavaju se slike koje ste odabrali."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az online képek használata a szöveg nélküli képeket részesíti előnyben. A könyvtár képeinek használata megtartja a kiválasztott képeket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Untuk gambar online, gambar tanpa teks diutamakan. Untuk gambar pustaka, gambar pilihan Anda dipertahankan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
