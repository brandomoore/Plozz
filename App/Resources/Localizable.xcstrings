        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sobre o Plozz. Versão %1$@, compilação %2$@. Reúna todas as suas mídias em uma experiência unificada. Grátis para sempre e de código aberto. Escaneie o código na tela para ver o repositório no GitHub."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Despre Plozz. Versiunea %1$@, compilația %2$@. Reunește tot conținutul tău media într-o experiență unificată. Gratuit pentru totdeauna și cu sursă deschisă. Scanează codul de pe ecran pentru a vedea proiectul pe GitHub."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "О приложении Plozz. Версия %1$@, сборка %2$@. Объедините все свои медиа в одном приложении. Бесплатно навсегда и с открытым исходным кодом. Отсканируйте код на экране, чтобы открыть репозиторий GitHub."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O aplikácii Plozz. Verzia %1$@, zostavenie %2$@. Spojte všetky svoje médiá do jedného jednotného prostredia. Navždy zadarmo a s otvoreným zdrojovým kódom. Naskenujte kód na obrazovke a zobrazte si repozitár na GitHube."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O aplikaciji Plozz. Različica %1$@, delovna različica %2$@. Združite vse svoje medije v eno enotno izkušnjo. Brezplačno za vedno in odprtokodno. Optično preberite kodo na zaslonu za ogled repozitorija GitHub."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O aplikaciji Plozz. Verzija %1$@, izdanje %2$@. Objedinite sve svoje medije u jedno jedinstveno iskustvo. Besplatno zauvek i otvorenog koda. Skenirajte kod na ekranu da biste otvorili GitHub repozitorijum."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Om Plozz. Version %1$@, bygge %2$@. Samla alla dina medier i en enhetlig upplevelse. Gratis för alltid, med öppen källkod. Skanna koden på skärmen för att öppna GitHub-projektet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เกี่ยวกับ Plozz เวอร์ชัน %1$@ บิลด์ %2$@ รวมสื่อทั้งหมดไว้ในที่เดียว ฟรีตลอดไปและเป็นโอเพนซอร์ส สแกนคิวอาร์โค้ดบนหน้าจอเพื่อดูคลังโค้ดบน GitHub"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plozz hakkında. Sürüm %1$@, derleme %2$@. Tüm medyanızı tek bir deneyimde bir araya getirin. Sonsuza dek ücretsiz ve açık kaynaklı. GitHub deposunu görüntülemek için ekrandaki kodu tarayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Про Plozz. Версія %1$@, збірка %2$@. Об’єднайте всі свої медіа в одному цілісному просторі. Назавжди безплатно й із відкритим кодом. Відскануйте код на екрані, щоб відкрити репозиторій GitHub."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Giới thiệu về Plozz. Phiên bản %1$@, bản dựng %2$@. Đưa tất cả phương tiện của bạn vào một trải nghiệm thống nhất. Miễn phí mãi mãi và mã nguồn mở. Quét mã trên màn hình để xem kho lưu trữ GitHub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "关于 Plozz。版本 %1$@，构建版本 %2$@。将所有媒体整合到一个统一的体验中。永久免费且开源。扫描屏幕上的二维码以查看 GitHub 仓库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "關於 Plozz。版本 %1$@，組建 %2$@。將你的所有媒體匯集成統一的體驗。永久免費且開放原始碼。掃描螢幕上的代碼即可檢視 GitHub 儲存庫。"
          }
        }
      }
