    "Mix movies and shows from your selected collections, without duplicate titles." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "امزج الأفلام والمسلسلات من المجموعات التي حددتها، دون تكرار الأعمال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Комбинирайте филми и сериали от избраните колекции без повтарящи се заглавия."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Combina pel·lícules i sèries de les col·leccions seleccionades, sense títols duplicats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kombinujte filmy a seriály z vybraných kolekcí bez duplicitních titulů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bland film og serier fra dine valgte samlinger uden gentagne titler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kombiniere Filme und Serien aus deinen ausgewählten Sammlungen, ohne doppelte Titel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Συνδυάστε ταινίες και σειρές από τις επιλεγμένες συλλογές σας, χωρίς διπλότυπους τίτλους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Combina películas y series de tus colecciones seleccionadas, sin títulos duplicados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "فیلم‌ها و سریال‌های مجموعه‌های انتخابی‌تان را بدون تکرار عنوان‌ها با هم ترکیب کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yhdistä elokuvia ja sarjoja valitsemistasi kokoelmista ilman päällekkäisiä nimikkeitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mélangez les films et les séries de vos collections sélectionnées, sans doublons."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "שילוב סרטים וסדרות מהאוספים שנבחרו, ללא כותרים כפולים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अपने चुने हुए संग्रहों की मूवी और टीवी शो को एक साथ दिखाएँ, बिना किसी शीर्षक को दोहराए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kombinirajte filmove i serije iz odabranih zbirki, bez ponavljanja naslova."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jelenítse meg együtt a kiválasztott gyűjtemények filmjeit és sorozatait, ismétlődő címek nélkül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gabungkan film dan acara TV dari koleksi yang Anda pilih, tanpa judul duplikat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Combina film e serie TV delle raccolte selezionate, senza titoli duplicati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "選択したコレクションの映画とテレビ番組を、作品が重複しないようにまとめて表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "선택한 컬렉션의 영화와 TV 프로그램을 중복 없이 함께 표시합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
