    },
    "Ask before each multi-version video, including autoplay, or choose automatically without opening the version picker." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "السؤال قبل كل فيديو له عدة نسخ، بما في ذلك عند التشغيل التلقائي، أو الاختيار تلقائيًا دون فتح منتقي النسخ."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Питане преди всеки видеоклип с няколко версии, включително при автоматично възпроизвеждане, или автоматичен избор, без да се отваря менюто за избор на версия."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pregunta abans de cada vídeo amb diverses versions, també durant la reproducció automàtica, o tria automàticament sense obrir el selector de versions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ptát se před každým videem s více verzemi, i při automatickém přehrávání, nebo vybrat automaticky bez otevření nabídky verzí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spørg før hver video med flere versioner, også ved automatisk afspilning, eller vælg automatisk uden at åbne versionsvælgeren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vor jedem Video mit mehreren Versionen fragen, auch bei automatischer Wiedergabe, oder automatisch wählen, ohne die Versionsauswahl zu öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Να γίνεται ερώτηση πριν από κάθε βίντεο με πολλές εκδόσεις, ακόμη και κατά την αυτόματη αναπαραγωγή, ή να επιλέγεται αυτόματα έκδοση χωρίς να ανοίγει ο επιλογέας εκδόσεων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Preguntar antes de cada vídeo con varias versiones, también durante la reproducción automática, o elegir automáticamente sin abrir el selector de versiones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پیش از هر ویدیوی دارای چند نسخه، از جمله هنگام پخش خودکار، سؤال شود یا بدون باز کردن انتخابگر نسخه، به‌طور خودکار انتخاب شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kysy ennen jokaista videota, josta on useita versioita, myös automaattisessa toistossa, tai valitse automaattisesti avaamatta versionvalitsinta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Demander avant chaque vidéo ayant plusieurs versions, y compris en lecture automatique, ou choisir automatiquement sans ouvrir le sélecteur de versions."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
