        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un sol PIN protegeix la configuració compartida i la sortida dels perfils infantils. Sense aquest PIN, aquestes accions continuen disponibles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
