        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Da prioridad a los títulos que no se hayan mostrado recientemente en la portada. Desactiva esta opción para mantener el orden de tu Watchlist."
          }
        },
        "fa" : {
          "stringUnit" : {
