    "Supported movies and episodes open in the selected app. Everything else plays in Plozz automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُفتح الأفلام والحلقات المدعومة في التطبيق المحدد. ويُشغَّل كل ما عداها في Plozz تلقائيًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Поддържаните филми и епизоди се отварят в избраното приложение. Всичко останало се възпроизвежда автоматично в Plozz."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les pel·lícules i els episodis compatibles s'obren a l'aplicació seleccionada. La resta es reprodueix automàticament a Plozz."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podporované filmy a epizody se otevírají ve vybrané aplikaci. Vše ostatní se automaticky přehrává v Plozz."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Understøttede film og afsnit åbnes i den valgte app. Alt andet afspilles automatisk i Plozz."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Unterstützte Filme und Folgen werden in der ausgewählten App geöffnet. Alles andere wird automatisch in Plozz abgespielt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι υποστηριζόμενες ταινίες και τα επεισόδια ανοίγουν στην επιλεγμένη εφαρμογή. Όλα τα υπόλοιπα αναπαράγονται αυτόματα στο Plozz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las películas y los episodios compatibles se abren en la aplicación seleccionada. Todo lo demás se reproduce automáticamente en Plozz."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "فیلم‌ها و قسمت‌های پشتیبانی‌شده در برنامهٔ انتخاب‌شده باز می‌شوند. بقیهٔ محتوا به‌طور خودکار در Plozz پخش می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tuetut elokuvat ja jaksot avautuvat valitussa sovelluksessa. Kaikki muu toistetaan automaattisesti Plozzissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les films et épisodes compatibles s’ouvrent dans l’application sélectionnée. Tout le reste est lu automatiquement dans Plozz."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "סרטים ופרקים נתמכים נפתחים באפליקציה שנבחרה. כל השאר מתנגן ב־Plozz באופן אוטומטי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "समर्थित फ़िल्में और एपिसोड चुने गए ऐप में खुलते हैं। बाकी सब कुछ अपने-आप Plozz में चलता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podržani filmovi i epizode otvaraju se u odabranoj aplikaciji. Sve ostalo automatski se reproducira u aplikaciji Plozz."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A támogatott filmek és epizódok a kiválasztott alkalmazásban nyílnak meg. Minden más automatikusan a Plozzban játszódik le."
          }
        },
        "id" : {
          "stringUnit" : {
