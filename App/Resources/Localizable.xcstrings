        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Om Plozz. Versjon %1$@, bygg %2$@. Samle alle mediene dine i én opplevelse. Gratis for alltid og med åpen kildekode. Skann koden på skjermen for å åpne GitHub-repositoriet."
          }
        },
        "nl" : {
          "stringUnit" : {
