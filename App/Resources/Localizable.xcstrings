          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A kedvenc Multiview-ket nem sikerült betölteni vagy menteni. Próbáld újra a módosítások megőrzéséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
