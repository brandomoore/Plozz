            "value" : "जहां आपने छोड़ा था, वहीं से फिर शुरू करें, सबसे सामने."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nastavite tamo gdje ste stali, u prvom planu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folytasd ott, ahol abbahagytad, középen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lanjutkan dari terakhir Anda berhenti, tampil paling depan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Riprendi da dove avevi interrotto, in primo piano."
