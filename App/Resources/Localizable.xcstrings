    "Add Continue Watching to Home to include Next Up." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أضف «متابعة المشاهدة» إلى «الرئيسية» لتضمين «الحلقات التالية»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Добавете „Продължете да гледате“ в „Начало“, за да включите „Следващи епизоди“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Afegeix «Continua mirant» a Inici per incloure «Episodis següents»."
