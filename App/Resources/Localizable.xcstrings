          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Συνδεθείτε σε Wi-Fi ή Ethernet ή απενεργοποιήστε το «Διακοπή χωρίς Wi-Fi ή Ethernet» στις Ρυθμίσεις → Ζωντανή τηλεόραση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
