    "Enter a complete HTTP or HTTPS playlist URL, without a username or password before the hostname." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أدخل عنوان URL كاملاً لقائمة التشغيل باستخدام HTTP أو HTTPS، من دون اسم مستخدم أو كلمة مرور قبل اسم المضيف."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Въведете пълен HTTP или HTTPS URL адрес на плейлист, без потребителско име или парола пред името на хоста."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Introdueix un URL complet de llista HTTP o HTTPS, sense nom d’usuari ni contrasenya abans del nom d’amfitrió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zadejte úplnou URL playlistu HTTP nebo HTTPS bez uživatelského jména či hesla před názvem hostitele."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Indtast en komplet HTTP- eller HTTPS-URL til afspilningslisten uden brugernavn eller adgangskode før værtsnavnet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gib eine vollständige HTTP- oder HTTPS-URL der Wiedergabeliste ein, ohne Benutzernamen oder Passwort vor dem Hostnamen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Εισαγάγετε ένα πλήρες URL λίστας αναπαραγωγής HTTP ή HTTPS, χωρίς όνομα χρήστη ή κωδικό πρόσβασης πριν από το όνομα κεντρικού υπολογιστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Introduce una URL HTTP o HTTPS completa para la lista, sin nombre de usuario ni contraseña antes del nombre del host."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
