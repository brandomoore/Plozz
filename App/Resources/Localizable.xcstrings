    "Disabled libraries are hidden from Home and library browsing." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "المكتبات المعطلة مخفية من الصفحة الرئيسية وتصفح المكتبات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Деактивираните медиатеки са скрити от началния екран и преглеждането на медиатеките."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les biblioteques desactivades s’amaguen d’Inici i de la navegació per biblioteques."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vypnuté knihovny jsou skryté na obrazovce Domů i při procházení knihoven."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deaktiverede biblioteker skjules fra Hjem og biblioteksgennemsyn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deaktivierte Medienbibliotheken werden auf „Start“ und beim Durchsuchen ausgeblendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι απενεργοποιημένες βιβλιοθήκες κρύβονται από την Αρχική και την περιήγηση στις βιβλιοθήκες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las bibliotecas multimedia desactivadas se ocultan en Inicio y en la navegación de bibliotecas multimedia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "کتابخانه‌های غیرفعال از خانه و مرور کتابخانه پنهان شده‌اند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Käytöstä poistetut kirjastot piilotetaan Kodista ja kirjastojen selauksesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les bibliothèques multimédias désactivées sont masquées de l’accueil et de la navigation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ספריות מושבתות מוסתרות ממסך הבית ומעיון בספריות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बंद की गई लाइब्रेरी होम और लाइब्रेरी ब्राउज़िंग से छिपी रहती हैं."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Onemogućene knjižnice skrivene su s Početne i iz pregledavanja knjižnica."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A letiltott könyvtárak elrejtve a Kezdőlapon és a könyvtár böngészésben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pustaka yang dinonaktifkan disembunyikan dari Beranda dan penelusuran pustaka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le librerie disattivate sono nascoste da Home e dalla navigazione delle librerie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "無効なライブラリはホームとライブラリブラウジングから非表示になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "사용 중지된 미디어 보관함은 홈과 미디어 보관함 탐색에서 숨겨집니다."
          }
        },
        "ms" : {
