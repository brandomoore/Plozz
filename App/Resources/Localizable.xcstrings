    "Sharing is optional. This report excludes server addresses, credentials, account names, and media titles." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "المشاركة اختيارية. لا يتضمّن هذا التقرير عناوين الخوادم أو بيانات تسجيل الدخول أو أسماء الحسابات أو عناوين الوسائط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Споделянето е по избор. Този доклад не съдържа адреси на сървъри, данни за вход, имена на акаунти и заглавия на медийно съдържание."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compartir és opcional. Aquest informe no inclou adreces de servidors, credencials, noms de comptes ni títols de contingut multimèdia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sdílení je volitelné. Tato zpráva neobsahuje adresy serverů, přihlašovací údaje, názvy účtů ani názvy mediálního obsahu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deling er valgfri. Denne rapport indeholder ikke serveradresser, loginoplysninger, kontonavne eller medietitler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Teilen ist optional. Dieser Bericht enthält keine Serveradressen, Zugangsdaten, Kontonamen oder Medientitel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η κοινοποίηση είναι προαιρετική. Αυτή η αναφορά δεν περιλαμβάνει διευθύνσεις διακομιστών, διαπιστευτήρια, ονόματα λογαριασμών ή τίτλους πολυμέσων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compartir es opcional. Este informe no incluye direcciones de servidores, credenciales, nombres de cuentas ni títulos del contenido multimedia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اشتراک‌گذاری اختیاری است. این گزارش شامل نشانی سرورها، اطلاعات ورود، نام حساب‌ها یا عنوان‌های رسانه‌ای نیست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jakaminen on vapaaehtoista. Tämä raportti ei sisällä palvelinten osoitteita, kirjautumistietoja, tilien nimiä eikä mediasisältöjen nimiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le partage est facultatif. Ce rapport ne contient ni adresses de serveurs, ni identifiants de connexion, ni noms de comptes, ni titres des médias."
          }
