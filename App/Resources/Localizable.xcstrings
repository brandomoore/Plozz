          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Von Plozz getrennt. WeTrakr konnte die Sitzung nicht widerrufen; entferne Plozz aus deinen verbundenen Apps auf WeTrakr."
