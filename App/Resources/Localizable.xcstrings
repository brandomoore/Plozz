    "Playback couldn't catch up to the channel. Retry or choose another channel." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعذّر على التشغيل اللحاق بالبث المباشر للقناة. أعد المحاولة أو اختر قناة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Възпроизвеждането не можа да достигне текущия момент от излъчването на канала. Опитайте отново или изберете друг канал."
          }
        },
        "ca" : {
          "stringUnit" : {
