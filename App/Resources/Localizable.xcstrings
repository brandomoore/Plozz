    "Resumes at the current position. Different cuts may have different timing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُستأنف التشغيل عند الموضع الحالي. قد يختلف التوقيت بين النسخ ذات المونتاج المختلف."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Продължава от текущата позиция. Различните монтажни версии може да имат различен хронометраж."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es reprèn a la posició actual. Els muntatges diferents poden tenir una temporització diferent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pokračuje od aktuální pozice. Různé střihové verze mohou mít odlišné časování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fortsætter fra den aktuelle position. Forskellige klippeversioner kan have forskellige tidsforløb."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Setzt die Wiedergabe an der aktuellen Position fort. Verschiedene Schnittfassungen können zeitlich voneinander abweichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Συνεχίζει από την τρέχουσα θέση. Διαφορετικές εκδοχές μοντάζ μπορεί να έχουν διαφορετικό χρονισμό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se reanuda en la posición actual. Las distintas versiones de montaje pueden tener tiempos diferentes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "از موقعیت فعلی ادامه می‌یابد. تدوین‌های مختلف ممکن است زمان‌بندی متفاوتی داشته باشند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jatkaa nykyisestä kohdasta. Eri leikkausversioiden ajoitukset voivat poiketa toisistaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reprend à la position actuelle. Les différents montages peuvent avoir des repères temporels différents."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הניגון מתחדש במיקום הנוכחי. גרסאות עריכה שונות עשויות להיות מתוזמנות אחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "मौजूदा स्थान से फिर शुरू होता है। अलग-अलग कट में दृश्यों का समय अलग हो सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nastavlja se od trenutačnog položaja. Različite montažne verzije mogu se vremenski razlikovati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az aktuális pozíciótól folytatja. A különböző vágott változatok időzítése eltérhet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Melanjutkan dari posisi saat ini. Versi suntingan yang berbeda mungkin memiliki waktu adegan yang berbeda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Riprende dalla posizione attuale. Versioni con montaggi diversi potrebbero avere tempistiche differenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "現在の位置から再開します。編集の異なる版では、場面のタイミングが異なる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "현재 위치에서 재생을 재개합니다. 편집본에 따라 재생 시점이 다를 수 있습니다."
