    "Common rows are combined across servers. Each server's other default rows stay visible." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُجمع الصفوف المشتركة بين الخوادم. وتبقى الصفوف الافتراضية الأخرى لكل خادم ظاهرة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Общите редове от сървърите се обединяват. Останалите редове по подразбиране на всеки сървър остават видими."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les files comunes dels servidors es combinen. La resta de files predeterminades de cada servidor continuen visibles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Společné řádky ze serverů se slučují. Ostatní výchozí řádky jednotlivých serverů zůstávají viditelné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fælles rækker samles på tværs af servere. Hver servers øvrige standardrækker forbliver synlige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gemeinsame Reihen werden serverübergreifend zusammengefasst. Die übrigen Standardreihen jedes Servers bleiben sichtbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι κοινές σειρές συνδυάζονται μεταξύ διακομιστών. Οι υπόλοιπες προεπιλεγμένες σειρές κάθε διακομιστή παραμένουν ορατές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las filas comunes se combinan entre servidores. Las demás filas predeterminadas de cada servidor siguen visibles."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سطرهای مشترک سرورها ترکیب می‌شوند. دیگر سطرهای پیش‌فرض هر سرور همچنان نمایش داده می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Palvelimien yhteiset rivit yhdistetään. Kunkin palvelimen muut oletusrivit pysyvät näkyvissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les rangées communes sont combinées entre les serveurs. Les autres rangées par défaut de chaque serveur restent visibles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "שורות משותפות משולבות בין השרתים. שאר שורות ברירת המחדל של כל שרת נשארות גלויות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अलग-अलग सर्वरों की समान रो को जोड़ा जाता है। हर सर्वर की बाकी डिफ़ॉल्ट रो भी दिखाई देती हैं।"
