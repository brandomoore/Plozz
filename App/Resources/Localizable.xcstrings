    "skipIntros.detail.autoDelay" : {
      "comment" : "One-line explanation shown under the skip-intro picker.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اعرض زر التخطي، ثم تخطَّ تلقائياً بعد بضع ثوانٍ."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Показва бутон за пропускане, след което пропуска автоматично след няколко секунди."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mostra un botó Omet i, al cap d’uns segons, ho omet automàticament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zobrazí tlačítko Přeskočit a po několika sekundách přeskočí automaticky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vis en Spring over-knap, og spring derefter automatisk over efter et par sekunder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeigt die Taste „Überspringen“ und überspringt nach wenigen Sekunden automatisch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Εμφανίζει κουμπί Παράλειψης και μετά παραλείπει αυτόματα ύστερα από λίγα δευτερόλεπτα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show a Skip button, then skip automatically after a few seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Muestra un botón para saltar y, después, salta automáticamente al cabo de unos segundos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نمایش دکمه‌ی رد شدن، سپس پس از چند ثانیه به صورت خودکار رد شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Näytä Ohita-painike ja ohita automaattisesti muutaman sekunnin kuluttua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Afficher un bouton Passer, puis passer automatiquement après quelques secondes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הצג כפתור דילוג, ואז דלג אוטומטית לאחר כמה שניות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्किप बटन दिखाता है, फिर कुछ सेकंड बाद अपने-आप स्किप करता है."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prikaži gumb Preskoči, a zatim automatski preskoči nakon nekoliko sekundi."
          }
        },
        "hu" : {
          "stringUnit" : {
