        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dona prioritat als títols que no han aparegut recentment a l'element destacat. Desactiva aquesta opció per mantenir l'ordre de la llista de seguiment."
