    "settings.profileLock.deviceOnly" : {
      "comment" : "Caveat shown when a Profile Lock is set while iCloud Sync is off, meaning the user's other devices won't have the lock.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مزامنة iCloud معطّلة، لذا يعمل هذا القفل على هذا الجهاز فقط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Синхронизацията с iCloud е изключена, затова заключването важи само на това устройство."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La sincronització d'iCloud està desactivada; aquest bloqueig només s'aplica en aquest dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Synchronizace s iCloud je vypnutá, takže tento zámek platí jen na tomto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iCloud-synkronisering er slået fra — denne lås gælder kun på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iCloud-Synchronisierung ist aus — diese Sperre gilt nur auf diesem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ο συγχρονισμός iCloud είναι απενεργοποιημένος — αυτό το κλείδωμα ισχύει μόνο σε αυτή τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iCloud Sync is off, so this lock only applies on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La sincronización de iCloud está desactivada — este bloqueo solo se aplica en este dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "همگام‌سازی iCloud غیرفعال است، بنابراین این قفل فقط روی این دستگاه اعمال می‌شود."
