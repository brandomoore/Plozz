          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ภาพประกอบจากไลบรารี พร้อมภาพไร้ข้อความสำหรับดูต่อและพื้นหลังที่หลากหลายสำหรับหน้ารายละเอียดเมื่อมีให้ใช้"
