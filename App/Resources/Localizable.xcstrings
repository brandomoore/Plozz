    "Multiview favorites could not be loaded or saved. Retry to keep your changes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعذّر تحميل العروض المتعددة المفضلة أو حفظها. أعد المحاولة للاحتفاظ بتغييراتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Любимите Мултиекрани не можаха да се заредят или запазят. Опитайте отново, за да запазите промените си."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No s’han pogut carregar o desar els Multiviews preferits. Torna-ho a provar per conservar els canvis."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oblíbená rozložení Multiview se nepodařilo načíst nebo uložit. Zkuste to znovu, aby se změny zachovaly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Favorit-Multivisninger kunne ikke indlæses eller gemmes. Prøv igen for at bevare dine ændringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Multiview-Favoriten konnten nicht geladen oder gespeichert werden. Versuche es erneut, um deine Änderungen zu speichern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Δεν ήταν δυνατή η φόρτωση ή η αποθήκευση των αγαπημένων Πολλαπλών προβολών. Δοκιμάστε ξανά για να διατηρήσετε τις αλλαγές σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudieron cargar o guardar las Vistas múltiples favoritas. Vuelve a intentarlo para conservar los cambios."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "موارد دلخواه نمای چندگانه بارگیری یا ذخیره نشدند. برای حفظ تغییرات دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
