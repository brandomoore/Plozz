    "Show overrides regional filtering. Hide keeps the category out of the guide. Automatic follows your country and language choices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يتجاوز «إظهار» التصفية حسب المنطقة. يُبقي «إخفاء» الفئة خارج دليل البرامج. يتبع «تلقائي» اختياراتك للبلدان واللغات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Показване“ има предимство пред регионалното филтриране. „Скриване“ скрива категорията от ТВ програмата. „Автоматично“ следва избора ви на държави и езици."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«Mostra» té prioritat sobre el filtratge regional. «Amaga» manté la categoria fora de la programació. «Automàtic» segueix la selecció de països i idiomes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Zobrazit“ má přednost před regionálním filtrováním. „Skrýt“ ponechá kategorii mimo TV program. „Automaticky“ se řídí vaším výběrem zemí a jazyků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Vis igen“ tilsidesætter regional filtrering. „Skjul“ holder kategorien ude af programoversigten. „Automatisk“ følger dine valg af lande og sprog."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Einblenden“ hat Vorrang vor der regionalen Filterung. „Ausblenden“ blendet die Kategorie in der Programmübersicht aus. „Automatisch“ folgt deiner Auswahl von Ländern und Sprachen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η «Εμφάνιση» παρακάμπτει το φιλτράρισμα ανά περιοχή. Η «Απόκρυψη» κρατά την κατηγορία εκτός οδηγού προγράμματος. Το «Αυτόματο» ακολουθεί τις επιλογές σας για χώρες και γλώσσες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«Mostrar» tiene prioridad sobre el filtro por región. «Ocultar» mantiene la categoría fuera de la guía de programación. «Automático» sigue tus opciones de países e idiomas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«نمایش دادن» فیلتر منطقه را نادیده می‌گیرد. «پنهان کردن» دسته‌بندی را از راهنمای برنامه‌ها پنهان نگه می‌دارد. «خودکار» از انتخاب‌های شما برای کشور و زبان پیروی می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Näytä ohittaa aluesuodatuksen. Piilota pitää luokan poissa ohjelmaoppaasta. Automaattinen noudattaa maa- ja kielivalintojasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "« Afficher » prime sur le filtrage par région. « Masquer » maintient la catégorie hors du programme TV. « Automatique » suit vos choix de pays et de langues."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "״הצג״ גובר על הסינון לפי אזור. ״הסתר״ משאיר את הקטגוריה מחוץ ללוח השידורים. ״אוטומטי״ פועל לפי בחירות המדינה והשפה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“दिखाएँ” क्षेत्र के फ़िल्टर को अनदेखा करता है। “छिपाएँ” श्रेणी को कार्यक्रम गाइड से बाहर रखता है। “स्वचालित” देश और भाषा के लिए आपके चयन के अनुसार काम करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opcija Prikaži nadjačava regionalno filtriranje. Opcija Sakrij izostavlja kategoriju iz TV vodiča. Opcija Automatski slijedi tvoje odabire država i jezika."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Megjelenítés felülbírálja a régió szerinti szűrést. Az Elrejtés kihagyja a kategóriát a műsorújságból. Az Automatikus a kiválasztott országokat és nyelveket veszi figyelembe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opsi Tampilkan mengabaikan filter wilayah. Opsi Sembunyikan membuat kategori tidak muncul di panduan acara. Opsi Otomatis mengikuti pilihan negara dan bahasa Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mostra ignora i filtri per area geografica. Nascondi esclude la categoria dalla guida TV. Automatico segue le tue scelte di paesi e lingue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「表示」は地域フィルターより優先されます。「非表示」はカテゴリを番組表に表示しません。「自動」は選択した国と言語に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‘표시’를 선택하면 지역 필터와 관계없이 표시됩니다. ‘숨기기’를 선택하면 편성표에서 해당 카테고리가 숨겨집니다. ‘자동’을 선택하면 국가 및 언어 설정을 따릅니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‘Tunjukkan’ mengatasi penapisan wilayah. ‘Sembunyikan’ memastikan kategori tidak dipaparkan dalam panduan rancangan. ‘Automatik’ mengikut pilihan negara dan bahasa anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vis overstyrer regionfiltrering. Skjul holder kategorien skjult i TV-guiden. Automatisk følger valgene dine for land og språk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‘Zichtbaar maken’ heeft voorrang op de regiofilters. ‘Verbergen’ houdt de categorie buiten de tv-gids. ‘Automatisch’ volgt je keuzes voor landen en talen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opcja Pokaż ma pierwszeństwo przed filtrowaniem regionalnym. Opcja Ukryj ukrywa kategorię w programie TV. Ustawienie Automatyczne uwzględnia wybrane kraje i języki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mostrar tem prioridade sobre os filtros de região. Ocultar mantém a categoria fora do guia de programação. Automático segue suas escolhas de países e idiomas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Afișează” are prioritate față de filtrarea regională. „Ascunde” exclude categoria din programul TV. „Automat” respectă țările și limbile alese."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«Показать» имеет приоритет над региональной фильтрацией. «Скрыть» убирает категорию из телепрограммы. «Автоматически» учитывает выбранные страны и языки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Zobraziť“ má prednosť pred regionálnym filtrovaním. „Skryť“ vynechá kategóriu z TV programu. „Automaticky“ sa riadi vaším výberom krajín a jazykov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Možnost »Prikaži« prevlada nad regionalnim filtriranjem. »Skrij« odstrani kategorijo iz TV-sporeda. »Samodejno« upošteva vaš izbor držav in jezikov."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Prikaži“ ima prednost nad regionalnim filtriranjem. „Sakrij“ izostavlja kategoriju iz TV programa. „Automatski“ prati vaš izbor zemalja i jezika."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "”Visa” åsidosätter regionfiltreringen. ”Dölj” håller kategorin utanför tv-tablån. ”Automatisk” följer dina val av länder och språk."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“แสดง” จะมีผลเหนือกว่าตัวกรองภูมิภาค “ซ่อน” จะนำหมวดหมู่ออกจากผังรายการ “อัตโนมัติ” จะทำตามประเทศและภาษาที่คุณเลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“Göster”, bölge filtrelemesini geçersiz kılar. “Gizle”, kategoriyi yayın akışının dışında tutar. “Otomatik”, ülke ve dil seçimlerinizi izler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«Показати» має пріоритет над регіональним фільтруванням. «Приховати» прибирає категорію з телепрограми. «Автоматично» враховує вибрані країни та мови."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“Hiện” được ưu tiên hơn bộ lọc khu vực. “Ẩn” loại danh mục khỏi lịch phát sóng. “Tự động” áp dụng lựa chọn quốc gia và ngôn ngữ của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“显示”优先于地区筛选。“隐藏”会将该类别从节目表中移除。“自动”遵循你选择的国家或地区和语言设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「顯示」優先於地區篩選。「隱藏」會將該類別從節目表中移除。「自動」依照你選擇的國家和語言。"
          }
        }
