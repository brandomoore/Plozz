    "Your lineup updates automatically as your authorized library changes. Find these channels in the guide, search and favorites." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُحدَّث قائمة قنواتك تلقائيًا مع تغيّر مكتبتك المصرّح بها. اعثر على هذه القنوات في الدليل والبحث والمفضلة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вашият списък с канали се обновява автоматично при промяна на разрешената ви медиатека. Ще намерите тези канали в програмата, търсенето и любимите."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La teva llista de canals s’actualitza automàticament quan canvia la biblioteca autoritzada. Troba aquests canals a la guia, la cerca i els preferits."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vaše nabídka se automaticky aktualizuje podle změn povolené knihovny. Tyto kanály najdete v programu, v sekci Hledat a v oblíbených."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dit kanaludvalg opdateres automatisk, når dit godkendte bibliotek ændres. Find kanalerne i guiden, søgningen og Favoritter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Kanalauswahl wird automatisch aktualisiert, wenn sich deine freigegebene Medienbibliothek ändert. Du findest diese Kanäle im Programm, in der Suche und in den Favoriten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η λίστα καναλιών σας ενημερώνεται αυτόματα καθώς αλλάζει η βιβλιοθήκη στην οποία έχετε πρόσβαση. Βρείτε αυτά τα κανάλια στον οδηγό, στην αναζήτηση και στα αγαπημένα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu lista de canales se actualiza automáticamente cuando cambia tu biblioteca autorizada. Encuentra estos canales en la guía, la búsqueda y Favoritos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "با تغییر کتابخانه مجاز شما، فهرست کانال‌ها به‌طور خودکار به‌روزرسانی می‌شود. این کانال‌ها را در راهنما، جست‌وجو و موارد دلخواه پیدا کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kanavavalikoimasi päivittyy automaattisesti sallitun kirjastosi muuttuessa. Löydät nämä kanavat ohjelmaoppaasta, hausta ja suosikeista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre sélection se met automatiquement à jour avec les changements de votre bibliothèque autorisée. Retrouvez ces chaînes dans le guide, la recherche et les favoris."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מערך הערוצים שלך מתעדכן אוטומטית כשהספרייה המורשית משתנה. אפשר למצוא את הערוצים האלה במדריך, בחיפוש ובמועדפים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपकी अधिकृत लाइब्रेरी बदलने पर आपकी लाइनअप अपने आप अपडेट होती है। इन चैनलों को गाइड, खोज और पसंदीदा में पाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vaša se ponuda automatski ažurira kako se mijenja odobrena knjižnica. Te kanale pronađite u vodiču, pretraživanju i omiljenima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A csatornakínálatod automatikusan frissül, amikor az engedélyezett médiatárad megváltozik. Ezeket a csatornákat a műsorújságban, a keresésben és a kedvencek között találod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Susunan saluran Anda diperbarui otomatis saat pustaka yang diizinkan berubah. Temukan saluran ini di panduan, pencarian, dan favorit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La tua lista canali si aggiorna automaticamente quando cambia la libreria autorizzata. Trova questi canali nella guida, nella ricerca e nei preferiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "許可されたライブラリの変更に合わせて、ラインナップが自動的に更新されます。これらのチャンネルは番組ガイド、検索、お気に入りから見つけられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "접근 권한이 있는 미디어 보관함에 변경 사항이 생기면 채널 구성도 자동으로 업데이트됩니다. 편성표, 검색 및 즐겨찾기에서 이 채널을 찾을 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Senarai saluran anda dikemas kini secara automatik apabila pustaka yang dibenarkan berubah. Cari saluran ini dalam panduan, carian dan kegemaran."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kanalutvalget oppdateres automatisk når biblioteket du har tilgang til, endres. Du finner kanalene i guiden, via søk og i Favoritter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je zenderaanbod wordt automatisch bijgewerkt wanneer je toegestane bibliotheek verandert. Vind deze zenders in de gids, zoekfunctie en Favorieten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zestaw kanałów aktualizuje się automatycznie wraz ze zmianami w bibliotece dostępnej dla Twojego profilu. Znajdziesz te kanały w przewodniku, wyszukiwaniu i ulubionych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sua grade é atualizada automaticamente conforme a biblioteca autorizada muda. Encontre esses canais no guia, na busca e nos favoritos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Grila ta se actualizează automat când biblioteca autorizată se modifică. Găsește aceste canale în ghid, căutare și favorite."
