    "Connect to Wi-Fi or Ethernet, or turn off “Stop without Wi-Fi or Ethernet” in Settings → Live TV." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اتصل بشبكة Wi-Fi أو Ethernet، أو عطّل «الإيقاف من دون Wi-Fi أو Ethernet» في الإعدادات ← البث التلفزيوني المباشر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Свържете се с Wi-Fi или Ethernet или изключете „Спиране без Wi-Fi или Ethernet“ в Настройки → Телевизия на живо."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Connecta’t a una xarxa Wi-Fi o Ethernet, o desactiva «Atura sense Wi-Fi ni Ethernet» a Configuració → TV en directe."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Připojte se k Wi-Fi nebo Ethernetu, případně v Nastavení → Živé vysílání vypněte „Zastavit bez Wi-Fi nebo Ethernetu“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opret forbindelse til Wi-Fi eller Ethernet, eller slå “Stop uden Wi-Fi eller Ethernet” fra under Indstillinger → Live-tv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
