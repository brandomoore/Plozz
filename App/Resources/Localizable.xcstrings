    "Only this profile is affected. Who you watch as sets whose watchlist it uses." : {
      "comment" : "Explains that the library and identity choices on this screen apply to the current profile alone.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
