        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kitaplık kestirmeleriniz yüklenemedi. Kayıtlı düzenleri değiştirilmedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не вдалося завантажити ярлики ваших медіатек. Їхнє збережене розташування не змінено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Không thể tải các lối tắt thư viện của bạn. Cách sắp xếp đã lưu không thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "无法加载您的媒体库快捷方式。已保存的排列未更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "無法載入你的媒體庫捷徑。已儲存的排列方式未變更。"
          }
        }
