    "Watching tunes the channel live, not this program from the beginning." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تبدأ المشاهدة البث المباشر للقناة، ولا تشغّل هذا البرنامج من بدايته."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Гледането включва канала на живо, а не това предаване отначало."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En mirar-lo, se sintonitza el canal en directe; aquest programa no es reprodueix des del principi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Při sledování se naladí živé vysílání kanálu; tento pořad se nespustí od začátku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Når du ser med, stilles der ind på kanalen live, ikke på dette program fra begyndelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beim Ansehen wird der Kanal live eingeschaltet, nicht diese Sendung von Anfang an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η παρακολούθηση ανοίγει τη ζωντανή μετάδοση του καναλιού και όχι αυτό το πρόγραμμα από την αρχή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al reproducir se sintoniza el canal en directo; el programa no comienza desde el principio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "با انتخاب تماشا، کانال را به‌صورت زنده دریافت می‌کنید؛ این برنامه از ابتدا پخش نمی‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Katselu avaa kanavan suoran lähetyksen eikä aloita tätä ohjelmaa alusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La lecture démarre sur le direct de la chaîne, et non au début de ce programme."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "התחלת צפייה מכוונת לשידור החי של הערוץ, ולא מפעילה את התוכנית הזו מההתחלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "देखना शुरू करने पर चैनल का लाइव प्रसारण चलेगा, यह प्रोग्राम शुरुआत से नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gledanje prebacuje kanal na prijenos uživo, a ne pokreće ovaj program od početka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A megtekintés a csatorna élő adására hangol, nem a műsor elejéről indítja a lejátszást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menonton akan menyetel kanal ke siaran langsung, bukan memutar program ini dari awal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
