    "Uses Home rows or Recommended, depending on where the row appears." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يستخدم إعدادات «صفوف الصفحة الرئيسية» أو «موصى به»، حسب موضع الصف."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Използва настройките на „Редове в Начало“ или „Препоръчани“ според мястото на реда."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilitza la configuració de «Files d'Inici» o de «Recomanats», segons on aparegui la fila."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Použije nastavení „Řádky Domů“ nebo „Doporučené“ podle toho, kde se řádek zobrazuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bruger indstillingerne for »Rækker på Hjem« eller »Anbefalet«, afhængigt af hvor rækken vises."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verwendet die Einstellungen für „Reihen auf ‚Start‘“ oder „Empfohlen“, je nachdem, wo die Reihe angezeigt wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Χρησιμοποιεί τις ρυθμίσεις «Γραμμές Αρχικής» ή «Προτεινόμενα», ανάλογα με το πού εμφανίζεται η γραμμή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa los ajustes de «Filas de Inicio» o «Recomendados», según dónde aparezca la fila."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بسته به محل نمایش سطر، از تنظیمات «سطرهای خانه» یا «پیشنهادها» استفاده می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Käyttää ”Kodin rivit” -asetusta tai ”Suositellut”-asetusta rivin sijainnin mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilise les réglages « Rangées de l’accueil » ou « Recommandations », selon l’emplacement de la rangée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "שימוש בהגדרות ״שורות מסך הבית״ או ״מומלצים״, בהתאם למיקום השורה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पंक्ति जहाँ दिखाई देती है, उसके अनुसार “होम पंक्तियाँ” या “सुझाव” की सेटिंग का उपयोग होता है."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koristi postavke „Redovi Početne” ili „Preporučeno”, ovisno o tome gdje se redak prikazuje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A sor helyétől függően a „Kezdőlap sorok” vagy az „Ajánlott” beállításait használja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menggunakan pengaturan Baris Beranda atau Rekomendasi, tergantung tempat baris ditampilkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa le impostazioni di «Righe di Home» o «Consigliati», in base a dove viene visualizzata la riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "行の表示場所に応じて、「ホームに表示する行」または「おすすめ」の設定を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "행이 표시되는 위치에 따라 홈 행 또는 추천 설정을 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
