    "Use account setup for large playlists, authentication, movies, and series. Your existing source and preferences are kept; disable this source after connecting to avoid duplicate channels." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "استخدم إعداد الحساب لقوائم التشغيل الكبيرة والمصادقة والأفلام والمسلسلات. سيُحتفظ بمصدرك الحالي وتفضيلاتك؛ عطّل هذا المصدر بعد الاتصال لتجنّب تكرار القنوات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Използвайте настройката на акаунт за големи плейлисти, удостоверяване, филми и сериали. Съществуващият ви източник и предпочитанията ви се запазват; деактивирайте този източник след свързването, за да избегнете дублиране на канали."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fes servir la configuració del compte per a llistes de reproducció grans, autenticació, pel·lícules i sèries. La font actual i les teves preferències es conserven; desactiva aquesta font després de connectar-hi per evitar canals duplicats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pro velké playlisty, ověřování přístupu, filmy a seriály použijte nastavení účtu. Stávající zdroj i předvolby zůstanou zachovány; po připojení tento zdroj deaktivujte, aby se kanály nezobrazovaly dvakrát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brug kontoopsætning til store afspilningslister, godkendelse, film og serier. Din eksisterende kilde og dine præferencer bevares; deaktiver denne kilde efter tilslutning for at undgå dublerede kanaler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nutze die Kontoeinrichtung für große Wiedergabelisten, Authentifizierung, Filme und Serien. Deine bestehende Quelle und deine Einstellungen bleiben erhalten; deaktiviere diese Quelle nach dem Verbinden, um doppelte Sender zu vermeiden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Χρησιμοποιήστε τη ρύθμιση λογαριασμού για μεγάλες λίστες αναπαραγωγής, έλεγχο ταυτότητας, ταινίες και σειρές. Η υπάρχουσα πηγή και οι προτιμήσεις σας διατηρούνται· απενεργοποιήστε αυτήν την πηγή μετά τη σύνδεση για να αποφύγετε διπλά κανάλια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utiliza la configuración de cuenta para listas de reproducción grandes, autenticación, películas y series. Se conservan tu fuente actual y tus preferencias; desactiva esta fuente después de conectarte para evitar canales duplicados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برای فهرست‌های پخش بزرگ، احراز هویت، فیلم‌ها و سریال‌ها از راه‌اندازی حساب استفاده کنید. منبع فعلی و ترجیحات شما حفظ می‌شوند؛ پس از اتصال، این منبع را غیرفعال کنید تا کانال‌های تکراری ایجاد نشوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Määritä tili suuria soittolistoja, tunnistautumista, elokuvia ja sarjoja varten. Nykyinen lähteesi ja asetuksesi säilyvät. Poista tämä lähde käytöstä yhdistämisen jälkeen, jotta kanavat eivät näy kahteen kertaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilisez la configuration de compte pour les grandes listes de lecture, l’authentification, les films et les séries. Votre source existante et vos préférences sont conservées ; désactivez cette source après la connexion pour éviter les chaînes en double."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לרשימות השמעה גדולות, לאימות זהות, לסרטים ולסדרות, יש להשתמש בהגדרת חשבון. המקור הקיים וההעדפות שלך נשמרים; יש להשבית מקור זה לאחר ההתחברות כדי למנוע ערוצים כפולים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बड़ी प्लेलिस्ट, प्रमाणीकरण, फ़िल्मों और सीरीज़ के लिए खाता सेटअप का इस्तेमाल करें। आपका मौजूदा स्रोत और प्राथमिकताएँ बनी रहेंगी; एक ही चैनल दो बार दिखने से बचने के लिए कनेक्ट करने के बाद इस स्रोत को बंद कर दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Za velike popise za reprodukciju, autentifikaciju, filmove i serije koristite postavljanje računa. Postojeći izvor i postavke ostaju sačuvani; nakon povezivanja onemogućite ovaj izvor kako biste izbjegli dvostruke kanale."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nagy lejátszási listákhoz, hitelesítéshez, filmekhez és sorozatokhoz használja a fiókbeállítást. Meglévő forrása és beállításai megmaradnak; csatlakozás után tiltsa le ezt a forrást, hogy a csatornák ne jelenjenek meg kétszer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gunakan penyiapan akun untuk daftar putar besar, autentikasi, film, dan serial. Sumber dan preferensi Anda yang ada tetap disimpan; nonaktifkan sumber ini setelah terhubung agar saluran tidak muncul dua kali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa la configurazione dell’account per playlist grandi, autenticazione, film e serie. La sorgente e le preferenze esistenti vengono mantenute; disattiva questa sorgente dopo la connessione per evitare canali duplicati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "大きなプレイリスト、認証、映画、シリーズにはアカウント設定をご利用ください。既存のソースと設定は保持されます。チャンネルの重複を避けるため、接続後にこのソースを無効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "대용량 재생목록, 인증, 영화 및 시리즈에는 계정 설정을 이용하세요. 기존 소스와 환경설정은 유지됩니다. 채널이 중복되지 않도록 연결 후 이 소스를 비활성화하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gunakan persediaan akaun untuk senarai main besar, pengesahan, filem dan siri. Sumber dan keutamaan sedia ada anda dikekalkan; nyahdayakan sumber ini selepas menyambung untuk mengelakkan saluran pendua."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bruk kontooppsett for store spillelister, autentisering, filmer og serier. Den eksisterende kilden og innstillingene dine beholdes. Deaktiver denne kilden etter tilkobling for å unngå dupliserte kanaler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gebruik de accountconfiguratie voor grote afspeellijsten, authenticatie, films en series. Je bestaande bron en voorkeuren blijven behouden. Schakel deze bron na het verbinden uit om dubbele zenders te voorkomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Użyj konfiguracji konta do obsługi dużych playlist, uwierzytelniania, filmów i seriali. Dotychczasowe źródło i preferencje zostaną zachowane. Po połączeniu wyłącz to źródło, aby uniknąć powielonych kanałów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Use a configuração de conta para playlists grandes, autenticação, filmes e séries. Sua fonte e suas preferências atuais são mantidas. Desative esta fonte após conectar para evitar canais duplicados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folosește configurarea contului pentru liste de redare mari, autentificare, filme și seriale. Sursa și preferințele existente se păstrează; dezactivează această sursă după conectare pentru a evita canalele duplicate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Для больших плейлистов, аутентификации, фильмов и сериалов используйте настройку учётной записи. Существующий источник и ваши настройки сохранятся; после подключения отключите этот источник, чтобы избежать повторяющихся каналов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pre veľké zoznamy prehrávania, prihlasovanie, filmy a seriály použite nastavenie účtu. Existujúci zdroj aj predvoľby sa zachovajú; po pripojení tento zdroj vypnite, aby sa kanály nezobrazovali duplicitne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Za velike sezname predvajanja, prijavo, filme in serije uporabite nastavitev računa. Obstoječi vir in nastavitve se ohranijo; po povezavi onemogočite ta vir, da preprečite podvojene kanale."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Za velike liste za reprodukciju, prijavljivanje, filmove i serije koristite podešavanje naloga. Postojeći izvor i podešavanja se čuvaju; nakon povezivanja isključite ovaj izvor da biste izbegli duplirane kanale."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Konfigurera ett konto för stora spellistor, autentisering, filmer och serier. Din befintliga källa och dina inställningar behålls; inaktivera den här källan efter anslutningen för att undvika dubbla kanaler."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ใช้การตั้งค่าบัญชีสำหรับเพลย์ลิสต์ขนาดใหญ่ การยืนยันตัวตน ภาพยนตร์ และซีรีส์ แหล่งที่มาและการตั้งค่าเดิมจะยังคงอยู่ ปิดใช้งานแหล่งนี้หลังจากเชื่อมต่อเพื่อหลีกเลี่ยงช่องซ้ำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Büyük oynatma listeleri, kimlik doğrulama, filmler ve diziler için hesap kurulumunu kullanın. Mevcut kaynağınız ve tercihleriniz korunur; yinelenen kanalları önlemek için bağlantı kurduktan sonra bu kaynağı devre dışı bırakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Використовуйте налаштування облікового запису для великих плейлистів, автентифікації, фільмів і серіалів. Наявне джерело та вподобання зберігаються; після підключення вимкніть це джерело, щоб уникнути дублювання каналів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sử dụng phần thiết lập tài khoản cho danh sách phát lớn, xác thực, phim và phim bộ. Nguồn và tùy chọn hiện có của bạn vẫn được giữ nguyên; hãy tắt nguồn này sau khi kết nối để tránh trùng kênh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "对于大型播放列表、身份验证、电影和剧集，请使用账户设置。现有来源和偏好设置会予以保留；连接后请停用此来源，以免出现重复频道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "若要使用大型播放清單、身分驗證、電影與影集，請使用帳號設定。現有來源與偏好設定都會保留；連線後請停用此來源，以免出現重複頻道。"
          }
        }
      }
    },
