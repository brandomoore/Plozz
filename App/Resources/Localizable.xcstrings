    "Looks up missing markers on IntroDB and TheIntroDB using IMDb/TMDB IDs." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يبحث في IntroDB وTheIntroDB عن العلامات غير الموجودة على خادمك باستخدام معرّفات IMDb/TMDB."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Търси липсващите на сървъра ви маркери в IntroDB и TheIntroDB чрез идентификатори от IMDb/TMDB."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cerca a IntroDB i TheIntroDB els marcadors que falten al teu servidor mitjançant els identificadors d’IMDb/TMDB."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vyhledává v IntroDB a TheIntroDB značky, které chybí na vašem serveru, pomocí ID IMDb/TMDB."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Søger på IntroDB og TheIntroDB efter markører, der mangler på din server, ved hjælp af IMDb/TMDB-id’er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sucht mithilfe von IMDb-/TMDB-IDs auf IntroDB und TheIntroDB nach Markierungen, die auf deinem Server fehlen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αναζητά στο IntroDB και στο TheIntroDB δείκτες που λείπουν από τον διακομιστή σας, χρησιμοποιώντας αναγνωριστικά IMDb/TMDB."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Busca en IntroDB y TheIntroDB los marcadores que faltan en tu servidor mediante los ID de IMDb/TMDB."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "با استفاده از شناسه‌های IMDb/TMDB، نشانگرهایی را که در سرور شما موجود نیستند، در IntroDB و TheIntroDB جست‌وجو می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Etsii palvelimeltasi puuttuvia merkintöjä IntroDB:stä ja TheIntroDB:stä IMDb-/TMDB-tunnisteiden avulla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Recherche sur IntroDB et TheIntroDB les marqueurs manquants sur votre serveur à l’aide des identifiants IMDb/TMDB."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מחפש ב־IntroDB וב־TheIntroDB סמנים שחסרים בשרת שלך באמצעות מזהי IMDb/TMDB."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "IMDb/TMDB आईडी का उपयोग करके आपके सर्वर पर मौजूद न होने वाले मार्कर IntroDB और TheIntroDB पर खोजता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na servisima IntroDB i TheIntroDB traži oznake koje nedostaju na vašem poslužitelju pomoću IMDb/TMDB identifikatora."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az IMDb/TMDB-azonosítók alapján az IntroDB és a TheIntroDB adatbázisában keresi a szerverről hiányzó jelölőket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mencari penanda yang tidak tersedia di server Anda melalui IntroDB dan TheIntroDB menggunakan ID IMDb/TMDB."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cerca su IntroDB e TheIntroDB i marcatori mancanti sul tuo server usando gli ID IMDb/TMDB."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "IMDb/TMDB IDを使い、サーバーにないマーカーをIntroDBとTheIntroDBで検索します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "IMDb/TMDB ID를 사용하여 서버에 없는 마커를 IntroDB와 TheIntroDB에서 검색합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mencari penanda yang tiada pada pelayan anda melalui IntroDB dan TheIntroDB menggunakan ID IMDb/TMDB."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
