          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "کانال‌های آن از راهنما حذف می‌شوند. تنظیمات کانال حفظ می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sen kanavat poistuvat ohjelmaoppaasta. Kanava-asetukset säilytetään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ses chaînes sont retirées du guide. Les préférences de chaînes sont conservées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הערוצים שלו יוסרו מהמדריך. העדפות הערוצים יישמרו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इसके चैनल गाइड से हट जाते हैं। चैनल प्राथमिकताएँ सुरक्षित रहती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Njegovi kanali nestat će iz vodiča. Postavke kanala bit će sačuvane."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A csatornái kikerülnek a műsorújságból. A csatornabeállítások megmaradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
