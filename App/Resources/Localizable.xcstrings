    "For HDR output, enable Match Dynamic Range or use an HDR video format in Apple TV settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لإخراج HDR، فعّل «مطابقة النطاق الديناميكي» أو استخدم تنسيق فيديو HDR في إعدادات Apple TV."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "За HDR изход включете „Съгласуване на динамичния диапазон“ или използвайте HDR видеоформат в настройките на Apple TV."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Per obtenir una sortida HDR, activa «Ajusta el rang dinàmic» o utilitza un format de vídeo HDR a la configuració de l'Apple TV."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pro výstup HDR zapněte přizpůsobení dynamického rozsahu nebo v nastavení Apple TV zvolte formát videa HDR."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aktivér Tilpas dynamisk område, eller brug et HDR-videoformat i indstillingerne på Apple TV for at få HDR-output."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aktiviere „Dynamikbereich anpassen“ oder verwende ein HDR-Videoformat in den Apple TV-Einstellungen, um HDR auszugeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Για έξοδο HDR, ενεργοποιήστε την αντιστοίχιση δυναμικού εύρους ή χρησιμοποιήστε μορφή βίντεο HDR στις ρυθμίσεις του Apple TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para obtener salida HDR, activa «Ajustar rango dinámico» o utiliza un formato de vídeo HDR en los ajustes del Apple TV."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برای خروجی HDR، تطبیق دامنهٔ پویا را فعال کنید یا در تنظیمات Apple TV از قالب ویدیوی HDR استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ota käyttöön dynaamisen alueen mukautus tai valitse HDR-videomuoto Apple TV:n asetuksista, jotta saat HDR-kuvan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pour une sortie HDR, activez « Adapter la plage dynamique » ou utilisez un format vidéo HDR dans les réglages de l’Apple TV."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לפלט HDR, יש להפעיל התאמת טווח דינמי או לבחור פורמט וידאו HDR בהגדרות Apple TV."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HDR आउटपुट के लिए Apple TV की सेटिंग्स में डायनैमिक रेंज का मिलान चालू करें या HDR वीडियो फ़ॉर्मैट चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Za HDR izlaz u postavkama uređaja Apple TV uključite usklađivanje dinamičkog raspona ili odaberite HDR videoformat."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A HDR-kimenethez kapcsolja be a dinamikatartomány egyeztetését, vagy válasszon HDR-videoformátumot az Apple TV beállításaiban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Untuk output HDR, aktifkan Cocokkan Rentang Dinamis atau gunakan format video HDR di pengaturan Apple TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Per l'uscita HDR, attiva Adatta all'intervallo dinamico oppure usa un formato video HDR nelle impostazioni di Apple TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HDR出力を使用するには、Apple TVの設定で「ダイナミックレンジに合わせる」をオンにするか、HDRのビデオフォーマットを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HDR로 출력하려면 Apple TV 설정에서 '다이내믹 레인지에 맞추기'를 켜거나 HDR 비디오 포맷을 사용하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Untuk output HDR, hidupkan Padankan Julat Dinamik atau gunakan format video HDR dalam seting Apple TV."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "For HDR-utdata slår du på Tilpass dynamisk område eller bruker et HDR-videoformat i innstillingene på Apple TV."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schakel voor HDR-uitvoer 'Pas dynamisch bereik aan' in of gebruik een HDR-videoformaat in de instellingen van Apple TV."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aby uzyskać obraz HDR, włącz opcję Dopasuj zakres dynamiczny lub wybierz format wideo HDR w ustawieniach Apple TV."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para exibir em HDR, ative Ajustar ao Intervalo Dinâmico ou use um formato de vídeo HDR nos ajustes da Apple TV."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pentru ieșire HDR, activează Potrivire interval dinamic sau folosește un format video HDR în configurările Apple TV."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Для вывода HDR включите «Согласование динамического диапазона» или выберите видеоформат HDR в настройках Apple TV."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pre výstup HDR zapnite prispôsobenie dynamického rozsahu alebo použite formát videa HDR v nastaveniach Apple TV."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Za izhod HDR v nastavitvah Apple TV omogočite prilagajanje dinamičnega razpona ali uporabite videoformat HDR."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Za HDR izlaz uključite usklađivanje dinamičkog opsega ili koristite HDR video-format u podešavanjima za Apple TV."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "För HDR-utmatning aktiverar du Matcha dynamiskt omfång eller använder ett HDR-videoformat i inställningarna för Apple TV."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "หากต้องการแสดงภาพแบบ HDR ให้เปิดการจับคู่ช่วงไดนามิก หรือใช้รูปแบบวิดีโอ HDR ในการตั้งค่า Apple TV"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HDR çıkışı için Apple TV ayarlarında Dinamik Aralıkla Eşle seçeneğini açın veya bir HDR video biçimi kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Для виведення HDR увімкніть узгодження динамічного діапазону або виберіть відеоформат HDR у параметрах Apple TV."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Để xuất hình HDR, hãy bật Khớp dải động hoặc dùng định dạng video HDR trong phần cài đặt Apple TV."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "要输出 HDR，请在 Apple TV 设置中开启“匹配动态范围”，或使用 HDR 视频格式。"
