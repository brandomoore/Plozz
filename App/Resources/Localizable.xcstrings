        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menyambung semula pada kedudukan semasa. Versi suntingan yang berbeza mungkin mempunyai pemasaan yang berbeza."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fortsetter fra gjeldende posisjon. Tidspunktene for de samme scenene kan variere mellom ulike klippeversjoner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hervat op de huidige positie. Bij verschillende montages kunnen dezelfde scènes op andere tijdstippen beginnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wznawia w bieżącym miejscu. Różne wersje montażowe mogą mieć inny przebieg czasowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Retoma na posição atual. Versões com montagens diferentes podem ter marcações de tempo distintas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reia redarea la poziția curentă. Versiunile cu montaj diferit pot avea timpi diferiți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Продолжает с текущей позиции. В разных монтажных версиях время сцен может отличаться."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pokračuje na aktuálnej pozícii. Rôzne zostrihy môžu mať odlišné časovanie."
          }
        },
        "sl" : {
          "stringUnit" : {
