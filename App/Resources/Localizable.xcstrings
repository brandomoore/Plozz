        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uključite opciju Deli izveštaje o rušenjima u odeljku Pomoć i dijagnostika da biste ovo omogućili. Vaša nedavna aktivnost se zatim šalje anonimno — bez prijava, tokena, servera ili naslova."
