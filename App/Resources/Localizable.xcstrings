    "Channels appear as each source loads. Guide listings follow without delaying playback." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تظهر القنوات عند تحميل كل مصدر. وتظهر قوائم الدليل لاحقًا من دون تأخير التشغيل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Каналите се показват при зареждането на всеки източник. Програмните записи се добавят след това, без да забавят възпроизвеждането."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Els canals apareixen a mesura que es carrega cada font. La programació de la guia arriba després sense retardar la reproducció."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kanály se zobrazují postupně při načítání jednotlivých zdrojů. Programové údaje se načtou následně, aniž by zdržovaly přehrávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kanaler vises, efterhånden som hver kilde indlæses. Programoversigterne følger uden at forsinke afspilningen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kanäle erscheinen, sobald die jeweilige Quelle geladen ist. Programmeinträge folgen, ohne die Wiedergabe zu verzögern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τα κανάλια εμφανίζονται καθώς φορτώνεται κάθε πηγή. Οι καταχωρίσεις οδηγού ακολουθούν χωρίς να καθυστερούν την αναπαραγωγή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los canales aparecen a medida que se carga cada fuente. La programación se añade después sin retrasar la reproducción."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "با بارگیری هر منبع، کانال‌های آن نمایش داده می‌شوند. فهرست برنامه‌ها سپس بارگیری می‌شود، بدون آنکه پخش به تأخیر بیفتد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kanavat tulevat näkyviin lähteiden latautuessa. Ohjelmaopastiedot lisätään myöhemmin toistoa viivyttämättä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les chaînes apparaissent à mesure que chaque source se charge. Les programmes du guide suivent sans retarder la lecture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הערוצים מופיעים עם טעינת כל מקור. רשומות המדריך מגיעות אחר כך בלי לעכב את ההפעלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हर स्रोत के लोड होते ही चैनल दिखाई देते हैं। गाइड सूचियाँ प्लेबैक में देरी किए बिना बाद में आती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kanali se pojavljuju kako se svaki izvor učitava. Podaci programskog vodiča učitavaju se potom, bez odgađanja reprodukcije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A csatornák az egyes források betöltésekor jelennek meg. A műsoradatok ezután, a lejátszás késleltetése nélkül érkeznek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Saluran muncul saat setiap sumber dimuat. Jadwal program menyusul tanpa menunda pemutaran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I canali compaiono man mano che ogni sorgente viene caricata. I programmi della guida arrivano in seguito senza ritardare la riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "各ソースの読み込みに合わせてチャンネルが表示されます。番組ガイドは再生を遅らせずに後から表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "각 소스를 불러오는 대로 채널이 표시됩니다. 편성표는 재생을 지연시키지 않고 이어서 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Saluran muncul apabila setiap sumber dimuatkan. Senarai rancangan menyusul tanpa melengahkan main balik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kanalene vises etter hvert som kildene lastes inn. Guideoppføringene følger uten å forsinke avspillingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zenders verschijnen zodra elke bron is geladen. Gidsgegevens volgen zonder het afspelen te vertragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kanały pojawiają się w miarę wczytywania źródeł. Program TV jest dodawany później, bez opóźniania odtwarzania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os canais aparecem conforme cada fonte é carregada. As listagens do guia vêm depois, sem atrasar a reprodução."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Canalele apar pe măsură ce se încarcă fiecare sursă. Programele din ghid apar ulterior, fără să întârzie redarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Каналы появляются по мере загрузки источников. Программа передач загружается следом, не задерживая воспроизведение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kanály sa zobrazujú postupne pri načítavaní jednotlivých zdrojov. Programové položky sa načítajú následne bez oneskorenia prehrávania."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kanali se prikažejo, ko se posamezni vir naloži. Vnosi sporeda sledijo brez zakasnitve predvajanja."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kanali se pojavljuju kako se učitava svaki izvor. Stavke vodiča stižu zatim, bez odlaganja reprodukcije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kanaler visas allt eftersom varje källa läses in. Tablåerna följer utan att fördröja uppspelningen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ช่องจะปรากฏเมื่อแต่ละแหล่งโหลดเสร็จ ข้อมูลผังรายการจะตามมาโดยไม่ทำให้การเล่นล่าช้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Her kaynak yüklendikçe kanallar görünür. Rehber bilgileri, oynatmayı geciktirmeden ardından yüklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Канали з’являються в міру завантаження кожного джерела. Телепрограма завантажується згодом, не затримуючи відтворення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Các kênh xuất hiện khi từng nguồn tải xong. Lịch phát sóng sẽ tải sau mà không làm chậm việc phát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "各来源加载后，频道会陆续显示。节目单随后加载，不会延迟播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每個來源載入後，頻道便會顯示。節目表隨後載入，不會延遲播放。"
