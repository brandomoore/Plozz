          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yksi PIN-koodi suojaa yhteiset asetukset ja lasten profiileista poistumisen. Ilman sitä nämä toiminnot ovat edelleen käytettävissä."
          }
        },
        "fr" : {
          "stringUnit" : {
