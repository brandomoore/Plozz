        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nämä otsakkeet koskevat vain ohjelmaoppaan ensimmäisen URL-osoitteen palvelinta. Jätä ne tyhjiksi, jos ohjelmaopas käyttää soittolistasi kirjautumistietoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ces en-têtes s’appliquent uniquement au serveur de la première URL du guide des programmes. Laissez-les vides si le guide utilise les identifiants de votre liste de lecture."
          }
