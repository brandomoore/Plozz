            "value" : "Trên thiết bị bạn muốn thiết lập, mở Plozz và chọn “Thiết lập từ thiết bị khác.” Thiết bị sẽ xuất hiện tại đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
