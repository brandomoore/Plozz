    "Favorites stay saved while their source is unavailable or disabled. A similar name never replaces a saved channel." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تبقى المفضلة محفوظة عندما يكون مصدرها غير متاح أو معطلاً. لا تُستبدل قناة محفوظة بأخرى لمجرد تشابه الاسم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Любимите остават запазени, докато източникът им не е наличен или е изключен. Подобно име никога не заменя запазен канал."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Els preferits es conserven encara que la seva font no estigui disponible o estigui desactivada. Un nom semblant mai no substitueix un canal desat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oblíbené položky zůstávají uložené, i když je jejich zdroj nedostupný nebo zakázaný. Uložený kanál nikdy nenahradí jiný s podobným názvem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Favoritter forbliver gemt, mens deres kilde er utilgængelig eller deaktiveret. Et lignende navn erstatter aldrig en gemt kanal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Favoriten bleiben gespeichert, wenn ihre Quelle nicht verfügbar oder deaktiviert ist. Ein ähnlicher Name ersetzt niemals einen gespeicherten Kanal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τα Αγαπημένα παραμένουν αποθηκευμένα όσο η πηγή τους δεν είναι διαθέσιμη ή είναι απενεργοποιημένη. Ένα παρόμοιο όνομα δεν αντικαθιστά ποτέ ένα αποθηκευμένο κανάλι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los Favoritos se conservan aunque su fuente no esté disponible o esté desactivada. Un nombre parecido nunca sustituye a un canal guardado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وقتی منبع کانال‌ها در دسترس نیست یا غیرفعال است، موارد دلخواه ذخیره می‌مانند. نام مشابه هرگز جای یک کانال ذخیره‌شده را نمی‌گیرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Suosikit säilyvät tallennettuina, vaikka niiden lähde ei olisi saatavilla tai käytössä. Samankaltainen nimi ei koskaan korvaa tallennettua kanavaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les favoris restent enregistrés lorsque leur source est indisponible ou désactivée. Un nom similaire ne remplace jamais une chaîne enregistrée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "המועדפים נשארים שמורים כשהמקור שלהם אינו זמין או מושבת. שם דומה לעולם אינו מחליף ערוץ שמור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्रोत अनुपलब्ध या बंद होने पर भी पसंदीदा सहेजे रहते हैं। मिलता-जुलता नाम कभी सहेजे गए चैनल की जगह नहीं लेता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Omiljeni kanali ostaju spremljeni dok je njihov izvor nedostupan ili onemogućen. Kanal sličnog naziva nikada ne zamjenjuje spremljeni kanal."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A kedvencek akkor is mentve maradnak, ha a forrásuk nem érhető el vagy le van tiltva. Hasonló nevű csatorna soha nem cseréli le a mentettet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Favorit tetap tersimpan saat sumbernya tidak tersedia atau dinonaktifkan. Nama yang mirip tidak pernah menggantikan saluran tersimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I preferiti restano salvati anche quando la loro sorgente non è disponibile o è disabilitata. Un nome simile non sostituisce mai un canale salvato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ソースが利用できない場合や無効な場合も、お気に入りは保存されたままです。似た名前のチャンネルが保存済みチャンネルを置き換えることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "소스를 사용할 수 없거나 비활성화해도 즐겨찾기는 저장된 상태로 유지됩니다. 이름이 비슷한 채널로 저장된 채널을 대체하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kegemaran kekal disimpan semasa sumbernya tidak tersedia atau dilumpuhkan. Nama yang serupa tidak akan menggantikan saluran yang disimpan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Favoritter forblir lagret mens kilden er utilgjengelig eller deaktivert. Et lignende navn erstatter aldri en lagret kanal."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Favorieten blijven opgeslagen wanneer hun bron niet beschikbaar of uitgeschakeld is. Een vergelijkbare naam vervangt nooit een opgeslagen zender."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ulubione pozostają zapisane, gdy ich źródło jest niedostępne lub wyłączone. Podobna nazwa nigdy nie zastępuje zapisanego kanału."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os favoritos continuam salvos enquanto sua fonte está indisponível ou desativada. Um nome parecido nunca substitui um canal salvo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Favoritele rămân salvate cât timp sursa lor este indisponibilă sau dezactivată. Un nume asemănător nu înlocuiește niciodată un canal salvat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Избранное сохраняется, пока источник недоступен или выключен. Канал с похожим названием никогда не заменяет сохранённый."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Obľúbené zostanú uložené, aj keď je ich zdroj nedostupný alebo vypnutý. Podobný názov nikdy nenahradí uložený kanál."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Priljubljeni kanali ostanejo shranjeni, ko njihov vir ni na voljo ali je onemogočen. Podobno ime nikoli ne nadomesti shranjenega kanala."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Omiljeni ostaju sačuvani dok je njihov izvor nedostupan ili isključen. Sličan naziv nikada ne zamenjuje sačuvani kanal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Favoriter förblir sparade när deras källa är otillgänglig eller inaktiverad. Ett liknande namn ersätter aldrig en sparad kanal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "รายการโปรดยังคงถูกบันทึกไว้ขณะที่แหล่งที่มาใช้ไม่ได้หรือถูกปิดใช้ ชื่อที่คล้ายกันจะไม่แทนที่ช่องที่บันทึกไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kaynakları kullanılamadığında veya devre dışı bırakıldığında favoriler kayıtlı kalır. Benzer bir ad, kayıtlı bir kanalın yerini hiçbir zaman almaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Обране залишається збереженим, поки його джерело недоступне або вимкнене. Канал зі схожою назвою ніколи не замінює збережений канал."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mục yêu thích vẫn được lưu khi nguồn không khả dụng hoặc bị tắt. Một tên tương tự sẽ không bao giờ thay thế kênh đã lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "来源不可用或停用时，收藏仍会保留。名称相似的频道绝不会替换已保存的频道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "來源無法使用或已停用時，喜好項目仍會保留。名稱相似的頻道絕不會取代已儲存的頻道。"
          }
        }
      }
    },
