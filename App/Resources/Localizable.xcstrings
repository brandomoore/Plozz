    "Labels are hidden below Continue Watching artwork." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا تظهر التسميات أسفل صور «متابعة المشاهدة»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Надписите под обложките в „Продължете да гледате“ са скрити."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Els textos sota les imatges de «Continua mirant» estan ocults."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Popisky pod obrázky v řádku „Pokračovat ve sledování“ jsou skryté."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Teksterne under billederne i »Se videre« er skjult."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beschriftungen unter den Bildern in „Weiterschauen“ sind ausgeblendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι λεζάντες δεν εμφανίζονται κάτω από τις εικόνες στη «Συνέχεια παρακολούθησης»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los rótulos no se muestran debajo de las imágenes de «Seguir viendo»."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نوشته‌ها زیر تصاویر «ادامهٔ تماشا» نمایش داده نمی‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tekstejä ei näytetä ”Jatka katsomista” -kuvien alla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les libellés sont masqués sous les visuels de « Reprendre la lecture »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הכיתובים אינם מוצגים מתחת לתמונות של ״המשך צפייה״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“देखना जारी रखें” के आर्टवर्क के नीचे लेबल छिपे रहते हैं."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oznake su skrivene ispod grafike u retku „Nastavi gledati”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A címkék nem jelennek meg a „Megtekintés folytatása” sor borítóképei alatt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Label di bawah gambar Lanjutkan Menonton tidak ditampilkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le etichette sono nascoste sotto le copertine di «Continua a guardare»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「続きを観る」のアートワークの下にラベルを表示しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "시청 중인 콘텐츠 아트워크 아래의 레이블이 숨겨집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Label di bawah karya seni Teruskan Menonton disembunyikan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Etikettene under bildene i Se videre er skjult."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De labels onder de afbeeldingen in Verder kijken zijn verborgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podpisy pod grafiką w sekcji Oglądaj dalej są ukryte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os rótulos ficam ocultos abaixo da arte em Continuar assistindo."
          }
        },
