    "iCloud Keychain logins and Trakt's shared sign-in records are stored separately and are not included." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُخزّن بيانات تسجيل الدخول في سلسلة مفاتيح iCloud وسجلات تسجيل الدخول المشتركة لخدمة Trakt بشكل منفصل، ولا تُحتسب هنا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Данните за вход в iCloud Keychain и споделените записи за вход в Trakt се съхраняват отделно и не са включени."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les credencials d’accés del clauer de l’iCloud i els registres compartits d’inici de sessió de Trakt es desen per separat i no s’hi inclouen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Přihlašovací údaje v Klíčence na iCloudu a sdílené záznamy přihlášení služby Trakt se ukládají odděleně a nejsou zahrnuty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Loginoplysninger i iCloud-nøglering og Trakts delte loginposter gemmes separat og er ikke medregnet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anmeldedaten im iCloud-Schlüsselbund und die gemeinsam genutzten Anmeldedatensätze von Trakt werden separat gespeichert und sind nicht enthalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τα στοιχεία σύνδεσης της Κλειδοθήκης iCloud και οι κοινόχρηστες εγγραφές σύνδεσης του Trakt αποθηκεύονται ξεχωριστά και δεν περιλαμβάνονται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las credenciales del Llavero de iCloud y los registros de inicio de sesión compartidos de Trakt se almacenan por separado y no se incluyen."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اطلاعات ورود در iCloud Keychain و رکوردهای ورود مشترک Trakt جداگانه ذخیره می‌شوند و در این محاسبات لحاظ نشده‌اند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iCloud-avainnipun kirjautumistiedot ja Traktin jaetut kirjautumistietueet tallennetaan erikseen, eivätkä ne sisälly näihin lukuihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les identifiants du Trousseau iCloud et les enregistrements de connexion partagés de Trakt sont stockés séparément et ne sont pas inclus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "פרטי ההתחברות בצרור המפתחות של iCloud ורשומות ההתחברות המשותפות של Trakt נשמרים בנפרד ואינם נכללים כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iCloud कीचेन के लॉगिन और Trakt के साझा साइन-इन रिकॉर्ड अलग से सहेजे जाते हैं और इनमें शामिल नहीं हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podaci za prijavu u iCloud privjesku ključeva i zajednički zapisi prijave za Trakt pohranjuju se zasebno i nisu uključeni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az iCloud-kulcskarikában tárolt bejelentkezési adatok és a Trakt megosztott bejelentkezési rekordjai külön tárolódnak, és nem szerepelnek az összesítésben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Informasi login Rantai Kunci iCloud dan catatan login bersama Trakt disimpan secara terpisah dan tidak disertakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le credenziali del Portachiavi iCloud e i record di accesso condivisi di Trakt sono archiviati separatamente e non sono inclusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iCloudキーチェーンのログイン情報とTraktの共有ログイン記録は別に保存されているため、含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iCloud 키체인의 로그인 정보와 Trakt의 공유 로그인 레코드는 별도로 저장되며 여기에 포함되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maklumat log masuk Rantai Kunci iCloud dan rekod log masuk Trakt yang dikongsi disimpan secara berasingan dan tidak disertakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pålogginger i iCloud-nøkkelringen og Trakts delte påloggingsposter lagres separat og er ikke inkludert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aanmeldgegevens in de iCloud-sleutelhanger en de gedeelde aanmeldrecords van Trakt worden apart opgeslagen en zijn niet inbegrepen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dane logowania w pęku kluczy iCloud i współdzielone rekordy logowania Trakt są przechowywane osobno i nie są uwzględnione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os dados de acesso das Chaves do iCloud e os registros de login compartilhados do Trakt são armazenados separadamente e não estão incluídos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Datele de autentificare din Portchei iCloud și înregistrările de autentificare Trakt partajate sunt stocate separat și nu sunt incluse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Данные входа из Связки ключей iCloud и общие записи входа Trakt хранятся отдельно и здесь не учитываются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prihlasovacie údaje z iCloud Kľúčenky a zdieľané prihlasovacie záznamy služby Trakt sa ukladajú samostatne a nie sú zahrnuté."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prijavni podatki v obesku za ključe iCloud in skupni prijavni zapisi storitve Trakt so shranjeni ločeno in niso vključeni."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podaci za prijavu u iCloud Keychain-u i deljeni zapisi za prijavu na Trakt čuvaju se odvojeno i nisu uključeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inloggningar i iCloud-nyckelringen och Trakts delade inloggningsposter lagras separat och ingår inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ข้อมูลเข้าสู่ระบบในพวงกุญแจ iCloud และระเบียนการลงชื่อเข้าใช้ที่ใช้ร่วมกันของ Trakt จะจัดเก็บแยกต่างหากและไม่รวมอยู่ในข้อมูลนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iCloud Anahtar Zinciri’ndeki giriş bilgileri ve Trakt’ın paylaşılan oturum açma kayıtları ayrı saklanır ve bu döküme dahil değildir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Дані входу у В’язці iCloud та спільні записи входу Trakt зберігаються окремо й не враховуються в цьому огляді."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Thông tin đăng nhập trong Chuỗi khóa iCloud và các bản ghi đăng nhập dùng chung của Trakt được lưu riêng và không được tính trong bảng này."
          }
        },
