    "Turn off sync on other devices first so they don't upload their data again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أوقف المزامنة على الأجهزة الأخرى أولًا حتى لا ترفع بياناتها مجددًا."
