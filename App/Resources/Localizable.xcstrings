        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "चलाए जा सकने वाले लिंक चुने गए ऐप के साथ साझा किए जाते हैं। ज़रूरत पड़ने पर इनमें सर्वर के ऐक्सेस टोकन भी शामिल होते हैं। केवल भरोसेमंद ऐप चुनें।"
