        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Poveznice za reprodukciju dijele se s odabranom aplikacijom, uključujući pristupne tokene za poslužitelj kad su potrebni. Odaberite samo aplikaciju kojoj vjerujete."
