    "System prompts and the player's own on-screen controls follow the Apple TV's language, not this setting." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الرسائل النظامية وعناصر التحكم على الشاشة في المشغل تتبع لغة Apple TV وليس هذا الإعداد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Системните подкани и екранните контроли на плейъра използват езика на Apple TV, а не тази настройка."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Els missatges del sistema i els controls en pantalla propis del reproductor segueixen l'idioma de l'Apple TV, no aquesta configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Systémové výzvy a vlastní ovládací prvky přehrávače na obrazovce se řídí jazykem Apple TV, ne tímto nastavením."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Systembeskeder og afspillerens egne betjeningselementer følger Apple TV’ets sprog, ikke denne indstilling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Systemdialoge und die Bedienelemente des Players folgen der Sprache des Apple TV, nicht dieser Einstellung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι προτροπές συστήματος και τα ενσωματωμένα χειριστήρια στην οθόνη του αναπαραγωγέα ακολουθούν τη γλώσσα του Apple TV, όχι αυτή τη ρύθμιση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los mensajes del sistema y los controles en pantalla del reproductor siguen el idioma del Apple TV, no este ajuste."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پیام‌های سیستم و کنترل‌های صفحه‌ای پخش‌کننده به زبان Apple TV دنبال می‌شوند، نه این تنظیم."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Järjestelmän kehotteet ja soittimen omat näyttösäätimet noudattavat Apple TV:n kieltä, eivät tätä asetusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les invites système et les commandes à l’écran du lecteur suivent la langue de l’Apple TV, pas ce réglage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הודעות המערכת ופקדי הנגן שעל המסך פועלים לפי השפה של ה-Apple TV, לא לפי ההגדרה הזו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सिस्टम प्रॉम्प्ट और प्लेयर के अपने ऑन-स्क्रीन कंट्रोल इस सेटिंग के बजाय Apple TV की भाषा का पालन करते हैं."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sustavni upiti i vlastite kontrole reproduktora na zaslonu prate jezik Apple TV-a, a ne ovu postavku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A rendszerfelhasználói üzenetek és a lejátszó saját képernyőeszközei követik az Apple TV nyelvét, nem ezt a beállítást."
          }
        },
        "id" : {
          "stringUnit" : {
