    "This library is too large to index safely on this device. Use a server-supported filter or sort." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هذه المكتبة كبيرة جدًا بحيث لا يمكن فهرستها بأمان على هذا الجهاز. استخدم خيار تصفية أو فرز يدعمه الخادم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тази медиатека е твърде голяма за безопасно индексиране на това устройство. Използвайте опция за филтриране или сортиране, която се поддържа от сървъра."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aquesta biblioteca és massa gran per indexar-la de manera segura en aquest dispositiu. Fes servir un filtre o una opció d'ordenació que el servidor pugui executar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tato knihovna je příliš velká na bezpečné indexování v tomto zařízení. Použijte filtr nebo řazení podporované serverem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dette bibliotek er for stort til at blive indekseret sikkert på denne enhed. Brug et filter eller en sortering, som serveren understøtter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diese Medienbibliothek ist zu groß, um sie auf diesem Gerät sicher zu indexieren. Verwende einen Filter oder eine Sortierung, die vom Server unterstützt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αυτή η βιβλιοθήκη είναι πολύ μεγάλη για να δημιουργηθεί ευρετήριο με ασφάλεια σε αυτή τη συσκευή. Χρησιμοποιήστε φίλτρο ή ταξινόμηση που υποστηρίζεται από τον διακομιστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta biblioteca multimedia es demasiado grande para indexarla de forma segura en este dispositivo. Usa un filtro o una opción de ordenación que admita el servidor."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "این کتابخانه برای نمایه‌سازی ایمن روی این دستگاه بیش از حد بزرگ است. از فیلتر یا روش مرتب‌سازی پشتیبانی‌شده توسط سرور استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tämä kirjasto on liian suuri indeksoitavaksi turvallisesti tällä laitteella. Käytä palvelimen tukemaa suodatinta tai lajittelua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cette bibliothèque est trop volumineuse pour être indexée sans risque sur cet appareil. Utilisez un filtre ou un tri pris en charge par le serveur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הספרייה הזו גדולה מדי ליצירת אינדקס באופן בטוח במכשיר הזה. יש להשתמש במסנן או במיון שנתמכים על ידי השרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यह लाइब्रेरी इतनी बड़ी है कि इस डिवाइस पर सुरक्षित रूप से इसका इंडेक्स नहीं बनाया जा सकता. सर्वर द्वारा समर्थित फ़िल्टर या क्रमबद्ध करने के विकल्प का इस्तेमाल करें."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ova je knjižnica prevelika za sigurno indeksiranje na ovom uređaju. Upotrijebite filtar ili način sortiranja koji podržava poslužitelj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ez a könyvtár túl nagy ahhoz, hogy biztonságosan indexelhető legyen ezen az eszközön. Használj a szerver által támogatott szűrést vagy rendezést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pustaka ini terlalu besar untuk diindeks dengan aman di perangkat ini. Gunakan filter atau pengurutan yang didukung server."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Questa libreria è troppo grande per essere indicizzata in sicurezza su questo dispositivo. Usa un filtro o un ordinamento supportato dal server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このライブラリは大きすぎるため、このデバイスでは安全にインデックスを作成できません。サーバーが対応しているフィルターまたは並べ替えを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 미디어 보관함은 너무 커서 이 기기에서 안전하게 색인을 만들 수 없습니다. 서버에서 지원하는 필터 또는 정렬을 사용해 주세요."
          }
        },
        "ms" : {
