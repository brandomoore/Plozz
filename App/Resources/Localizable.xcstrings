          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اتصال در Plozz قطع شد. WeTrakr نتوانست نشست را باطل کند؛ Plozz را از برنامه‌های متصل خود در WeTrakr حذف کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
