        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "V Apple TV-ju, iPadu ali drugi napravi odprite Plozz in izberite »Nastavi iz druge naprave.« Prikazana bo tukaj — tapnite jo za prijavo. Obe napravi morata biti v istem omrežju Wi-Fi."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na Apple TV-u, iPad-u ili drugom uređaju otvorite Plozz i izaberite „Podesi sa drugog uređaja“. Pojaviće se ovde — dodirnite ga da biste ga prijavili. Oba uređaja moraju biti na istoj Wi-Fi mreži."
          }
