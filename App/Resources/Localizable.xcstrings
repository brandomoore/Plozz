    "Hidden by a channel scan. Review scan results in Sources." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أُخفيت نتيجة مسح القنوات. راجع نتائج المسح في «المصادر»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скрит при сканиране на каналите. Прегледайте резултатите от сканирането в „Източници“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ocult per un escaneig de canals. Revisa els resultats de l'escaneig a «Fonts»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skryto při skenování kanálů. Výsledky skenování najdete v části „Zdroje“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skjult af en kanalscanning. Gennemgå scanningsresultaterne under „Kilder“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Durch einen Kanalscan ausgeblendet. Überprüfe die Scanergebnisse unter „Quellen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Κρυφό λόγω σάρωσης καναλιών. Ελέγξτε τα αποτελέσματα σάρωσης στις «Πηγές»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oculto por un análisis de canales. Revisa los resultados del análisis en Fuentes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "در نتیجهٔ اسکن کانال‌ها پنهان شده است. نتایج اسکن را در «منابع» بررسی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
