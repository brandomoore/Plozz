    "Show a Skip button, or skip automatically, during intros, credits, recaps, previews and commercials." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "إظهار زر «تخطي»، أو التخطي تلقائيًا، أثناء المقدمات وشارات النهاية والخلاصات والمعاينات والإعلانات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Показване на бутон „Пропуск“ или автоматично пропускане по време на интро, финални надписи, резюмета, анонси и реклами."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mostra un botó «Omet», o omet automàticament, durant les introduccions, els crèdits, els resums, els avanços i els anuncis."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Během úvodů, závěrečných titulků, shrnutí, ukázek a reklam zobrazit tlačítko Přeskočit nebo přeskakovat automaticky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vis knappen Spring over, eller spring automatisk over, under introer, rulletekster, opsummeringer, forhåndsvisninger og reklamer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bei Intros, Abspann, Rückblicken, Vorschauen und Werbung eine Schaltfläche „Überspringen“ anzeigen oder automatisch überspringen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Εμφάνιση κουμπιού «Παράλειψη» ή αυτόματη παράλειψη κατά τις εισαγωγές, τους τίτλους τέλους, τις περιλήψεις, τις προεπισκοπήσεις και τις διαφημίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Muestra un botón Saltar o salta automáticamente durante intros, créditos, resúmenes, vistas previas y anuncios."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نمایش دکمه‌ی «پرش» یا پرش خودکار هنگام مقدمه‌ها، تیتراژهای پایانی، خلاصه‌ها، پیش‌نمایش‌ها و تبلیغات."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Näytä Ohita-painike tai ohita automaattisesti alkutunnusten, lopputekstien, kertausten, ennakkojen ja mainosten aikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Affiche un bouton Passer ou passe automatiquement les intros, les génériques, les récapitulatifs, les aperçus et les publicités."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הצג כפתור \"דלג\" או דלג אוטומטית במהלך פתיחים, קרדיטים, תקצירים, תצוגות מקדימות ופרסומות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इंट्रो, क्रेडिट, रीकैप, प्रीव्यू और विज्ञापनों के दौरान स्किप बटन दिखाएं या अपने आप स्किप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prikaži gumb Preskoči ili automatski preskoči tijekom uvoda, odjavnih špica, sažetaka, najava i reklama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kihagyás gomb megjelenítése vagy automatikus kihagyás intrók, stáblisták, összefoglalók, előnézetek és reklámok alatt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tampilkan tombol Lewati, atau lewati secara otomatis, selama intro, kredit, rekap, pratinjau, dan iklan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mostra un pulsante Salta, o salta automaticamente, durante intro, titoli di coda, riassunti, anteprime e pubblicità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "イントロ、クレジット、あらすじ、プレビュー、CMの間に「スキップ」ボタンを表示するか、自動でスキップします。"
          }
        },
        "ko" : {
