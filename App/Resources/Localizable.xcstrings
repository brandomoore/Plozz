    "Discover movies and shows from your selected feeds. Seerr is optional for requests." : {
      "comment" : "Explanation shown under the Featured hero source option in Settings.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
