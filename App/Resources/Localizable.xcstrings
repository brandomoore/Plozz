    "Check the address, guide URL, and authentication fields. Header names must be unique." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تحقق من العنوان وعنوان URL لدليل البرامج وحقول المصادقة. يجب ألا تتكرر أسماء الترويسات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Проверете адреса, URL на ТВ програмата и полетата за удостоверяване. Имената на заглавките трябва да са уникални."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comprova l'adreça, l'URL de la guia de programes i els camps d'autenticació. Els noms de les capçaleres han de ser únics."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zkontrolujte adresu, URL programového průvodce a pole pro autentizaci. Názvy hlaviček musí být jedinečné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kontrollér adressen, programguidens URL og godkendelsesfelterne. Headernavne skal være unikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prüfe die Adresse, die URL der Programmübersicht und die Authentifizierungsfelder. Header-Namen müssen eindeutig sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ελέγξτε τη διεύθυνση, το URL του οδηγού προγράμματος και τα πεδία ελέγχου ταυτότητας. Τα ονόματα των κεφαλίδων πρέπει να είναι μοναδικά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comprueba la dirección, la URL de la guía de programación y los campos de autenticación. Los nombres de las cabeceras deben ser únicos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نشانی، URL راهنمای برنامه‌ها و فیلدهای احراز هویت را بررسی کنید. نام سرآیندها باید یکتا باشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tarkista osoite, ohjelmaoppaan URL ja tunnistautumiskentät. Otsakkeiden nimien on oltava yksilöllisiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vérifiez l’adresse, l’URL du guide des programmes et les champs d’authentification. Les noms des en-têtes doivent être uniques."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "יש לבדוק את הכתובת, את כתובת ה-URL של לוח השידורים ואת שדות האימות. שמות כותרות ה-HTTP חייבים להיות ייחודיים."
