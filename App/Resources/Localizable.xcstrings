        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Попросите родителя разрешить ваши источники IPTV. Одно разрешение действует для всех каналов источника."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Požiadajte rodiča, aby schválil vaše zdroje IPTV. Jedno schválenie platí pre všetky kanály v zdroji."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prosite starša, naj odobri vaše vire IPTV. Ena odobritev velja za vse kanale v viru."
