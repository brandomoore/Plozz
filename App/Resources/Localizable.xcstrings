    "Syncs profiles, settings, and servers. Logins stay on each device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يزامن الملفات الشخصية والإعدادات والخوادم. تبقى بيانات الدخول على كل جهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Синхронизира профилите, настройките и сървърите. Данните за вход остават на всяко устройство."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sincronitza els perfils, la configuració i els servidors. Les credencials es mantenen a cada dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Synchronizuje profily, nastavení a servery. Přihlašovací údaje zůstávají na každém zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Synkroniserer profiler, indstillinger og servere. Logins forbliver på hver enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Synchronisiert Profile, Einstellungen und Server. Anmeldedaten bleiben auf jedem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Συγχρονίζει προφίλ, ρυθμίσεις και διακομιστές. Τα στοιχεία σύνδεσης παραμένουν σε κάθε συσκευή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sincroniza perfiles, ajustes y servidores. Los inicios de sesión se quedan en cada dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نمایه‌ها، تنظیمات و سرورها را همگام‌سازی می‌کند. اطلاعات ورود هر دستگاه روی خودش می‌ماند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Synkronoi profiilit, asetukset ja palvelimet. Kirjautumistiedot pysyvät laitekohtaisina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Synchronise les profils, réglages et serveurs. Les identifiants restent sur chaque appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מסנכרן פרופילים, הגדרות ושרתים. פרטי ההתחברות נשארים בכל מכשיר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "प्रोफ़ाइल, सेटिंग्स और सर्वर सिंक होते हैं। लॉगिन हर डिवाइस पर ही रहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sinkronizira profile, postavke i poslužitelje. Prijave ostaju privatne na svakom uređaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Szinkronizálja a profilokat, a beállításokat és a szervereket. A bejelentkezések eszközönként külön maradnak."
          }
        },
        "id" : {
          "stringUnit" : {
