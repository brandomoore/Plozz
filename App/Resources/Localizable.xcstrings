            "value" : "Pintasan pustaka anda tidak dapat dimuatkan. Susunan yang disimpan tidak berubah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kunne ikke laste inn biblioteksnarveiene dine. Det lagrede oppsettet er uendret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je bibliotheeksnelkoppelingen konden niet worden geladen. De opgeslagen rangschikking is ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie udało się wczytać skrótów do bibliotek. Ich zapisany układ nie został zmieniony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Não foi possível carregar os atalhos das suas bibliotecas. A organização salva não foi alterada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scurtăturile bibliotecilor tale nu au putut fi încărcate. Aranjarea lor salvată nu s-a modificat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не удалось загрузить ярлыки медиатек. Сохранённые порядок и видимость не изменены."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odkazy na vaše knižnice sa nepodarilo načítať. Ich uložené usporiadanie sa nezmenilo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bližnjic vaših knjižnic ni bilo mogoče naložiti. Njihova shranjena razporeditev je nespremenjena."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
