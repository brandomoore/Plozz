          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Återanvänd den valda versionstypen för senare avsnitt. Vid automatiskt val används den bästa tillgängliga versionen om den typen saknas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ใช้ประเภทเวอร์ชันที่คุณเลือกกับตอนถัดไปด้วย เมื่อเลือกอัตโนมัติ ให้ใช้เวอร์ชันที่ดีที่สุดที่มีอยู่หากไม่มีประเภทนั้น"
