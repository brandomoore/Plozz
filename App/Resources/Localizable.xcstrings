    "Large libraries may take a few minutes. You can cancel at any time." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قد تستغرق المكتبات الكبيرة بضع دقائق. يمكنك الإلغاء في أي وقت."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Обработката на големи библиотеки може да отнеме няколко минути. Можете да отмените по всяко време."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les biblioteques grans poden trigar uns minuts. Pots cancel·lar en qualsevol moment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zpracování velkých knihoven může trvat několik minut. Akci můžete kdykoli zrušit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Store biblioteker kan tage et par minutter. Du kan annullere når som helst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bei großen Mediatheken kann es einige Minuten dauern. Du kannst jederzeit abbrechen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι μεγάλες βιβλιοθήκες μπορεί να χρειαστούν λίγα λεπτά. Μπορείτε να ακυρώσετε ανά πάσα στιγμή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las bibliotecas grandes pueden tardar unos minutos. Puedes cancelar en cualquier momento."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پردازش کتابخانه‌های بزرگ ممکن است چند دقیقه طول بکشد. هر زمان می‌توانید لغو کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Suurten kirjastojen käsittely voi kestää muutaman minuutin. Voit perua milloin tahansa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le traitement des grandes bibliothèques peut prendre quelques minutes. Vous pouvez annuler à tout moment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "עיבוד ספריות גדולות עשוי להימשך כמה דקות. ניתן לבטל בכל עת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बड़ी लाइब्रेरी के लिए कुछ मिनट लग सकते हैं। आप कभी भी रद्द कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Obrada velikih medijateka može potrajati nekoliko minuta. Možete odustati u bilo kojem trenutku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A nagy médiatárak feldolgozása eltarthat néhány percig. Bármikor megszakíthatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pustaka besar mungkin memerlukan beberapa menit. Anda dapat membatalkannya kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le librerie grandi possono richiedere qualche minuto. Puoi annullare in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "大きなライブラリでは数分かかる場合があります。いつでもキャンセルできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "라이브러리가 크면 몇 분 정도 걸릴 수 있습니다. 언제든지 취소할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pustaka besar mungkin mengambil masa beberapa minit. Anda boleh membatalkan pada bila-bila masa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Det kan ta noen minutter å behandle store biblioteker. Du kan avbryte når som helst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Het verwerken van grote bibliotheken kan enkele minuten duren. Je kunt op elk moment annuleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przetwarzanie dużych bibliotek może potrwać kilka minut. Możesz anulować w dowolnej chwili."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O processamento de bibliotecas grandes pode levar alguns minutos. Você pode cancelar a qualquer momento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Procesarea bibliotecilor mari poate dura câteva minute. Poți anula oricând."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Обработка больших медиатек может занять несколько минут. Её можно отменить в любой момент."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spracovanie veľkých knižníc môže trvať niekoľko minút. Kedykoľvek ho môžete zrušiť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Obdelava velikih knjižnic lahko traja nekaj minut. Kadar koli jo lahko prekličete."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Obrada velikih biblioteka može potrajati nekoliko minuta. Možete je otkazati u bilo kom trenutku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Det kan ta några minuter att bearbeta stora bibliotek. Du kan avbryta när som helst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "คลังขนาดใหญ่อาจใช้เวลาหลายนาที คุณยกเลิกได้ทุกเมื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Büyük arşivlerin işlenmesi birkaç dakika sürebilir. İstediğiniz zaman iptal edebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Обробка великих медіатек може тривати кілька хвилин. Ви можете скасувати її будь-коли."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Việc xử lý thư viện lớn có thể mất vài phút. Bạn có thể hủy bất cứ lúc nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "媒体库较大时可能需要几分钟。你可以随时取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "媒體庫較大時可能需要幾分鐘。你可以隨時取消。"
          }
        }
      }
    },
    "Larger buffers use more storage. Unavailable with Apple’s native player." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تستهلك المخازن المؤقتة الأكبر مساحة تخزين أكبر. غير متاح مع مشغّل Apple المدمج."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "По-големите буфери използват повече място за съхранение. Недостъпно с вградения плейър на Apple."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les memòries intermèdies més grans ocupen més espai d’emmagatzematge. No disponible amb el reproductor natiu d’Apple."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Větší vyrovnávací paměti zabírají více místa v úložišti. Není k dispozici s vestavěným přehrávačem Apple."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Større buffere bruger mere lagerplads. Ikke tilgængelig med Apples indbyggede afspiller."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Größere Puffer benötigen mehr Speicherplatz. Nicht mit Apples integriertem Player verfügbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η μεγαλύτερη προσωρινή μνήμη απαιτεί περισσότερο αποθηκευτικό χώρο. Δεν διατίθεται με τον ενσωματωμένο αναπαραγωγέα της Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los búferes más grandes usan más almacenamiento. No disponible con el reproductor nativo de Apple."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بافرهای بزرگ‌تر فضای ذخیره‌سازی بیشتری مصرف می‌کنند. با پخش‌کنندهٔ داخلی Apple در دسترس نیست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Suuremmat puskurit käyttävät enemmän tallennustilaa. Ei käytettävissä Applen omalla soittimella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une mémoire tampon plus grande utilise plus d’espace de stockage. Indisponible avec le lecteur natif d’Apple."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מאגרי ביניים גדולים יותר צורכים יותר שטח אחסון. לא זמין עם הנגן המובנה של Apple."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बड़े बफ़र ज़्यादा स्टोरेज इस्तेमाल करते हैं। Apple के बिल्ट-इन प्लेयर के साथ उपलब्ध नहीं है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Veći međuspremnici zauzimaju više prostora za pohranu. Nije dostupno uz Appleov ugrađeni reproduktor."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A nagyobb pufferek több tárhelyet használnak. Az Apple beépített lejátszójával nem érhető el."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Buffer yang lebih besar menggunakan lebih banyak ruang penyimpanan. Tidak tersedia dengan pemutar bawaan Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I buffer più grandi occupano più spazio di archiviazione. Non disponibile con il lettore integrato di Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "バッファが大きいほど、ストレージを多く使用します。Apple標準のプレーヤーでは利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "버퍼가 클수록 저장 공간을 더 많이 사용합니다. Apple 기본 플레이어에서는 사용할 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Penimbal yang lebih besar menggunakan lebih banyak ruang storan. Tidak tersedia dengan pemain terbina dalam Apple."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Større buffere bruker mer lagringsplass. Ikke tilgjengelig med Apples innebygde avspiller."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Grotere buffers gebruiken meer opslagruimte. Niet beschikbaar met de ingebouwde speler van Apple."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Większe bufory zajmują więcej miejsca na dysku. Funkcja niedostępna w natywnym odtwarzaczu Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Buffers maiores usam mais espaço de armazenamento. Indisponível no reprodutor nativo da Apple."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Memoriile tampon mai mari ocupă mai mult spațiu de stocare. Opțiunea nu este disponibilă cu playerul nativ Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Больший буфер занимает больше места в хранилище. Недоступно во встроенном плеере Apple."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Väčšia vyrovnávacia pamäť zaberá viac miesta v úložisku. Nie je dostupná so vstavaným prehrávačom Apple."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Večji medpomnilniki porabijo več prostora za shranjevanje. Ni na voljo z vgrajenim predvajalnikom družbe Apple."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Veći baferi zauzimaju više prostora za skladištenje. Nije dostupno uz ugrađeni plejer kompanije Apple."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
