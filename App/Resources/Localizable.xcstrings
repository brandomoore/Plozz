    "Movie and show backgrounds, logos, and related-title posters." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "خلفيات الأفلام والمسلسلات وشعاراتها، وملصقات الأعمال ذات الصلة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Фонове и лога на филми и сериали, както и плакати на свързани заглавия."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fons i logotips de pel·lícules i sèries, i pòsters dels títols relacionats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pozadí a loga filmů a seriálů a plakáty souvisejících titulů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baggrunde og logoer for film og serier samt plakater for relaterede titler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hintergründe und Logos für Filme und Serien sowie Poster verwandter Titel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τα φόντα και τα λογότυπα ταινιών και σειρών, καθώς και οι αφίσες σχετικών τίτλων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fondos y logotipos de películas y series, y pósteres de títulos relacionados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پس‌زمینه‌ها و لوگوهای فیلم‌ها و سریال‌ها، و پوسترهای عناوین مرتبط."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elokuvien ja sarjojen taustat ja logot sekä aiheeseen liittyvien nimikkeiden julisteet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arrière-plans et logos des films et séries, ainsi que les affiches des titres associés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "רקעים וסמלי לוגו של סרטים וסדרות, ופוסטרים של כותרים קשורים."
