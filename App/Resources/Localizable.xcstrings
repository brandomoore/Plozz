        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Korisnike ovog poslužitelja nije bilo moguće učitati. Njegov popis ostat će izvan ovog profila dok nekoga ne odaberete — isključite i ponovno uključite poslužitelj da pokušate."
