    "Silo approved this device, but we couldn't load your profiles. Try again without repeating approval." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سمح Silo لهذا الجهاز بالوصول، ولكن تعذّر تحميل ملفاتك الشخصية. حاول مرة أخرى دون تكرار الموافقة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo одобри това устройство, но не успяхме да заредим профилите ви. Опитайте отново, без да повтаряте одобрението."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo ha autoritzat aquest dispositiu, però no hem pogut carregar els vostres perfils. Torneu-ho a provar sense repetir l'autorització."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo schválilo toto zařízení, ale nepodařilo se nám načíst vaše profily. Zkuste to znovu bez opakování schválení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo godkendte denne enhed, men vi kunne ikke indlæse dine profiler. Prøv igen uden at gentage godkendelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo hat dieses Gerät freigegeben, aber wir konnten deine Profile nicht laden. Versuche es erneut, ohne die Freigabe zu wiederholen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το Silo ενέκρινε αυτή τη συσκευή, αλλά δεν ήταν δυνατή η φόρτωση των προφίλ σας. Δοκιμάστε ξανά χωρίς να επαναλάβετε την έγκριση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo ha autorizado este dispositivo, pero no hemos podido cargar tus perfiles. Vuelve a intentarlo sin repetir la autorización."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo این دستگاه را تأیید کرد، اما نتوانستیم نمایه‌های شما را بارگیری کنیم. بدون تکرار تأیید، دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo hyväksyi tämän laitteen, mutta profiilejasi ei voitu ladata. Yritä uudelleen. Hyväksyntää ei tarvitse toistaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo a autorisé cet appareil, mais nous n’avons pas pu charger vos profils. Réessayez sans répéter l’étape d’autorisation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo אישר את המכשיר הזה, אך לא הצלחנו לטעון את הפרופילים שלכם. נסו שוב בלי לחזור על תהליך האישור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo ने इस डिवाइस को मंज़ूरी दे दी है, लेकिन हम आपकी प्रोफ़ाइलें लोड नहीं कर सके। दोबारा मंज़ूरी दिए बिना फिर से कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo je odobrio ovaj uređaj, ali nismo mogli učitati vaše profile. Pokušajte ponovno bez ponovnog odobravanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Silo jóváhagyta ezt az eszközt, de nem sikerült betölteni a profiljait. Próbálja újra, a jóváhagyást nem kell megismételnie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo telah menyetujui perangkat ini, tetapi profil Anda tidak dapat dimuat. Coba lagi tanpa mengulangi persetujuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo ha autorizzato questo dispositivo, ma non è stato possibile caricare i tuoi profili. Riprova senza ripetere l’autorizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
