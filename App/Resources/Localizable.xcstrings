      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سيشغّل Plozz المحتوى هنا بصفته هذا الشخص، ويعرض قائمة مشاهدته، ويحفظ التغييرات فيها."
