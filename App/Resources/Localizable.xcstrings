    "Tries HEVC first when supported, with H.264 fallback at the same quality limit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يجرّب HEVC أولًا إذا كان مدعومًا، مع الرجوع إلى H.264 ضمن حد الجودة نفسه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Първо опитва HEVC, ако се поддържа, с резервен вариант H.264 при същото ограничение за качество."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prova primer HEVC quan és compatible, amb H.264 com a alternativa amb el mateix límit de qualitat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nejprve zkouší HEVC, pokud je podporován, a v případě potřeby přejde na H.264 při stejném limitu kvality."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prøver først HEVC, når det understøttes, og skifter om nødvendigt til H.264 ved samme kvalitetsgrænse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Versucht zuerst HEVC, wenn es unterstützt wird, und weicht bei Bedarf bei gleichem Qualitätslimit auf H.264 aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Δοκιμάζει πρώτα HEVC όταν υποστηρίζεται και, αν χρειαστεί, H.264 με το ίδιο όριο ποιότητας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prueba primero HEVC si es compatible y recurre a H.264 si es necesario, con el mismo límite de calidad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اگر پشتیبانی شود، ابتدا HEVC را امتحان می‌کند و در صورت نیاز با همان سقف کیفیت به H.264 برمی‌گردد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kokeilee ensin HEVC:tä, jos sitä tuetaan, ja käyttää tarvittaessa H.264:ää samalla laaturajalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Essaie d’abord HEVC s’il est pris en charge, puis H.264 si nécessaire, avec la même limite de qualité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מנסה תחילה HEVC אם הוא נתמך, ועובר ל־H.264 במידת הצורך תוך שמירה על אותה מגבלת איכות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "समर्थित होने पर पहले HEVC आज़माता है; ज़रूरत पड़ने पर उसी क्वालिटी सीमा पर H.264 का उपयोग करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Najprije pokušava s HEVC-om kada je podržan, uz zamjenu kodekom H.264 unutar istog ograničenja kvalitete."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
