    "Repeats the imported channels into labeled copies; it does not add stations. Favorites and recently watched channels are saved separately for each profile." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يكرّر القنوات المستوردة في نسخ ذات تسميات؛ ولا يضيف محطات. تُحفظ المفضلة والقنوات المشاهدة مؤخرًا بشكل منفصل لكل ملف شخصي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Повтаря импортираните канали като копия с етикети; не добавя станции. Любимите и наскоро гледаните канали се запазват отделно за всеки профил."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Repeteix els canals importats en còpies etiquetades; no afegeix emissores. Els preferits i els canals mirats recentment es desen per separat per a cada perfil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vytváří označené kopie importovaných kanálů; nepřidává nové stanice. Oblíbené a nedávno sledované kanály se ukládají samostatně pro každý profil."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gentager de importerede kanaler som navngivne kopier. Det tilføjer ikke nye kanaler. Favoritter og senest sete kanaler gemmes separat for hver profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erstellt beschriftete Kopien der importierten Kanäle; es werden keine Sender hinzugefügt. Favoriten und kürzlich angesehene Kanäle werden für jedes Profil getrennt gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Δημιουργεί επαναλαμβανόμενα αντίγραφα των εισαγόμενων καναλιών με ετικέτες· δεν προσθέτει σταθμούς. Τα αγαπημένα και τα πρόσφατα παρακολουθημένα κανάλια αποθηκεύονται ξεχωριστά για κάθε προφίλ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Crea copias etiquetadas de los canales importados; no añade emisoras. Los Favoritos y los canales vistos recientemente se guardan por separado para cada perfil."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "از کانال‌های واردشده نسخه‌های تکراری برچسب‌دار می‌سازد؛ ایستگاه جدیدی اضافه نمی‌کند. موارد دلخواه و کانال‌های اخیراً تماشاشده برای هر نمایه جداگانه ذخیره می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Monistaa tuodut kanavat nimetyiksi kopioiksi lisäämättä uusia kanavia. Suosikit ja äskettäin katsotut kanavat tallennetaan erikseen kullekin profiilille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Duplique les chaînes importées sous des libellés distincts ; aucune station n’est ajoutée. Les favoris et les chaînes regardées récemment sont enregistrés séparément pour chaque profil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "יוצר עותקים מתויגים של הערוצים המיובאים; הוא אינו מוסיף תחנות. ערוצים מועדפים וערוצים שנצפו לאחרונה נשמרים בנפרד לכל פרופיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आयातित चैनलों की अलग-अलग लेबल वाली प्रतियाँ बनाता है; नए स्टेशन नहीं जोड़ता। पसंदीदा और हाल में देखे गए चैनल हर प्रोफ़ाइल के लिए अलग-अलग सहेजे जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ponavlja uvezene kanale kao označene kopije; ne dodaje postaje. Omiljeni i nedavno gledani kanali spremaju se zasebno za svaki profil."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az importált csatornákat címkézett másolatokként ismétli meg; nem ad hozzá állomásokat. A kedvencek és a legutóbb nézett csatornák profilonként külön vannak mentve."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menggandakan saluran yang diimpor menjadi salinan berlabel; tindakan ini tidak menambahkan stasiun. Favorit dan saluran yang baru ditonton disimpan terpisah untuk setiap profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Crea copie etichettate dei canali importati, senza aggiungere emittenti. I preferiti e i canali guardati di recente vengono salvati separatamente per ogni profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "読み込んだチャンネルをラベル付きで複製して、表示行数を増やします。実際の放送局は追加されません。お気に入りと最近見たチャンネルはプロファイルごとに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "가져온 채널을 레이블이 붙은 복사본으로 반복 표시하며 새 방송국을 추가하지 않습니다. 즐겨찾기와 최근 시청 채널은 프로필별로 따로 저장됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menggandakan saluran yang diimport menjadi salinan berlabel; tindakan ini tidak menambah stesen. Kegemaran dan saluran yang ditonton baru-baru ini disimpan secara berasingan bagi setiap profil."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lager merkede kopier av de importerte kanalene. Det legges ikke til stasjoner. Favoritter og nylig sette kanaler lagres separat for hver profil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maakt gelabelde kopieën van de geïmporteerde zenders; er komen geen echte zenders bij. Favorieten en onlangs bekeken zenders worden voor elk profiel apart opgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Powiela zaimportowane kanały jako oznaczone kopie; nie dodaje nowych stacji. Ulubione i ostatnio oglądane kanały są zapisywane osobno dla każdego profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Repete os canais importados em cópias identificadas; não adiciona estações. Canais favoritos e assistidos recentemente são salvos separadamente para cada perfil."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Repetă canalele importate sub formă de copii etichetate; nu adaugă posturi. Favoritele și canalele vizionate recent sunt salvate separat pentru fiecare profil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Создаёт помеченные копии импортированных каналов, не добавляя новые телеканалы. Избранные и недавно просмотренные каналы сохраняются отдельно для каждого профиля."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vytvorí označené kópie importovaných kanálov; nepridá nové stanice. Obľúbené a nedávno sledované kanály sa ukladajú osobitne pre každý profil."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ponovi uvožene kanale kot označene kopije; ne dodaja postaj. Priljubljeni in nedavno gledani kanali se shranijo ločeno za vsak profil."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ponavlja uvezene kanale kao označene kopije; ne dodaje stanice. Omiljeni i nedavno gledani kanali čuvaju se zasebno za svaki profil."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skapar märkta kopior av de importerade kanalerna utan att lägga till nya tv-stationer. Favoriter och kanaler du nyligen tittat på sparas separat för varje profil."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ทำซ้ำช่องที่นำเข้าเป็นสำเนาพร้อมป้ายกำกับ โดยไม่ได้เพิ่มสถานี รายการโปรดและช่องที่ดูล่าสุดจะบันทึกแยกกันสำหรับแต่ละโปรไฟล์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "İçe aktarılan kanalları etiketli kopyalar hâlinde yineler; yeni istasyon eklemez. Favoriler ve son izlenen kanallar her profil için ayrı kaydedilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Створює копії імпортованих каналів з окремими підписами; нові станції не додаються. Обране й нещодавно переглянуті канали зберігаються окремо для кожного профілю."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lặp lại các kênh đã nhập thành các bản sao có nhãn; thao tác này không thêm đài. Kênh yêu thích và kênh đã xem gần đây được lưu riêng cho từng hồ sơ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "将导入的频道复制为带标签的副本，不会添加新电视台。收藏和最近观看的频道按个人资料分别保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "將匯入的頻道複製成帶有標籤的副本；不會加入實際電視台。每個個人檔案的喜好項目與最近觀看頻道會分開儲存。"
          }
        }
      }
    },
