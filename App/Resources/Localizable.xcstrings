    "Warms and dims the display at night to help you sleep." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُخفّض ويسخن الشاشة في الليل لمساعدتك على النوم."
