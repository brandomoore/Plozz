    "Arrange rows from any library together. Move a row below Hidden to turn it off." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "رتّب صفوف المكتبات المختلفة في قائمة واحدة. انقل الصف إلى أسفل «مخفية» لتعطيله."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Подредете в един списък редове от различни библиотеки. Преместете ред под „Скрити“, за да го изключите."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Organitza en una mateixa llista les files de qualsevol biblioteca. Mou una fila sota «Ocultes» per desactivar-la."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uspořádejte společně řádky z libovolných knihoven. Přesunutím pod „Skryté“ řádek vypnete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arranger rækker fra forskellige biblioteker i én liste. Flyt en række ned under Skjulte for at slå den fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ordne Reihen aus beliebigen Mediatheken in einer Liste an. Verschiebe eine Reihe unter „Ausgeblendet“, um sie zu deaktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τακτοποιήστε σειρές από διαφορετικές βιβλιοθήκες στην ίδια λίστα. Για να απενεργοποιήσετε μια σειρά, μετακινήστε την κάτω από την επικεφαλίδα «Κρυφές»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Organiza en una misma lista las filas de cualquier biblioteca. Mueve una fila debajo de «Ocultas» para desactivarla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سطرهای کتابخانه‌های مختلف را در یک فهرست مرتب کنید. برای غیرفعال کردن یک سطر، آن را به زیر «پنهان» ببرید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Järjestä eri kirjastojen rivit samassa luettelossa. Poista rivi käytöstä siirtämällä se Piilotetut-otsikon alle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Organisez les rangées de différentes bibliothèques dans une même liste. Déplacez une rangée sous « Masquées » pour la désactiver."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "אפשר לסדר שורות מספריות שונות ברשימה אחת. כדי להשבית שורה, יש להעביר אותה מתחת לכותרת ״מוסתרות״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अलग-अलग लाइब्रेरी की रो को एक ही सूची में व्यवस्थित करें। किसी रो को बंद करने के लिए उसे “छिपी हुई” के नीचे ले जाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rasporedite redove iz različitih biblioteka na jednom popisu. Premjestite red ispod odjeljka Skriveni da biste ga isključili."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rendezd közös listába bármelyik könyvtár sorait. Egy sor kikapcsolásához helyezd azt a Rejtett cím alá."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Atur baris dari berbagai pustaka dalam satu daftar. Pindahkan baris ke bawah Tersembunyi untuk menonaktifkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Organizza in un unico elenco le righe delle varie librerie. Sposta una riga sotto Nascoste per disattivarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ライブラリをまたいで行を自由に並べ替えられます。行を「非表示」の下に移動すると表示されなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "여러 라이브러리의 행을 한 목록에 배치하세요. 행을 비활성화하려면 '숨김' 아래로 이동하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Susun baris daripada pelbagai pustaka dalam satu senarai. Alihkan baris ke bawah Tersembunyi untuk menyahaktifkannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ordne rader fra ulike biblioteker i én liste. Flytt en rad under Skjulte for å slå den av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Orden rijen uit verschillende bibliotheken in één lijst. Verplaats een rij onder Verborgen om deze uit te schakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ułóż sekcje z dowolnych bibliotek na jednej liście. Przenieś sekcję pod nagłówek Ukryte, aby ją wyłączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Organize as linhas de diferentes bibliotecas em uma única lista. Mova uma linha para baixo do título Ocultas para desativá-la."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aranjează într-o singură listă rânduri din orice bibliotecă. Mută un rând sub „Ascunse” pentru a-l dezactiva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Расположите строки из любых библиотек в одном списке. Чтобы отключить строку, переместите её под заголовок «Скрытые»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usporiadajte riadky z ľubovoľných knižníc v jednom zozname. Riadok vypnete presunutím pod nadpis „Skryté“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Razporedite vrstice iz poljubnih knjižnic na enem seznamu. Vrstico izklopite tako, da jo premaknete pod naslov »Skrite«."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rasporedite redove iz bilo koje biblioteke na jednoj listi. Premestite red ispod naslova „Skriveni“ da biste ga isključili."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ordna rader från valfria bibliotek i en och samma lista. Flytta en rad under rubriken Dolda för att stänga av den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "จัดเรียงแถวจากคลังต่าง ๆ ไว้ด้วยกัน ย้ายแถวไปไว้ใต้ “ซ่อนอยู่” เพื่อปิดการแสดงแถวนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Farklı kütüphanelerden gelen satırları aynı listede düzenleyin. Bir satırı devre dışı bırakmak için Gizli başlığının altına taşıyın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Упорядковуйте рядки з різних бібліотек в одному списку. Щоб вимкнути рядок, перемістіть його під заголовок «Приховані»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sắp xếp các hàng từ các thư viện khác nhau trong cùng một danh sách. Di chuyển một hàng xuống dưới mục Đã ẩn để ngừng hiển thị hàng đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "可将不同媒体库的内容栏混合排列。将内容栏移到“已隐藏”下方即可关闭显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "可將不同媒體庫的橫列混合排列。將橫列移到「已隱藏」下方即可關閉顯示。"
          }
        }
      }
    },
