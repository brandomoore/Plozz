    "Ask a parent to approve your IPTV sources. One approval covers every channel in a source." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اطلب من أحد الوالدين الموافقة على مصادر IPTV. موافقة واحدة تشمل كل قناة في المصدر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Помолете родител да одобри вашите IPTV източници. Едно одобрение обхваща всички канали в даден източник."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Demana al pare o a la mare que aprovi les teves fonts IPTV. Una sola aprovació autoritza tots els canals d’una font."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Požádejte rodiče o schválení vašich zdrojů IPTV. Jedno schválení platí pro všechny kanály ve zdroji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bed en forælder om at godkende dine IPTV-kilder. Én godkendelse gælder alle kanaler i en kilde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bitte einen Elternteil, deine IPTV-Quellen freizugeben. Eine Freigabe gilt für alle Kanäle einer Quelle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ζητήστε από έναν γονέα να εγκρίνει τις πηγές IPTV σας. Μία έγκριση καλύπτει όλα τα κανάλια μιας πηγής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pide a tu madre, padre o tutor que apruebe tus fuentes IPTV. Una aprobación incluye todos los canales de una fuente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "از یکی از والدین بخواهید منابع IPTV شما را تأیید کند. یک تأیید همه کانال‌های یک منبع را پوشش می‌دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pyydä vanhempaa hyväksymään IPTV-lähteesi. Yksi hyväksyntä kattaa lähteen kaikki kanavat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Demandez à un parent d’autoriser vos sources IPTV. Une seule autorisation couvre toutes les chaînes d’une source."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "בקש מהורה לאשר את מקורות ה-IPTV שלך. אישור אחד חל על כל הערוצים במקור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अपने IPTV स्रोतों को स्वीकृत कराने के लिए किसी अभिभावक से कहें। एक स्वीकृति स्रोत के सभी चैनलों पर लागू होती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zatražite od roditelja da odobri vaše IPTV izvore. Jedno odobrenje obuhvaća sve kanale u izvoru."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kérj meg egy szülőt az IPTV-forrásaid engedélyezésére. Egy engedély a forrás összes csatornájára érvényes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Minta orang tua menyetujui sumber IPTV Anda. Satu persetujuan berlaku untuk setiap saluran dalam satu sumber."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chiedi a un genitore di approvare le sorgenti IPTV. Un’unica approvazione vale per tutti i canali di una sorgente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "保護者にIPTVソースの承認を依頼してください。1回の承認でソース内の全チャンネルが許可されます。"
