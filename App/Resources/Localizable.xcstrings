    "Video player Info, episode and playlist menus, Up Next, and system Now Playing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«معلومات» في مشغّل الفيديو، وقوائم الحلقات وقوائم التشغيل، و«التالي»، و«قيد التشغيل الآن» في النظام."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Информация“ във видеоплейъра, менютата за епизоди и плейлисти, „Следващо“ и системният изглед „Възпроизвежда се“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La secció «Informació» del reproductor de vídeo, els menús d’episodis i de llistes de reproducció, «A continuació» i la vista «Reproduint ara» del sistema."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Informace“ ve videopřehrávači, nabídky epizod a seznamů přehrávání, „Následuje“ a systémové zobrazení „Právě se přehrává“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "»Info« i videoafspilleren, episode- og afspilningslistemenuer, »Op næste« og systemets »Afspiller nu«."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Info“ im Videoplayer, Episoden- und Wiedergabelistenmenüs, „Als Nächstes“ und die systemweite „Aktuelle Wiedergabe“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι «Πληροφορίες» του προγράμματος αναπαραγωγής βίντεο, τα μενού επεισοδίων και λιστών αναπαραγωγής, το «Επόμενο» και η προβολή «Τώρα παίζει» του συστήματος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Información del reproductor de vídeo, los menús de episodios y listas de reproducción, A continuación y la vista Reproduciendo ahora del sistema."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بخش «اطلاعات» پخش‌کنندهٔ ویدیو، منوهای قسمت‌ها و فهرست‌های پخش، «بعدی» و نمای «در حال پخش» سیستم."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Videosoittimen Tiedot-osio, jakso- ja soittolistavalikot, Seuraavaksi sekä järjestelmän Toistossa-näkymä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La section Infos du lecteur vidéo, les menus des épisodes et des listes de lecture, À suivre et la vue Lecture en cours du système."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "״מידע״ בנגן הווידאו, תפריטי הפרקים ורשימות ההשמעה, ״בהמשך״ ותצוגת המערכת ״מתנגן כעת״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "वीडियो प्लेयर की “जानकारी”, एपिसोड और प्लेलिस्ट के मेनू, “आगे” और सिस्टम का “अभी चल रहा है” डिस्प्ले।"
