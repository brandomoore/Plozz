    "navigationArrangement.hiddenPlaceholder" : {
      "comment" : "Empty-state drop target under the Hidden divider.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تظهر العناصر المخفية هنا. انقلها إلى الأعلى مجددًا أو اختر «إظهار» لاستعادتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скритите елементи се показват тук. Преместете ги обратно нагоре или изберете „Показване“, за да ги възстановите."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Els elements ocults apareixen aquí. Torna’ls a moure amunt o tria Mostra per restaurar-los."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skryté položky se zobrazují zde. Obnovíte je přesunutím zpět nahoru nebo volbou Zobrazit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skjulte elementer vises her. Flyt dem op igen, eller vælg Vis igen for at gendanne dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
