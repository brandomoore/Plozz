    "Enter your %@ username and password." : {
      "comment" : "Subtitle on the tvOS password sign-in screen. %@ is the provider name, such as Jellyfin.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أدخل اسم المستخدم وكلمة المرور لـ%@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Въведете вашето потребителско име и парола за %@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Introdueix el teu nom d’usuari i la contrasenya de %@."
          }
        },
