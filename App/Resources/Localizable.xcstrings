    "Tap and hold a row for options, or move it to Hidden to hide it." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اضغط مطولًا على صف لعرض الخيارات، أو انقله إلى «مخفية» لإخفائه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Натиснете и задръжте ред за опции или го преместете в „Скрити“, за да го скриете."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén premuda una fila per veure'n les opcions, o mou-la a «Ocultes» per amagar-la."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podržením řádku zobrazíte možnosti. Přesunutím do části Skryté ho skryjete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tryk og hold på en række for at se muligheder, eller flyt den til Skjulte for at skjule den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halte eine Reihe gedrückt, um Optionen anzuzeigen, oder verschiebe sie zum Ausblenden nach „Ausgeblendet“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Πατήστε παρατεταμένα μια σειρά για να δείτε τις επιλογές ή μετακινήστε την στην ενότητα «Κρυφές» για να την αποκρύψετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén pulsada una fila para ver las opciones o muévela a «Ocultas» para ocultarla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برای دیدن گزینه‌ها، یک سطر را لمس کنید و نگه دارید، یا برای پنهان کردنش آن را به بخش «پنهان» منتقل کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pidä riviä painettuna, niin näet vaihtoehdot. Voit piilottaa rivin siirtämällä sen Piilotetut-osioon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Appuyez longuement sur une rangée pour afficher les options, ou déplacez-la dans « Masquées » pour la masquer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לחיצה ממושכת על שורה מציגה אפשרויות. כדי להסתיר אותה, יש להעביר אותה אל ״מוסתרות״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "विकल्प देखने के लिए किसी रो को दबाकर रखें, या उसे छिपाने के लिए “छिपी हुई” सेक्शन में ले जाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dodirnite i zadržite red za prikaz opcija ili ga premjestite u odjeljak „Skriveni” da biste ga sakrili."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A lehetőségek megjelenítéséhez érintsen meg hosszan egy sort, vagy az elrejtéséhez helyezze át a „Rejtett” szakaszba."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ketuk dan tahan baris untuk melihat opsi, atau pindahkan ke bagian “Tersembunyi” untuk menyembunyikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tocca e tieni premuta una riga per vedere le opzioni, oppure spostala nella sezione «Nascoste» per nasconderla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "行を長押しするとオプションが表示されます。非表示にするには「非表示」に移動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "행을 길게 눌러 옵션을 보거나, 숨김 섹션으로 옮겨 숨기세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sentuh dan tahan baris untuk melihat pilihan, atau alihkannya ke Tersembunyi untuk menyembunyikannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trykk og hold på en rad for å se alternativer, eller flytt den til Skjulte for å skjule den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Houd een rij ingedrukt voor opties of verplaats deze naar Verborgen om deze te verbergen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dotknij sekcji i przytrzymaj ją, aby zobaczyć opcje, lub przenieś ją do części „Ukryte”, aby ją ukryć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toque e segure uma linha para ver as opções ou mova-a para Ocultas para ocultá-la."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ține apăsat un rând pentru opțiuni sau mută-l în secțiunea Ascunse pentru a-l ascunde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Нажмите и удерживайте строку, чтобы открыть параметры, или переместите её в раздел «Скрытые», чтобы скрыть."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ak chcete zobraziť možnosti, podržte riadok. Ak ho chcete skryť, presuňte ho do sekcie Skryté."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Za možnosti pridržite vrstico, če jo želite skriti, pa jo premaknite v razdelek Skrite."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dodirnite i zadržite red za opcije ili ga premestite u odeljak Skriveni da biste ga sakrili."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tryck och håll på en rad för att visa alternativ, eller flytta den till Dolda för att dölja den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "แตะแถวค้างไว้เพื่อดูตัวเลือก หรือย้ายไปยังส่วน “ซ่อนอยู่” เพื่อซ่อนแถวนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seçenekler için bir satıra dokunup basılı tutun veya gizlemek için satırı Gizli bölümüne taşıyın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Торкніться рядка й утримуйте, щоб відкрити параметри, або перемістіть його до розділу «Приховані», щоб приховати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chạm và giữ một hàng để xem các tùy chọn, hoặc chuyển hàng đó vào mục Đã ẩn để ẩn đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "长按内容栏可查看选项，或将其移至“已隐藏”分区以隐藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "長按橫列可查看選項，或將其移至「已隱藏」區段以隱藏。"
          }
        }
      }
    },
