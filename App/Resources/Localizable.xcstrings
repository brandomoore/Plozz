    "Use SDH when available; otherwise use regular subtitles." : {
      "comment" : "SDH playback and search preference. SDH includes speaker identification and sound descriptions.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "استخدم ترجمة SDH عند توفرها، وإلا فاستخدم الترجمة العادية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Използвай SDH субтитри, когато са налични; иначе използвай обикновени субтитри."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilitza SDH si n’hi ha; si no, utilitza subtítols convencionals."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Použít titulky SDH, pokud jsou k dispozici; jinak použít běžné titulky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brug SDH-undertekster, hvis de er tilgængelige; brug ellers almindelige undertekster."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SDH-Untertitel verwenden, wenn verfügbar; andernfalls normale Untertitel verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Χρήση υποτίτλων SDH όταν είναι διαθέσιμοι· διαφορετικά, χρήση κανονικών υποτίτλων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usar subtítulos SDH cuando estén disponibles; de lo contrario, usar subtítulos normales."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "در صورت وجود، از زیرنویس SDH استفاده می‌شود؛ در غیر این صورت، از زیرنویس معمولی استفاده می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Käytä SDH-tekstityksiä, jos niitä on saatavilla. Muussa tapauksessa käytä tavallisia tekstityksiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utiliser les sous-titres SDH s’ils sont disponibles, sinon les sous-titres classiques."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "יש להשתמש בכתוביות SDH אם הן זמינות; אחרת, יש להשתמש בכתוביות רגילות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SDH उपलब्ध होने पर उसका उपयोग करें; अन्यथा सामान्य उपशीर्षकों का उपयोग करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koristi SDH kada su dostupni; inače koristi obične titlove."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
