          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Udržuje vaše profily, nastavení a seznam serverů synchronizované na všech zařízeních přihlášených k vašemu účtu iCloud prostřednictvím vašeho soukromého iCloudu. Vaše přihlášení zůstávají soukromá pro každé zařízení. Ve výchozím stavu vypnuto. Pokud některé zařízení přestane přijímat změny, klepněte na něm na Znovu stáhnout z iCloudu."
          }
        },
        "da" : {
          "stringUnit" : {
