        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τα κανάλια της αφαιρούνται από τον οδηγό. Οι προτιμήσεις καναλιών διατηρούνται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
