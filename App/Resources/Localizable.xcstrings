    "Turn HDR preview off and on to retry." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أوقف معاينة HDR ثم فعّلها مجددًا لإعادة المحاولة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Изключете и включете HDR прегледа, за да опитате отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desactiva i torna a activar la previsualització HDR per tornar-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vypněte a znovu zapněte náhled HDR a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Slå HDR-forhåndsvisning fra og til igen for at prøve igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schalte die HDR-Vorschau aus und wieder ein, um es erneut zu versuchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Απενεργοποιήστε και ενεργοποιήστε ξανά την προεπισκόπηση HDR για νέα προσπάθεια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desactiva y vuelve a activar la vista previa HDR para reintentarlo."
