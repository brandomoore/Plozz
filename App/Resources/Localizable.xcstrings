    "navigationArrangement.footnote" : {
      "comment" : "Instructions and the always-visible Settings safety rule for navigation customization.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اضغط مطولًا على عنصر لإخفائه أو إظهاره أو نقله. تُخفى الصفحات التي لم تستخدمها بعد تلقائيًا ما لم تُظهرها يدويًا. تظل الإعدادات ظاهرة دائمًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Натиснете и задръжте елемент, за да го скриете, покажете или преместите. Страниците, които още не сте използвали, се скриват автоматично, освен ако не ги покажете ръчно. Разделът „Настройки“ винаги остава видим."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén premut un element per amagar-lo, mostrar-lo o moure'l. Les pàgines que encara no has utilitzat s'amaguen automàticament, tret que les mostris manualment. Configuració sempre és visible."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dlouhým stisknutím položku skryjete, zobrazíte nebo přesunete. Dosud nepoužité stránky se automaticky skrývají, pokud je sami nezobrazíte. Nastavení zůstává vždy viditelné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tryk og hold på et element for at skjule, vise eller flytte det. Sider, du endnu ikke har brugt, skjules automatisk, medmindre du viser dem manuelt. Siden Indstillinger er altid synlig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halte ein Element gedrückt, um es auszublenden, einzublenden oder zu verschieben. Noch nicht genutzte Seiten werden automatisch ausgeblendet, sofern du sie nicht manuell einblendest. Die Einstellungen bleiben immer sichtbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Πατήστε παρατεταμένα ένα στοιχείο για να το αποκρύψετε, να το εμφανίσετε ή να το μετακινήσετε. Οι σελίδες που δεν χρησιμοποιούνται αποκρύπτονται αυτόματα, εκτός αν επιλέξετε να τις εμφανίσετε. Οι Ρυθμίσεις παραμένουν πάντα ορατές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Press and hold an item to hide, show, or move it. Unused pages hide automatically unless you show them. Settings always stays visible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén pulsado un elemento para ocultarlo, mostrarlo o moverlo. Las páginas que no se usan se ocultan automáticamente, salvo que elijas mostrarlas. Ajustes siempre permanece visible."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برای پنهان کردن، نمایش یا جابه‌جایی یک مورد، آن را فشار دهید و نگه دارید. صفحه‌های بدون استفاده خودکار پنهان می‌شوند، مگر اینکه نمایش آن‌ها را انتخاب کنید. تنظیمات همیشه نمایان می‌ماند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Piilota, näytä tai siirrä kohde painamalla sitä pitkään. Käyttämättömät sivut piilotetaan automaattisesti, ellet valitse niiden näyttämistä. Asetukset ovat aina näkyvissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Appuyez longuement sur un élément pour le masquer, l’afficher ou le déplacer. Les pages inutilisées sont masquées automatiquement, sauf si vous choisissez de les afficher. Les réglages restent toujours visibles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לחיצה ממושכת על פריט מאפשרת להסתיר, להציג או להזיז אותו. עמודים שאינם בשימוש מוסתרים אוטומטית, אלא אם בחרת להציג אותם. ההגדרות תמיד נשארות גלויות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "किसी आइटम को छिपाने, दिखाने या खिसकाने के लिए उसे दबाकर रखें। इस्तेमाल न होने वाले पेज अपने-आप छिप जाते हैं, जब तक आप उन्हें मैन्युअल रूप से दिखाना न चुनें। सेटिंग्स हमेशा दिखाई देती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pritisnite i držite stavku da biste je sakrili, prikazali ili premjestili. Stranice koje ne koristite automatski se skrivaju, osim ako ih ručno postavite kao vidljive. Postavke su uvijek vidljive."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tartsa hosszan lenyomva az elemet az elrejtéshez, megjelenítéshez vagy áthelyezéshez. A nem használt oldalak automatikusan elrejtődnek, kivéve, ha kézzel láthatóra állítja őket. A Beállítások oldal mindig látható marad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tekan dan tahan item untuk menyembunyikan, menampilkan, atau memindahkannya. Halaman yang tidak digunakan otomatis disembunyikan, kecuali Anda memilih untuk menampilkannya secara manual. Pengaturan selalu terlihat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tieni premuto un elemento per nasconderlo, mostrarlo o spostarlo. Le pagine inutilizzate si nascondono automaticamente, a meno che tu non scelga di mostrarle manualmente. La pagina Impostazioni resta sempre visibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "項目を長押しすると、非表示・表示・移動ができます。手動で表示を選んだページを除き、使っていないページは自動的に非表示になります。「設定」は常に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "항목을 길게 눌러 숨기거나 표시하거나 이동하세요. 사용하지 않는 페이지는 직접 표시하도록 설정하지 않으면 자동으로 숨겨집니다. 설정은 항상 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tekan dan tahan item untuk menyembunyikan, memaparkan atau memindahkannya. Halaman yang tidak digunakan disembunyikan secara automatik melainkan anda memilih untuk memaparkannya secara manual. Tetapan sentiasa dipaparkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trykk og hold på et element for å skjule, vise eller flytte det. Ubrukte sider skjules automatisk med mindre du velger å vise dem manuelt. Innstillinger vises alltid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Houd een onderdeel ingedrukt om het te verbergen, te tonen of te verplaatsen. Ongebruikte pagina’s worden automatisch verborgen, tenzij je ervoor kiest ze handmatig te tonen. De pagina Instellingen blijft altijd zichtbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Naciśnij i przytrzymaj element, aby go ukryć, pokazać lub przenieść. Nieużywane strony są automatycznie ukrywane, chyba że ręcznie włączysz ich wyświetlanie. Ustawienia są zawsze widoczne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantenha um item pressionado para ocultar, mostrar ou mover. Páginas não utilizadas são ocultadas automaticamente, a menos que você escolha mostrá-las manualmente. A página Ajustes permanece sempre visível."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apasă lung pe un element pentru a-l ascunde, afișa sau muta. Paginile nefolosite se ascund automat, cu excepția celor pe care alegi să le afișezi. Setările rămân mereu vizibile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Нажмите и удерживайте элемент, чтобы скрыть, показать или переместить его. Неиспользуемые страницы скрываются автоматически, кроме тех, которые вы явно выбрали для показа. Настройки всегда остаются видимыми."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podržaním položky ju môžete skryť, zobraziť alebo presunúť. Nepoužívané stránky sa skryjú automaticky, okrem tých, ktoré výslovne nastavíte ako viditeľné. Nastavenia zostávajú vždy viditeľné."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pridržite element, da ga skrijete, prikažete ali premaknete. Neuporabljene strani se samodejno skrijejo, razen tistih, za katere izrecno izberete prikaz. Nastavitve so vedno vidne."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pritisnite i zadržite stavku da biste je sakrili, prikazali ili premestili. Nekorišćene stranice automatski se skrivaju, osim onih koje izričito odaberete da prikažete. Podešavanja su uvek vidljiva."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Håll ned ett objekt för att dölja, visa eller flytta det. Oanvända sidor döljs automatiskt, utom de som du uttryckligen väljer att visa. Inställningar visas alltid."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "กดรายการค้างไว้เพื่อซ่อน แสดง หรือย้าย หน้าที่ไม่ได้ใช้จะถูกซ่อนโดยอัตโนมัติ เว้นแต่คุณจะเลือกให้แสดง การตั้งค่าจะแสดงอยู่เสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bir öğeyi gizlemek, göstermek veya taşımak için basılı tutun. Siz göstermeyi seçmedikçe kullanılmayan sayfalar otomatik olarak gizlenir. Ayarlar her zaman görünür kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Натисніть і утримуйте елемент, щоб приховати, показати або перемістити його. Невикористані сторінки автоматично приховуються, крім тих, які ви показали вручну. Налаштування завжди залишаються видимими."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nhấn và giữ một mục để ẩn, hiện hoặc di chuyển. Các trang không dùng sẽ tự động ẩn, trừ khi bạn chọn hiển thị chúng. Mục Cài đặt luôn hiển thị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "长按项目可隐藏、显示或移动。未使用的页面会自动隐藏，除非你手动选择显示它们。“设置”始终显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "長按項目可隱藏、顯示或移動。未使用的頁面會自動隱藏，除非你手動選擇顯示它們。「設定」一律保持顯示。"
          }
        }
      }
    },
    "navigationArrangement.footnote.iOS" : {
      "comment" : "Instructions for arranging iPhone and iPad navigation tabs.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اسحب لتغيير الترتيب. اضغط مطولًا للإخفاء أو الإظهار. تُخفى الصفحات التي لم تستخدمها بعد تلقائيًا ما لم تُظهرها يدويًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Плъзнете, за да пренаредите. Задръжте, за да скриете или покажете. Страниците, които още не сте използвали, се скриват автоматично, освен ако не ги покажете ръчно."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arrossega per canviar l'ordre. Mantén premut per amagar o mostrar. Les pàgines que encara no has utilitzat s'amaguen automàticament, tret que les mostris manualment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pořadí změníte přetažením. Podržením položku skryjete nebo zobrazíte. Dosud nepoužité stránky se automaticky skrývají, pokud je sami nezobrazíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Træk for at ændre rækkefølgen. Tryk og hold for at skjule eller vise. Sider, du endnu ikke har brugt, skjules automatisk, medmindre du viser dem manuelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ziehe die Elemente, um sie neu anzuordnen. Halte sie gedrückt, um sie aus- oder einzublenden. Noch nicht genutzte Seiten werden automatisch ausgeblendet, sofern du sie nicht manuell einblendest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Σύρετε για αλλαγή σειράς. Πατήστε παρατεταμένα για απόκρυψη ή εμφάνιση. Οι σελίδες που δεν χρησιμοποιούνται αποκρύπτονται αυτόματα, εκτός αν επιλέξετε να τις εμφανίσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drag to reorder. Hold to hide or show. Unused pages hide automatically unless you show them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arrastra para reordenar. Mantén pulsado para ocultar o mostrar. Las páginas que no se usan se ocultan automáticamente, salvo que elijas mostrarlas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برای تغییر ترتیب، بکشید. برای پنهان کردن یا نمایش، نگه دارید. صفحه‌های بدون استفاده خودکار پنهان می‌شوند، مگر اینکه نمایش آن‌ها را انتخاب کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Muuta järjestystä vetämällä. Piilota tai näytä painamalla pitkään. Käyttämättömät sivut piilotetaan automaattisesti, ellet valitse niiden näyttämistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faites glisser pour réorganiser. Appuyez longuement pour masquer ou afficher. Les pages inutilisées sont masquées automatiquement, sauf si vous choisissez de les afficher."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "גרירה לשינוי הסדר. לחיצה ממושכת להסתרה או להצגה. עמודים שאינם בשימוש מוסתרים אוטומטית, אלא אם בחרת להציג אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "क्रम बदलने के लिए खींचें। छिपाने या दिखाने के लिए दबाकर रखें। इस्तेमाल न होने वाले पेज अपने-आप छिप जाते हैं, जब तक आप उन्हें मैन्युअल रूप से दिखाना न चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Povucite za promjenu redoslijeda. Dodirnite i držite za skrivanje ili prikaz. Stranice koje ne koristite automatski se skrivaju, osim ako ih ručno postavite kao vidljive."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Húzással módosíthatja a sorrendet. Hosszan megérintve elrejtheti vagy megjelenítheti az elemet. A nem használt oldalak automatikusan elrejtődnek, kivéve, ha kézzel láthatóra állítja őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seret untuk mengubah urutan. Tekan dan tahan untuk menyembunyikan atau menampilkan. Halaman yang tidak digunakan otomatis disembunyikan, kecuali Anda memilih untuk menampilkannya secara manual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trascina per riordinare. Tieni premuto per nascondere o mostrare. Le pagine inutilizzate si nascondono automaticamente, a meno che tu non scelga di mostrarle manualmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ドラッグで並べ替え、長押しで表示・非表示を切り替えます。手動で表示を選んだページを除き、使っていないページは自動的に非表示になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "드래그하여 순서를 변경하세요. 길게 눌러 숨기거나 표시하세요. 사용하지 않는 페이지는 직접 표시하도록 설정하지 않으면 자동으로 숨겨집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seret untuk menyusun semula. Tekan dan tahan untuk menyembunyikan atau memaparkan. Halaman yang tidak digunakan disembunyikan secara automatik melainkan anda memilih untuk memaparkannya secara manual."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dra for å endre rekkefølgen. Trykk og hold for å skjule eller vise. Ubrukte sider skjules automatisk med mindre du velger å vise dem manuelt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sleep om de volgorde te wijzigen. Houd ingedrukt om te verbergen of te tonen. Ongebruikte pagina’s worden automatisch verborgen, tenzij je ervoor kiest ze handmatig te tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przeciągnij, aby zmienić kolejność. Przytrzymaj, aby ukryć lub pokazać. Nieużywane strony są automatycznie ukrywane, chyba że ręcznie włączysz ich wyświetlanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arraste para reordenar. Mantenha pressionado para ocultar ou mostrar. Páginas não utilizadas são ocultadas automaticamente, a menos que você escolha mostrá-las manualmente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trage pentru a schimba ordinea. Apasă lung pentru a ascunde sau afișa. Paginile nefolosite se ascund automat, cu excepția celor pe care alegi să le afișezi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Перетаскивайте для изменения порядка. Нажмите и удерживайте, чтобы скрыть или показать. Неиспользуемые страницы скрываются автоматически, кроме тех, которые вы явно выбрали для показа."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Potiahnutím zmeníte poradie. Podržaním skryjete alebo zobrazíte položku. Nepoužívané stránky sa skryjú automaticky, okrem tých, ktoré výslovne nastavíte ako viditeľné."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Povlecite za spremembo vrstnega reda. Pridržite za skrivanje ali prikaz. Neuporabljene strani se samodejno skrijejo, razen tistih, za katere izrecno izberete prikaz."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prevucite za promenu redosleda. Pritisnite i zadržite za skrivanje ili prikaz. Nekorišćene stranice automatski se skrivaju, osim onih koje izričito odaberete da prikažete."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dra för att ändra ordningen. Håll ned för att dölja eller visa. Oanvända sidor döljs automatiskt, utom de som du uttryckligen väljer att visa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ลากเพื่อจัดลำดับใหม่ กดค้างไว้เพื่อซ่อนหรือแสดง หน้าที่ไม่ได้ใช้จะถูกซ่อนโดยอัตโนมัติ เว้นแต่คุณจะเลือกให้แสดง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yeniden sıralamak için sürükleyin. Gizlemek veya göstermek için basılı tutun. Siz göstermeyi seçmedikçe kullanılmayan sayfalar otomatik olarak gizlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Перетягніть, щоб змінити порядок. Натисніть і утримуйте, щоб приховати або показати. Невикористані сторінки автоматично приховуються, крім тих, які ви показали вручну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kéo để đổi thứ tự. Nhấn giữ để ẩn hoặc hiện. Các trang không dùng sẽ tự động ẩn, trừ khi bạn chọn hiển thị chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "拖移以调整顺序，长按可隐藏或显示。未使用的页面会自动隐藏，除非你手动选择显示它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "拖移以調整順序，長按可隱藏或顯示。未使用的頁面會自動隱藏，除非你手動選擇顯示它們。"
          }
        }
      }
    },
