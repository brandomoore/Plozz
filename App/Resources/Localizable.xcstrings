        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prazna polja koriste metapodatke izvora. Te su promjene osobne oznake, a ne podaci o programu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az üres mezők a forrás metaadatait használják. Ezek személyes címkék, nem műsoradatok."
