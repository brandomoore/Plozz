    "You're offline. Reconnect to watch Live TV. Saved guide listings are still available." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أنت غير متصل بالإنترنت. أعد الاتصال لمشاهدة البث التلفزيوني المباشر. لا تزال قوائم الدليل المحفوظة متاحة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Нямате връзка с мрежата. Свържете се отново, за да гледате телевизия на живо. Запазените данни за програмата все още са налични."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estàs sense connexió. Torna a connectar-te per mirar la TV en directe. La programació desada de la guia continua disponible."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jste offline. Chcete-li sledovat živé vysílání, znovu se připojte. Uložené programové údaje jsou stále dostupné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
