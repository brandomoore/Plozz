    "cardFocusStyle.detail.highlight" : {
      "comment" : "One-line explanation shown under the card focus-style picker.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يكبر ويلتقط الضوء."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Уголемява се и улавя светлината."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "S'amplia i capta la llum."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zvětší se a zachytí světlo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vokser og fanger lyset."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wird größer und fängt das Licht ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Μεγαλώνει και αντανακλά το φως."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Grows and catches the light."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se agranda y capta la luz."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بزرگ می‌شود و نور را می‌گیرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kasvaa ja kimaltaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "S'agrandit et capte la lumière."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "גדל ותופס אור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बड़ा होता है और चमकता है।"
