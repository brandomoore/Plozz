          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine PIN schützt gemeinsame Einstellungen und das Verlassen von Kinderprofilen. Ohne sie bleiben diese Aktionen verfügbar."
