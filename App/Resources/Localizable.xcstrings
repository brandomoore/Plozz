    "This profile isn’t linked to a Seerr user, so the request is made as the unrestricted admin. Link a user in Settings to track requests per person." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لم يتم ربط هذا الملف الشخصي بمستخدم Seerr، وبالتالي يتم إجراء الطلب باستخدام الحساب الإداري غير المقيد. اربط مستخدماً في الإعدادات لتتبع الطلبات حسب كل شخص."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Този профил не е свързан с потребител на Seerr, затова заявката се прави от неограничения администратор. Свържете потребител в Настройки, за да проследявате заявките по отделни хора."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aquest perfil no està vinculat a cap usuari de Seerr, així que la sol·licitud es fa com a administrador sense restriccions. Vincula un usuari a Configuració per fer un seguiment de les sol·licituds per persona."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tento profil není propojený s uživatelem služby Seerr, takže se žádost odešle prostřednictvím účtu správce bez omezení. Chcete-li sledovat žádosti jednotlivých osob, propojte uživatele v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Denne profil er ikke knyttet til en Seerr-bruger, så anmodningen sendes som administrator uden begrænsninger. Tilknyt en bruger i Indstillinger for at spore anmodninger pr. person."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
