        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "उन टाइटलों को प्राथमिकता दें जो हाल में होम के हीरो बैनर में नहीं दिखाए गए हैं। वॉचलिस्ट का क्रम बनाए रखने के लिए इसे बंद करें।"
