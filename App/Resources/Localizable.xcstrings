          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "به Wi-Fi یا Ethernet متصل شوید، یا «توقف بدون Wi-Fi یا Ethernet» را در تنظیمات ← تلویزیون زنده خاموش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
