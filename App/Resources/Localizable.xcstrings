          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impossibile caricare i collegamenti alle tue librerie. La disposizione salvata non è cambiata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ライブラリのショートカットを読み込めませんでした。保存済みの配置は変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "미디어 보관함 바로가기를 불러오지 못했습니다. 저장된 배치는 변경되지 않았습니다."
