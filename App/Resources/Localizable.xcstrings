    "Choices apply to this profile across all libraries. Continue Watching prefers textless artwork unless you choose Library first." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تنطبق هذه الخيارات على هذا الملف الشخصي في جميع المكتبات. تفضّل متابعة المشاهدة الصور الخالية من النصوص ما لم تختر «المكتبة أولاً»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Изборът важи за този профил във всички медиатеки. „Продължете да гледате“ предпочита изображения без текст, освен ако не изберете „Първо медиатеката“."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les opcions s'apliquen a aquest perfil en totes les biblioteques. La secció «Continua mirant» prefereix imatges sense text, tret que triïs «Primer la biblioteca»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volby platí pro tento profil ve všech knihovnách. Sekce Pokračovat ve sledování upřednostňuje obrázky bez textu, pokud nezvolíte „Nejprve knihovna“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valgene gælder for denne profil på tværs af alle biblioteker. Se videre foretrækker billeder uden tekst, medmindre du vælger »Bibliotek først«."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Auswahl gilt für dieses Profil in allen Medienbibliotheken. Weiterschauen bevorzugt Bilder ohne Text, sofern du nicht „Bibliothek zuerst“ auswählst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι επιλογές ισχύουν για αυτό το προφίλ σε όλες τις βιβλιοθήκες. Η ενότητα «Συνέχεια παρακολούθησης» προτιμά εικόνες χωρίς κείμενο, εκτός αν επιλέξετε «Πρώτα η βιβλιοθήκη»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las opciones se aplican a este perfil en todas las bibliotecas. La sección «Seguir viendo» prefiere imágenes sin texto, salvo que elijas «Primero la biblioteca»."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "این انتخاب‌ها برای این نمایه در همهٔ کتابخانه‌ها اعمال می‌شوند. بخش ادامهٔ تماشا تصاویر بدون نوشته را ترجیح می‌دهد، مگر اینکه «اول کتابخانه» را انتخاب کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valinnat koskevat tätä profiilia kaikissa kirjastoissa. Jatka katsomista suosii tekstittömiä kuvia, ellet valitse vaihtoehtoa ”Kirjasto ensin”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les choix s’appliquent à ce profil dans toutes les bibliothèques. Reprendre la lecture privilégie les images sans texte, sauf si vous choisissez « Bibliothèque d’abord »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הבחירות חלות על פרופיל זה בכל הספריות. המשך צפייה מעדיף תמונות ללא טקסט, אלא אם בוחרים ב״הספרייה תחילה״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ये विकल्प सभी लाइब्रेरी में इस प्रोफ़ाइल पर लागू होते हैं। “देखना जारी रखें” अनुभाग में बिना टेक्स्ट वाले चित्रों को प्राथमिकता दी जाती है, जब तक आप “पहले लाइब्रेरी” नहीं चुनते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odabiri vrijede za ovaj profil u svim knjižnicama. Odjeljak „Nastavi gledati” daje prednost slikama bez teksta, osim ako odaberete „Prvo knjižnica”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A választott beállítások erre a profilra érvényesek minden könyvtárban. A Megtekintés folytatása a szöveg nélküli képeket részesíti előnyben, kivéve, ha az „Először a könyvtár” lehetőséget választod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pilihan berlaku untuk profil ini di semua pustaka. Lanjutkan Menonton mengutamakan gambar tanpa teks kecuali Anda memilih “Pustaka lebih dahulu”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le scelte si applicano a questo profilo in tutte le librerie. Continua a guardare preferisce immagini senza testo, a meno che tu non scelga «Prima la libreria»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "設定は、このプロフィールのすべてのライブラリに適用されます。「ライブラリを優先」を選択しない限り、「続きを観る」では文字のないアートワークを優先します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "선택한 설정은 이 프로필의 모든 미디어 보관함에 적용됩니다. '보관함 우선'을 선택하지 않으면 '시청 중인 콘텐츠'에서는 글자가 없는 아트워크를 우선합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pilihan terpakai pada profil ini merentas semua pustaka. Teruskan Menonton mengutamakan imej tanpa teks melainkan anda memilih “Pustaka dahulu”."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valgene gjelder for denne profilen i alle biblioteker. Se videre foretrekker bilder uten tekst med mindre du velger «Bibliotek først»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De keuzes gelden voor dit profiel in alle bibliotheken. Verder kijken geeft de voorkeur aan afbeeldingen zonder tekst, tenzij je ‘Bibliotheek eerst’ kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wybory dotyczą tego profilu we wszystkich bibliotekach. Sekcja „Oglądaj dalej” preferuje grafikę bez tekstu, chyba że wybierzesz „Najpierw biblioteka”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As escolhas se aplicam a este perfil em todas as bibliotecas. Continuar assistindo prefere imagens sem texto, a menos que você escolha “Biblioteca primeiro”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opțiunile se aplică acestui profil în toate bibliotecile. Secțiunea „Continuă vizionarea” preferă imagini fără text, dacă nu alegi „Mai întâi biblioteca”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выбор действует для этого профиля во всех медиатеках. Раздел «Продолжить просмотр» предпочитает изображения без текста, если не выбран вариант «Сначала медиатека»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voľby platia pre tento profil vo všetkých knižniciach. Sekcia Pokračovať v sledovaní uprednostňuje obrázky bez textu, pokiaľ nezvolíte „Najprv knižnica“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Izbire veljajo za ta profil v vseh knjižnicah. Razdelek »Nadaljuj z gledanjem« daje prednost slikam brez besedila, razen če izberete »Najprej knjižnica«."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Izbori važe za ovaj profil u svim bibliotekama. Odeljak „Nastavi gledanje” daje prednost slikama bez teksta, osim ako izaberete „Prvo biblioteka”."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valen gäller för den här profilen i alla bibliotek. Fortsätt titta föredrar bilder utan text om du inte väljer ”Bibliotek först”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ตัวเลือกเหล่านี้ใช้กับโปรไฟล์นี้ในทุกไลบรารี ส่วน “ดูต่อ” จะเลือกภาพประกอบที่ไม่มีข้อความก่อน เว้นแต่คุณจะเลือก “ไลบรารีก่อน”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seçimler, tüm kitaplıklarda bu profil için geçerlidir. “Önce kitaplık” seçeneğini seçmediğiniz sürece “İzlemeye devam et” bölümü yazısız görselleri tercih eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вибір діє для цього профілю в усіх медіатеках. Розділ «Продовжити перегляд» надає перевагу зображенням без тексту, якщо не вибрано «Спочатку медіатека»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Các lựa chọn áp dụng cho hồ sơ này trên mọi thư viện. Xem tiếp ưu tiên hình ảnh không có chữ trừ khi bạn chọn “Thư viện trước”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "这些选择适用于此个人资料的所有媒体库。除非选择“媒体库优先”，否则“继续观看”会优先使用无文字图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "這些選擇適用於此個人檔案的所有媒體庫。除非選擇「媒體庫優先」，否則「繼續觀看」會優先使用無文字圖片。"
          }
        }
      }
    },
