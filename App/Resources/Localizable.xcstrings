        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το Silo παρείχε έναν σύνδεσμο έγκρισης για διαφορετική διεύθυνση. Επιστρέψτε και εισαγάγετε τη δημόσια διεύθυνση που έχει οριστεί στο Silo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo ha proporcionado un enlace de autorización para una dirección diferente. Vuelve atrás e introduce la dirección pública configurada en Silo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo پیوند تأییدی برای نشانی دیگری ارائه کرد. برگردید و نشانی عمومی تنظیم‌شده در Silo را وارد کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo antoi hyväksyntälinkin eri osoitteeseen. Palaa takaisin ja anna Siloon määritetty julkinen osoite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo a fourni un lien d’autorisation pour une autre adresse. Revenez en arrière et saisissez l’adresse publique configurée dans Silo."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo סיפק קישור לאישור עבור כתובת אחרת. חזרו והזינו את הכתובת הציבורית שהוגדרה ב־Silo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo ने किसी दूसरे पते के लिए मंज़ूरी का लिंक दिया है। वापस जाएँ और Silo में सेट किया गया सार्वजनिक पता दर्ज करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo je poslao poveznicu za odobravanje za drugu adresu. Vratite se i unesite javnu adresu postavljenu u sustavu Silo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Silo egy másik címhez tartozó jóváhagyási hivatkozást adott meg. Lépjen vissza, és adja meg a Silo beállításaiban megadott nyilvános címet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Silo memberikan tautan persetujuan untuk alamat yang berbeda. Kembali dan masukkan alamat publik yang dikonfigurasi di Silo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
