            "state" : "needs_review",
            "value" : "Są renderowane przez źródło jako obrazy, więc ustawienia czcionki, koloru, rozmiaru i położenia nie mają zastosowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elas são renderizadas como imagens pela origem, então os controles de fonte, cor, tamanho e posição não se aplicam."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sunt redate ca imagini de către sursă, așa că setările pentru font, culoare, dimensiune și poziție nu se aplică."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Источник отрисовывает их как изображения, поэтому настройки шрифта, цвета, размера и положения не применяются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zdroj ich vykresľuje ako obrázky, takže nastavenia písma, farby, veľkosti a polohy sa neuplatnia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vir jih upodobi kot slike, zato nastavitve pisave, barve, velikosti in položaja ne veljajo."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Izvor ih prikazuje kao slike, pa kontrole za font, boju, veličinu i položaj ne važe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Källan skickar dem som bilder, så inställningar för typsnitt, färg, storlek och placering gäller inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "แหล่งที่มาสร้างเป็นภาพไว้แล้ว จึงใช้การควบคุมแบบอักษร สี ขนาด และตำแหน่งไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kaynak tarafından görüntü olarak oluşturuldukları için yazı tipi, renk, boyut ve konum denetimleri uygulanmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Джерело відтворює їх як зображення, тому налаштування шрифту, кольору, розміру й розташування не застосовуються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chúng được nguồn hiển thị dưới dạng hình ảnh, nên các tùy chỉnh phông chữ, màu sắc, kích thước và vị trí đều không áp dụng được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "它们由源端渲染为图像，因此字体、颜色、大小和位置控制不适用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "來源會將這些字幕以圖片形式呈現，因此字體、顏色、大小與位置控制項無法套用。"
          }
        }
      }
    },
