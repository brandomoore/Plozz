    "Plex also discovers its own local, remote, and relay addresses automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يكتشف Plex أيضًا عناوينه المحلية والبعيدة وعناوين الترحيل تلقائيًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plex също открива автоматично своите локални, отдалечени и релейни адреси."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plex també descobreix automàticament les seves adreces locals, remotes i de retransmissió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plex také automaticky vyhledává vlastní místní a vzdálené adresy i adresy zprostředkujících serverů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plex finder også automatisk sine egne lokale adresser, fjernadresser og relæadresser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plex erkennt außerdem automatisch eigene Adressen für lokale Verbindungen, Fernzugriff und Relay-Verbindungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το Plex εντοπίζει επίσης αυτόματα τις δικές του τοπικές και απομακρυσμένες διευθύνσεις, καθώς και διευθύνσεις αναμετάδοσης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plex también detecta automáticamente sus propias direcciones locales, remotas y de retransmisión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plex نشانی‌های محلی، راه دور و رلهٔ خود را نیز به‌طور خودکار پیدا می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plex löytää myös omat lähiverkon osoitteensa, etäosoitteensa ja välityspalvelinosoitteensa automaattisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plex détecte aussi automatiquement ses propres adresses locales, distantes et de relais."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plex גם מאתר אוטומטית את הכתובות המקומיות והמרוחקות שלו ואת כתובות שרתי הממסר שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plex अपने स्थानीय, रिमोट और रिले पते भी अपने-आप खोज लेता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
