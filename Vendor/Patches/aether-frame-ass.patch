diff --git a/Sources/AetherEngine/Renderer/SoftwareASSArtwork.swift b/Sources/AetherEngine/Renderer/SoftwareASSArtwork.swift
new file mode 100644
index 00000000..4a65e8b5
--- /dev/null
+++ b/Sources/AetherEngine/Renderer/SoftwareASSArtwork.swift
@@ -0,0 +1,150 @@
+import CoreMedia
+import Foundation
+
+/// One selected embedded Matroska ASS packet, with source times (not presentation clock times).
+public struct SoftwareASSPacket: Sendable {
+    public let start, duration: Double
+    public let data: Data
+}
+
+public struct SoftwareASSFrame: Sendable {
+    public let generation: UInt64
+    public let track: TrackInfo
+    public let fonts: [FontAttachment]
+    public let sourcePTS: CMTime
+    public let subtitleSeconds: Double
+    public let canvas: CGSize
+    /// Active overlapping packets in authors' order, or nil if harvest cannot certify this frame.
+    public let packets: [SoftwareASSPacket]?
+}
+
+public enum SoftwareASSArtwork: Sendable {
+    case images([SubtitleImage]), clear, notReady
+}
+
+/// Called off-main before sample submission. Return immutable artwork or notReady, never wait on UI.
+public typealias SoftwareASSArtworkProvider = @Sendable (SoftwareASSFrame) -> SoftwareASSArtwork
+
+final class SoftwareArtworkGate: @unchecked Sendable {
+    typealias Resolve = @Sendable (UInt64, CMTime, CGSize) -> SoftwareASSArtwork
+    private let lock = NSLock()
+    private var epoch: UInt64 = 0
+    private var resolve: Resolve?
+    // Samples already enqueued are immutable. Retain their drawing owner
+    // across style/selection changes, but never across a display queue flush.
+    private var owners: [(time: Double, frame: Bool)] = []
+    func owns(_ sourceTime: Double) -> Bool {
+        lock.withLock {
+            owners.last(where: { $0.time <= sourceTime })?.frame == true
+        }
+    }
+    private(set) var totals = (clear: 0, notReady: 0, stale: 0)
+    var counts: (clear: Int, notReady: Int, stale: Int) { lock.withLock { totals } }
+    var generation: UInt64 { lock.withLock { epoch } }
+    func set(_ resolve: Resolve?) { lock.withLock { epoch &+= 1; self.resolve = resolve } }
+    func invalidate() { lock.withLock { epoch &+= 1; owners.removeAll(keepingCapacity: true) } }
+    func artwork(_ stamp: UInt64, pts: CMTime, size: CGSize) -> SoftwareASSArtwork? {
+        let callback = lock.withLock { stamp == epoch ? resolve : nil }
+        return callback?(stamp, pts, size)
+    }
+
+    /// Atomic relative to invalidation; a checked-then-unlocked enqueue would admit an old landing.
+    func submit(_ stamp: UInt64, _ art: SoftwareASSArtwork?, sourceTime: Double? = nil, _ handover: () -> Void) -> Bool {
+        lock.withLock {
+            guard stamp == epoch else { totals.stale += 1; return false }
+            switch art { case .clear?: totals.clear += 1; case .notReady?: totals.notReady += 1; default: break }
+            handover()
+            if let time = sourceTime, time.isFinite, art != nil || !owners.isEmpty {
+                let ownsFrame: Bool
+                switch art { case .images?, .clear?: ownsFrame = true; default: ownsFrame = false }
+                // Decoder output may arrive out of display order.
+                let i = owners.lastIndex(where: { $0.time <= time }).map { $0 + 1 } ?? 0
+                owners.insert((time, ownsFrame), at: i)
+                if owners.count > 240 { owners.removeFirst() }
+                if !ownsFrame, resolve == nil, !owners.contains(where: \.frame) { owners.removeAll() }
+            }
+            return true
+        }
+    }
+}
+
+extension AetherEngine {
+    /// Let the existing reader catch the resumed playhead while video is preparing.
+    /// Never change the clock or claim a blank on a timeout or superseded load.
+    public func prerollResumedFrameASS(at position: Double) async {
+        guard frameASSRouteAdmitted, position > 0, position <= 90,
+              let store = softwareSubtitlePacketStore, let track = activeSubtitleTrackIndex,
+              subtitleForwardPrefetchTask != nil, !pictureInPictureActive else { return }
+        let deadline = ContinuousClock.now + .seconds(4)
+        while !Task.isCancelled, softwareSubtitlePacketStore === store, activeSubtitleTrackIndex == track,
+              subtitleForwardPrefetchTask != nil, !pictureInPictureActive, ContinuousClock.now < deadline,
+              !store.hasStrictPrefix(past: position + 0.5) {
+            do { try await Task.sleep(for: .milliseconds(30)) } catch { return }
+        }
+    }
+    public var hasSoftwareASSArtworkProvider: Bool { softwareHost?.assProvider != nil }
+    public var softwareFrameOwnsPrimarySubtitle: Bool {
+        guard let host = softwareHost, let tb = softwarePresentationTimebase else { return false }
+        return host.artworkGate.owns(CMTimebaseGetTime(tb).seconds)
+    }
+    /// Before repositioning a paused local source, let the existing subtitle reader finish a
+    /// bounded contiguous read. Re-anchoring first leaves previous long-lived overlaps unknowable.
+    func prepareLocalASSLanding(_ source: Double, host: SoftwarePlaybackHost, seek: UInt64) async {
+        let end = source - softwareSubtitleDelaySeconds + 1
+        guard loadedURL?.isFileURL == true, !isCustomSource, !host.isPlaying, host.assProvider != nil,
+              !pictureInPictureActive, let id = activeSubtitleTrackIndex,
+              subtitleTracks.contains(where: { $0.id == id && !$0.isExternal && $0.assHeader != nil }),
+              subtitleForwardPrefetchActiveRole == .readAhead,
+              let reader = subtitleForwardPrefetchReanchor, !reader.hasPending,
+              let store = softwareSubtitlePacketStore, end.isFinite, end >= 0,
+              !store.hasStrictPrefix(past: end), store.hasStrictPrefix(past: max(0, end-90))
+        else { return }
+        let owner = host.artworkGate.generation
+        let deadline = ContinuousClock.now + .milliseconds(1500)
+        reader.extendRead(through: end, generation: seek)
+        defer {
+            reader.endExtendedRead(generation: seek)
+            EngineLog.emit("[SoftwareASSLanding] prefixReady=\(store.hasStrictPrefix(past: end))", category: .swPlayback)
+        }
+        while !Task.isCancelled, ContinuousClock.now < deadline, seek == currentSeekGeneration,
+              softwareHost === host, owner == host.artworkGate.generation,
+              reader === subtitleForwardPrefetchReanchor, !reader.hasPending,
+              !store.hasStrictPrefix(past: end) {
+            do { try await Task.sleep(for: .milliseconds(15)) } catch { break }
+        }
+    }
+
+    /// Session-scoped, fullscreen, primary embedded ASS only. Returns false without a software
+    /// host. Register while paused; select/change/disable tracks using the normal selection API.
+    @discardableResult
+    public func setSoftwareASSArtworkProvider(_ provider: SoftwareASSArtworkProvider?) -> Bool {
+        guard let host = softwareHost else { return false }
+        host.assProvider = provider
+        refreshSoftwareASSArtwork()
+        return true
+    }
+
+    func refreshSoftwareASSArtwork() {
+        guard let host = softwareHost else { return }
+        guard let provider = host.assProvider, let store = softwareSubtitlePacketStore,
+              !pictureInPictureActive, let id = activeSubtitleTrackIndex,
+              let track = subtitleTracks.first(where: { $0.id == id }), !track.isExternal,
+              track.assHeader != nil, let index = Int32(exactly: id)
+        else { host.artworkGate.set(nil); return }
+        let fonts = fontAttachments, delay = softwareSubtitleDelaySeconds
+        let plan = sourceUpscalePlan
+        host.artworkGate.set { stamp, pts, size in
+            let t = pts.seconds - delay
+            let packets = store.activeASSPackets(stream: index, at: t)
+            // The upscaler has already processed the video. Rasterize the ASS
+            // at authored video resolution; map only its regions onto the result.
+            let canvas: CGSize
+            if let plan, plan.supportsFrameASS, size == CGSize(width: plan.targetWidth, height: plan.targetHeight) {
+                canvas = CGSize(width: plan.sourceWidth, height: plan.sourceHeight)
+            } else { canvas = size }
+            let result = provider(.init(generation: stamp, track: track, fonts: fonts,
+                                        sourcePTS: pts, subtitleSeconds: t, canvas: canvas, packets: packets))
+            return packets == nil ? .notReady : result
+        }
+    }
+}
