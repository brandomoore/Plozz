@@ -0,0 +1,60 @@
+import XCTest
+import CoreMedia
+@testable import AetherEngine
+
+final class SoftwareArtworkGateTests: XCTestCase {
+    func testReadThroughDoesNotForgeCoverageAndCannotOutliveANewerSeek() {
+        let reader = SubtitleForwardPrefetcher.SideReaderReanchor(anchorStreamIndex: 3, fallbackDuration: 160, seekTimeout: 1)
+        let store = SubtitlePacketStore()
+        store.noteHarvestAnchor(.prefetch, at: 0)
+        store.noteHarvestProgress(.prefetch, through: 10)
+        reader.extendRead(through: 18, generation: 1)
+        XCTAssertTrue(reader.shouldKeepReading(at: 12))
+        XCTAssertFalse(store.hasStrictPrefix(past: 17))
+        reader.extendRead(through: 20, generation: 2)
+        reader.endExtendedRead(generation: 1)
+        XCTAssertTrue(reader.shouldKeepReading(at: 19))
+        XCTAssertFalse(reader.shouldKeepReading(at: 21))
+        reader.request(8, seekGeneration: 3)
+        XCTAssertFalse(reader.shouldKeepReading(at: 12))
+    }
+    func testSmallUnreadSeamIsNotProofOfAClear() {
+        let s = SubtitlePacketStore()
+        s.noteHarvestAnchor(.prefetch, at: 0)
+        s.noteHarvestProgress(.prefetch, through: 1)
+        s.noteHarvestAnchor(.prefetch, at: 1.1)
+        s.noteHarvestProgress(.prefetch, through: 4)
+        s.noteHarvestPositionLost(.prefetch)
+        XCTAssertNil(s.activeASSPackets(stream: 3, at: 2))
+        XCTAssertNotNil(s.activeASSPackets(stream: 3, at: 0.9))
+    }
+    func testInFlightResultCannotSubmitAfterSeekOrOff() {
+        let gate = SoftwareArtworkGate()
+        gate.set { _,_,_ in .clear }
+        for seek in [true, false] {
+            let stamp = gate.generation
+            let art = gate.artwork(stamp, pts: .zero, size: .zero)
+            XCTAssertNotNil(art)
+            if seek { gate.invalidate() } else { gate.set(nil) }
+            XCTAssertFalse(gate.submit(stamp, art) { XCTFail("submitted stale artwork") })
+        }
+        XCTAssertEqual(gate.counts.stale, 2)
+    }
+
+    func testUnobservedIsNotAClearAndEndIsExclusive() throws {
+        let store = SubtitlePacketStore()
+        store.append(streamIndex: 3, ptsSeconds: 1, durationSeconds: 2, payload: Data([65]))
+        XCTAssertNil(store.activeASSPackets(stream: 3, at: 2))
+        store.noteHarvestAnchor(.prefetch, at: 0)
+        store.noteHarvestProgress(.prefetch, through: 4)
+        XCTAssertEqual(try XCTUnwrap(store.activeASSPackets(stream: 3, at: 2)).map(\.data), [Data([65])])
+        XCTAssertTrue(try XCTUnwrap(store.activeASSPackets(stream: 3, at: 3)).isEmpty)
+        XCTAssertNil(store.activeASSPackets(stream: 3, at: 4))
+        let gate = SoftwareArtworkGate()
+        for art in [SoftwareASSArtwork.clear, .notReady] {
+            XCTAssertTrue(gate.submit(gate.generation, art) {})
+        }
+        XCTAssertEqual(gate.counts.clear, 1)
+        XCTAssertEqual(gate.counts.notReady, 1)
+    }
+}
