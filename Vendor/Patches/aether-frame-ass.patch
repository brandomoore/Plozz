diff --git a/Sources/AetherEngine/Subtitles/MatroskaASSIndex.swift b/Sources/AetherEngine/Subtitles/MatroskaASSIndex.swift
new file mode 100644
index 00000000..a1aabf4e
--- /dev/null
+++ b/Sources/AetherEngine/Subtitles/MatroskaASSIndex.swift
@@ -0,0 +1,204 @@
+import Foundation
+
+/// A Matroska seek table alone isn't a subtitle inventory. Accept only the
+/// mkvmerge all-frames layout, reconciled against the selected track's stats.
+struct MatroskaASSIndex: Sendable {
+    struct Interval: Comparable, Sendable {
+        let start, duration: Int
+        static func < (lhs: Self, rhs: Self) -> Bool {
+            (lhs.start, lhs.duration) < (rhs.start, rhs.duration)
+        }
+    }
+    struct Cue: Sendable {
+        let interval: Interval
+        let location: Int
+    }
+    let sorted: [Interval]
+    private let maxDuration: Int
+    init?(_ cues: [Cue], expected: Int) {
+        guard (1...40_000).contains(expected), cues.count == expected,
+              Set(cues.map(\.location)).count == expected,
+              cues.allSatisfy({ $0.location >= 0 && (0...Int(Int32.max)).contains($0.interval.start)
+                  && (0...Int(Int32.max)).contains($0.interval.duration) }) else { return nil }
+        sorted = cues.map(\.interval).sorted()
+        maxDuration = sorted.map(\.duration).max() ?? 0
+    }
+    func matches(at ms: Int, packets: [SoftwareASSPacket]) -> Bool {
+        var lo = 0, hi = sorted.count
+        while lo < hi {
+            let m = (lo + hi) / 2
+            if sorted[m].start <= ms { lo = m + 1 } else { hi = m }
+        }
+        var active: [Interval] = []
+        var i = lo
+        while i > 0, sorted[i-1].start > ms - maxDuration {
+            i -= 1
+            guard lo - i <= 4096 else { return false }
+            if ms < sorted[i].start + sorted[i].duration { active.append(sorted[i]) }
+        }
+        guard active.count == packets.count else { return false }
+        return active.reversed().elementsEqual(packets.map {
+            Interval(start: Int(($0.start * 1000).rounded()), duration: Int(($0.duration * 1000).rounded()))
+        }.sorted())
+    }
+}
+
+private enum Invalid: Error { case index }
+
+/// Strict finite EBML subset. Header offsets are relative to the byte span;
+/// a partial top-level element may be inspected but never iterated as complete.
+private struct Elements {
+    let bytes: [UInt8]
+    struct Node { let id: Int; let body: Range<Int> }
+    func vint(_ at: Int, id: Bool = false) throws -> (Int, Int) {
+        guard bytes.indices.contains(at), bytes[at] != 0 else { throw Invalid.index }
+        let n = bytes[at].leadingZeroBitCount + 1
+        guard n <= (id ? 4 : 8), n <= bytes.count - at else { throw Invalid.index }
+        var v = Int(bytes[at])
+        if !id { v &= (1 << (8-n))-1 }
+        for i in 1..<n { v = (v << 8) | Int(bytes[at+i]) }
+        guard id || v != (1 << (7*n))-1 else { throw Invalid.index }
+        return (v,n)
+    }
+    func element(_ at: Int) throws -> Node {
+        let (tag,n) = try vint(at,id:true), (size,m) = try vint(at+n)
+        let start = at+n+m
+        return Node(id: tag, body: start..<start+size)
+    }
+    func children(_ node: Node) throws -> [Node] {
+        guard node.body.upperBound <= bytes.count else { throw Invalid.index }
+        var p = node.body.lowerBound, result: [Node] = []
+        while p < node.body.upperBound {
+            let el = try element(p)
+            guard el.body.upperBound <= node.body.upperBound, result.count < 50_000 else { throw Invalid.index }
+            result.append(el); p = el.body.upperBound
+        }
+        return result
+    }
+    func one(_ nodes: [Node], _ id: Int) throws -> Node {
+        let hits = nodes.filter { $0.id == id }; guard hits.count == 1 else { throw Invalid.index }; return hits[0]
+    }
+    func number(_ node: Node) throws -> Int {
+        guard (1...7).contains(node.body.count),node.body.upperBound <= bytes.count else { throw Invalid.index }
+        return bytes[node.body].reduce(0) { ($0 << 8) | Int($1) }
+    }
+    func number(_ nodes: [Node], _ id: Int) throws -> Int { try number(one(nodes,id)) }
+    func text(_ nodes: [Node], _ id: Int) throws -> String {
+        let node = try one(nodes,id)
+        guard let s = String(bytes: bytes[node.body],encoding:.utf8) else { throw Invalid.index }
+        return s
+    }
+}
+
+private final class NoRangeRedirect: NSObject, URLSessionTaskDelegate {
+    func urlSession(_ session: URLSession, task: URLSessionTask, willPerformHTTPRedirection response: HTTPURLResponse,
+                    newRequest request: URLRequest, completionHandler: @escaping (URLRequest?) -> Void) {
+        completionHandler(nil)
+    }
+}
+
+extension MatroskaASSIndex {
+    /// Two bounded metadata ranges, plus at most eight ambiguous BlockGroups.
+    /// Never seek the playback demuxer. If the origin ignores Range, reject
+    /// the headers *before* consuming its body; no sequential-read fallback.
+    static func fetch(url: URL, headers: [String:String], track: TrackInfo, expected: Int,
+                      writer: String) async throws -> Self {
+        guard ["http","https"].contains(url.scheme?.lowercased() ?? ""), let header = track.assHeader,
+              writer.hasPrefix("mkvmerge "), (1...40_000).contains(expected) else { throw Invalid.index }
+        let session = URLSession(configuration: .ephemeral, delegate: NoRangeRedirect(), delegateQueue: nil)
+        defer { session.invalidateAndCancel() }
+        let deadline = ContinuousClock.now + .seconds(12)
+        var tag: String?, length: Int?, spent = 0
+        func read(_ offset: Int, _ count: Int) async throws -> Elements {
+            try Task.checkCancellation()
+            guard ContinuousClock.now < deadline, count > 0, offset >= 0,
+                  offset <= (1<<52)-count, spent + count <= 2_500_000,
+                  length.map({ offset+count <= $0 }) ?? true else { throw Invalid.index }
+            var request = URLRequest(url:url,cachePolicy:.reloadIgnoringLocalCacheData,timeoutInterval:3)
+            request.allHTTPHeaderFields = headers
+            request.setValue("bytes=\(offset)-\(offset+count-1)",forHTTPHeaderField:"Range")
+            request.setValue("identity",forHTTPHeaderField:"Accept-Encoding")
+            if let tag { request.setValue(tag,forHTTPHeaderField:"If-Match") }
+            let (body,response) = try await session.bytes(for:request)
+            guard let http = response as? HTTPURLResponse, http.statusCode == 206,
+                  let etag = http.value(forHTTPHeaderField:"ETag"), etag.hasPrefix("\""), etag.hasSuffix("\""),
+                  tag == nil || tag == etag,
+                  let cr = http.value(forHTTPHeaderField:"Content-Range")?.split(separator:"/"), cr.count == 2,
+                  cr[0] == "bytes \(offset)-\(offset+count-1)", let size = Int(cr[1]), size >= offset+count,
+                  size < 1<<52, length == nil || length == size else { throw Invalid.index }
+            tag = etag; length = size; spent += count
+            var data: [UInt8] = []; data.reserveCapacity(count)
+            for try await b in body {
+                guard data.count < count else { throw Invalid.index }
+                if data.count & 4095 == 0 { try Task.checkCancellation(); guard ContinuousClock.now < deadline else { throw Invalid.index } }
+                data.append(b)
+            }
+            guard data.count == count else { throw Invalid.index }
+            return Elements(bytes:data)
+        }
+        let head = try await read(0,131072)
+        let ebml = try head.element(0); guard ebml.id == 0x1a45dfa3 else { throw Invalid.index }
+        let seg = try head.element(ebml.body.upperBound), base = seg.body.lowerBound
+        guard seg.id == 0x18538067, seg.body.upperBound == length else { throw Invalid.index }
+        let sh = try head.element(base); guard sh.id == 0x114d9b74 else { throw Invalid.index }
+        var locations: [Int:Int] = [:]
+        for el in try head.children(sh) where el.id == 0x4dbb {
+            let args = try head.children(el), id = try head.number(args,0x53ab), pos = try head.number(args,0x53ac)
+            guard locations.updateValue(base+pos,forKey:id) == nil else { throw Invalid.index }
+        }
+        func headNode(_ id: Int) throws -> [Elements.Node] {
+            guard let pos = locations[id] else { throw Invalid.index }
+            let el = try head.element(pos); guard el.id == id else { throw Invalid.index }; return try head.children(el)
+        }
+        let info = try headNode(0x1549a966)
+        guard try head.number(info,0x2ad7b1) == 1_000_000, try head.text(info,0x5741) == writer else { throw Invalid.index }
+        var ids: [Int] = []
+        for entry in try headNode(0x1654ae6b) where entry.id == 0xae {
+            let fields = try head.children(entry)
+            guard try head.number(fields,0x83) == 17, try head.text(fields,0x86) == "S_TEXT/ASS",
+                  (try? head.text(fields,0x536e)) == track.name,
+                  (try? head.text(fields,0x63a2)) == header,
+                  !fields.contains(where:{ [0x6d80,0x23314f,0x537f,0x56aa,0x23e383].contains($0.id) }) else { continue }
+            ids.append(try head.number(fields,0xd7))
+        }
+        guard ids.count == 1, let number = ids.first, let pos = locations[0x1c53bb6b], let length,
+              pos >= base, pos < length-12 else { throw Invalid.index }
+        let prefix = try await read(pos,12), cueElement = try prefix.element(0)
+        guard cueElement.id == 0x1c53bb6b, cueElement.body.count <= 2_000_000 else { throw Invalid.index }
+        let table = try await read(pos+cueElement.body.lowerBound,cueElement.body.count)
+        var cues: [Cue] = [], repairs = 0
+        for point in try table.children(.init(id:cueElement.id,body:0..<table.bytes.count)) where point.id == 0xbb {
+            let fields = try table.children(point), start = try table.number(fields,0xb3)
+            for positions in fields where positions.id == 0xb7 {
+                let values = try table.children(positions)
+                guard try table.number(values,0xf7) == number else { continue }
+                let cluster = base + (try table.number(values,0xf1)), rel = try table.number(values,0xf0)
+                guard cluster >= base, cluster < pos, rel < pos-cluster,
+                      cues.count < expected, start <= Int(Int32.max) else { throw Invalid.index }
+                let duration: Int
+                if values.contains(where:{ $0.id == 0xb2 }) { duration = try table.number(values,0xb2) }
+                else {
+                    // No CueDuration is not zero. Check the actual referenced
+                    // block's track, timestamp, no lacing and explicit BlockDuration.
+                    repairs += 1; guard repairs <= 8 else { throw Invalid.index }
+                    let ch = try await read(cluster,64), cl = try ch.element(0)
+                    guard cl.id == 0x1f43b675, cl.body.upperBound <= pos-cluster, rel < cl.body.count else { throw Invalid.index }
+                    let tc = try ch.element(cl.body.lowerBound)
+                    guard tc.id == 0xe7 else { throw Invalid.index }
+                    let group = try await read(cluster+cl.body.lowerBound+rel,512), g = try group.element(0)
+                    guard g.id == 0xa0, g.body.upperBound <= cl.body.count-rel else { throw Invalid.index }
+                    let parts = try group.children(g), block = try group.one(parts,0xa1)
+                    let (id,n) = try group.vint(block.body.lowerBound), at = block.body.lowerBound+n
+                    guard id == number, at+3 <= block.body.upperBound, group.bytes[at+2]&6 == 0 else { throw Invalid.index }
+                    let delta = Int(Int16(bitPattern:UInt16(group.bytes[at])<<8 | UInt16(group.bytes[at+1])))
+                    guard try ch.number(tc)+delta == start else { throw Invalid.index }
+                    duration = try group.number(parts,0x9b)
+                }
+                cues.append(.init(interval:.init(start:start,duration:duration),location:cluster+rel))
+            }
+        }
+        guard let index = Self(cues,expected:expected) else { throw Invalid.index }
+        EngineLog.emit("[SoftwareASS] verified cue inventory stream=\(track.id) frames=\(expected) bytes=\(spent) blockChecks=\(repairs)", category:.engine)
+        return index
+    }
+}
